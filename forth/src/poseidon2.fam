\ ── The permutation ──

\ p2sbox ( x -- x^7 )
: p2sbox  dup dup fmul dup dup fmul fmul fmul ;

\ p2mat4 ( a -- )   the 4x4 MDS matrix on the four cells at a (the Rust
\        `apply_mat4`'s addition chain).
: p2ma variable ;
: p2x0 variable ;   : p2x1 variable ;   : p2x2 variable ;   : p2x3 variable ;
: p2t01 variable ;  : p2t23 variable ;  : p2t0123 variable ;
: p2t01123 variable ;  : p2t01233 variable ;
: p2mat4 ( a -- )
	p2ma !
	p2ma @ @ p2x0 !   p2ma @ 4 lit + @ p2x1 !
	p2ma @ 8 lit + @ p2x2 !   p2ma @ C lit + @ p2x3 !
	p2x0 @ p2x1 @ fadd p2t01 !
	p2x2 @ p2x3 @ fadd p2t23 !
	p2t01 @ p2t23 @ fadd p2t0123 !
	p2t0123 @ p2x1 @ fadd p2t01123 !
	p2t0123 @ p2x3 @ fadd p2t01233 !
	p2t01123 @ p2t01 @ fadd              p2ma @ !           \ x0 = t01123 + t01
	p2t01123 @ p2x2 @ dup fadd fadd      p2ma @ 4 lit + !   \ x1 = t01123 + 2x2
	p2t01233 @ p2t23 @ fadd              p2ma @ 8 lit + !   \ x2 = t01233 + t23
	p2t01233 @ p2x0 @ dup fadd fadd      p2ma @ C lit + !   \ x3 = t01233 + 2x0
;

\ The width being permuted (16 or 24 cells) and its tables: set by p2perm
\ and p2perm16, read by the round words below.
: p2wid variable ;   : p2dg variable ;   : p2ri variable ;   : p2rp variable ;
: p2rf variable ;    : p2np variable ;

\ p2ext ( st -- )   the external linear layer on the p2wid cells at st.
: p2ext ( st -- )
	p2wid @ 2 lit rshift 0 lit do dup i 4 lit lshift + p2mat4 loop
	4 lit 0 lit do                                    \ each position mod 4
		0 lit
		p2wid @ 2 lit rshift 0 lit do over i 4 lit lshift + j 2 lit lshift + @ fadd loop
		p2wid @ 2 lit rshift 0 lit do
			over i 4 lit lshift + j 2 lit lshift +     ( st sum a )
			dup @ 2 lit pick fadd swap !
		loop
		drop
	loop
	drop
;

\ p2full ( st rc -- st )   a full round: every cell gets its constant and the
\        S-box, then the external layer.  rc: the round's constants.
: p2full ( st rc -- st )
	p2wid @ 0 lit do
		over i 2 lit lshift +                     ( st rc a )
		dup @ 2 lit pick i 2 lit lshift + be@ fadd p2sbox swap !
	loop
	drop dup p2ext
;

\ p2part ( st c -- st )   a partial round: cell 0 gets c and the S-box,
\        then the internal layer, out[i] = d[i]*s[i] + sum(s).
: p2part ( st c -- st )
	over @ fadd p2sbox over !
	0 lit p2wid @ 0 lit do over i 2 lit lshift + @ fadd loop     ( st sum )
	p2wid @ 0 lit do
		over i 2 lit lshift +                     ( st sum a )
		dup @ i 2 lit lshift p2dg @ + be@ fmul 2 lit pick fadd swap !
	loop
	drop
;

\ p2run ( st -- )   the permutation at the width and tables set above.
: p2run ( st -- )
	dup p2ext
	4 lit 0 lit do p2ri @ i p2wid @ 2 lit lshift * + p2full loop
	p2np @ 0 lit do p2rp @ i 2 lit lshift + be@ p2part loop
	4 lit 0 lit do p2rf @ i p2wid @ 2 lit lshift * + p2full loop
	drop
;

\ p2perm ( st -- )   permute the 24 cells at st in place.
: p2perm ( st -- )
	18 lit p2wid !  p2diag p2dg !  p2rci p2ri !  p2rcp p2rp !  p2rcf p2rf !
	15 lit p2np !
	p2run
;

\ p2perm16 ( st -- )   permute the 16 cells at st in place (width 16: 13
\        partial rounds).  Used only by WOTS key generation.
: p2perm16 ( st -- )
	10 lit p2wid !  p2dg16 p2dg !  p2rci16 p2ri !  p2rcp16 p2rp !  p2rcf16 p2rf !
	D lit p2np !
	p2run
;

\ ── Compression ──

\ p2cmp / p2cmp16 ( st -- )   the Rust `compress::<8>`: permute, then add
\        the input's first 8 cells back into the output's -- the result is
\        st's first 8 cells.
: p2svb variable ;
: p2sv ( -- a )   p2svb @ dup 0= if drop 20 lit alloc dup p2svb ! then ;
: p2save ( st -- st )   8 lit 0 lit do dup i 2 lit lshift + @ p2sv i 2 lit lshift + ! loop ;
: p2fwd ( st -- )
	8 lit 0 lit do dup i 2 lit lshift + dup @ p2sv i 2 lit lshift + @ fadd swap ! loop
	drop
;
: p2cmp ( st -- )     p2save dup p2perm p2fwd ;
: p2cmp16 ( st -- )   p2save dup p2perm16 p2fwd ;

\ fred ( x -- x mod p )   reduce any 32-bit value (a decoded element: the
\        Rust `BabyBear::new`).
: fred ( x -- x mod p )   begin dup 2013265921u lit u< 0= while 2013265921u lit - repeat ;

\ ── The sponge ──

\ p2hash ( st elems n domain -- )   the Rust node's `hash_elements(domain,
\        elems[..n])`: rate 16, capacity 8.  The state starts as zeros with
\        domain and n in cells 16 and 17; each block of up to 16 elements is
\        added into the rate, then the state permuted (an empty input is
\        permuted once).  The digest is the state's first 8 cells.  st: a
\        24-cell scratch state.  Elements, n and domain must be below p.
: p2hs variable ;   : p2he variable ;   : p2hn variable ;
: p2hash ( st elems n domain -- )
	swap p2hn !  swap p2he !  swap dup p2hs !   ( domain st )
	18 lit 0 lit do 0 lit over i 2 lit lshift + ! loop
	40 lit + !                                     \ cell 16 = domain
	p2hn @ p2hs @ 44 lit + !                     \ cell 17 = n
	p2hn @ 0= if p2hs @ p2perm then
	0 lit begin dup p2hn @ u< while               ( k: the block's first element )
		p2hn @ over - dup 10 lit u> if drop 10 lit then
		0 lit do
			p2he @ over i + 2 lit lshift + @      ( k x )
			p2hs @ i 2 lit lshift + dup @ rot fadd swap !
		loop
		p2hs @ p2perm
		10 lit +
	repeat
	drop
;

\ p2hashb ( st bytes n -- )   the Rust node's `hash_bytes`: the n bytes packed
\        three to an element (little-endian, the last zero-padded), then the
\        sponge with domain 3 and the *byte* length n in the capacity.  The
\        digest is st's first 8 cells.
: p2hbb variable ;   : p2hbn variable ;   : p2hm variable ;
: p2bb ( i -- b )   dup p2hbn @ u< if p2hbb @ + c@ else drop 0 lit then ;
: p2b3 ( k -- e )
	3 lit * dup 2 lit + p2bb 8 lit lshift over 1 lit + p2bb or 8 lit lshift swap p2bb or
;
: p2hashb ( st bytes n -- )
	p2hbn ! p2hbb ! dup p2hs !
	18 lit zero
	3 lit p2hs @ 40 lit + !                        \ cell 16 = DOMAIN_BYTES
	p2hbn @ p2hs @ 44 lit + !                      \ cell 17 = the byte length
	p2hbn @ 2 lit + 3 lit / p2hm !                 \ elements: ceil(n / 3)
	p2hm @ 0= if p2hs @ p2perm then
	0 lit begin dup p2hm @ u< while
		p2hm @ over - dup 10 lit u> if drop 10 lit then
		0 lit do
			dup i + p2b3
			p2hs @ i 2 lit lshift + dup @ rot fadd swap !
		loop
		p2hs @ p2perm
		10 lit +
	repeat
	drop
;

\ ── Tests (./tools/fam --test src/poseidon2.fam) ──
\ Vectors: Plonky3's known answer for width 24, and values printed by the Rust
\ node's own poseidon2 module.

\ p2t! ( st i v -- st )   set cell i.
: p2t! ( st i v -- st )  -rot 2 lit lshift over + rot swap ! ;

\ p2telems ( -- addr )   40 test elements, (i+1) * 100000007 mod p.
: p2telems ( -- addr )
	A0 lit alloc
	28 lit 0 lit do i 1 lit + 100000007u lit fmul over i 2 lit lshift + ! loop
;

