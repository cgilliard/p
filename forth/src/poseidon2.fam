\ ──────────────────────────────────────────────────────────────────────────────
\ src/poseidon2.fam — the Poseidon2 permutation over BabyBear, width 24, and the
\ `hash_elements` sponge: the hash the protocol is built on (see
\ ../rust/src/poseidon2.rs, which this must match exactly).
\
\ Field: BabyBear, p = 2^31 - 2^27 + 1 = 0x78000001.  Elements are kept
\ canonical, in [0, p), one per cell.  RV32I has no multiply, so `fmul` is a
\ shift-and-add loop that doubles and adds modulo p a bit at a time (both
\ operands below 2^31, so no intermediate exceeds 2^32).
\
\ Permutation (Plonky3's `default_babybear_poseidon2_24`): x^7 S-box; an
\ initial external linear layer, 4 full rounds, 21 partial rounds, 4 full
\ rounds.  The external layer applies the 4x4 MDS matrix [2 3 1 1; 1 2 3 1;
\ 1 1 2 3; 3 1 1 2] to each group of four, then adds to every element the sum
\ of its position-mod-4 class.  The internal layer is out[i] = d[i]*s[i] + sum.
\
\ Constants are written in decimal exactly as in the Rust source.  `,` emits a
\ word most-significant byte first, so tables are read back with `be@`.
\
\ Width 24 is the protocol's hash; width 16 (`p2perm16`) is used only to
\ derive WOTS keys (src/wots.fam).
\ ──────────────────────────────────────────────────────────────────────────────

\ ── Field arithmetic ──

\ fadd ( a b -- a+b mod p )
:M fadd
83220100 ,   \ lw   t0,0(sp)
03234100 ,   \ lw   t1,4(sp)
13014100 ,   \ addi sp,sp,4
B3826200 ,   \ add  t0,t0,t1            ( < 2p < 2^32 )
37030078 ,   \ lui  t1,0x78000
13031300 ,   \ addi t1,t1,1             ( t1 = p )
63E46200 ,   \ bltu t0,t1,+8
B3826240 ,   \ sub  t0,t0,t1
23205100 ,   \ sw   t0,0(sp)
;

\ fsub ( a b -- a-b mod p )
:M fsub
83220100 ,   \ lw   t0,0(sp)            ( b )
03234100 ,   \ lw   t1,4(sp)            ( a )
13014100 ,   \ addi sp,sp,4
B3035340 ,   \ sub  t2,t1,t0
63785300 ,   \ bgeu t1,t0,+16           ( a >= b: no wrap )
B7020078 ,   \ lui  t0,0x78000
93821200 ,   \ addi t0,t0,1             ( t0 = p )
B3835300 ,   \ add  t2,t2,t0
23207100 ,   \ sw   t2,0(sp)
;

\ fmul ( a b -- a*b mod p )   r = 0; for each of b's 31 bits, high first:
\        r = 2r mod p, then r = r + a mod p if the bit is set.
:M fmul
83220100 ,   \ lw   t0,0(sp)            ( b )
03234100 ,   \ lw   t1,4(sp)            ( a )
13014100 ,   \ addi sp,sp,4
B7030078 ,   \ lui  t2,0x78000
93831300 ,   \ addi t2,t2,1             ( t2 = p )
130E0000 ,   \ li   t3,0                ( r )
930EF001 ,   \ li   t4,31               ( bits left )
93921200 ,   \ slli t0,t0,1             ( b's bit 30 to the sign bit )
131E1E00 ,   \ loop: slli t3,t3,1       ( r = 2r < 2^32 )
63647E00 ,   \ bltu t3,t2,+8
330E7E40 ,   \ sub  t3,t3,t2
63D80200 ,   \ bge  t0,zero,+16         ( bit clear: skip the add )
330E6E00 ,   \ add  t3,t3,t1            ( r + a < 2^32 )
63647E00 ,   \ bltu t3,t2,+8
330E7E40 ,   \ sub  t3,t3,t2
93921200 ,   \ slli t0,t0,1             ( next bit )
938EFEFF ,   \ addi t4,t4,-1
E39E0EFC ,   \ bnez t4,loop
2320C101 ,   \ sw   t3,0(sp)
;

\ be@ ( addr -- u )   load a word stored most-significant byte first (by `,`).
:M be@
83220100 ,   \ lw   t0,0(sp)
03C30200 ,   \ lbu  t1,0(t0)
13138301 ,   \ slli t1,t1,24
83C31200 ,   \ lbu  t2,1(t0)
93930301 ,   \ slli t2,t2,16
33637300 ,   \ or   t1,t1,t2
83C32200 ,   \ lbu  t2,2(t0)
93938300 ,   \ slli t2,t2,8
33637300 ,   \ or   t1,t1,t2
83C33200 ,   \ lbu  t2,3(t0)
33637300 ,   \ or   t1,t1,t2
23206100 ,   \ sw   t1,0(sp)
;

\ ── Memory helpers (shared by the modules after this one) ──

\ lazy ( var n -- a )   var's buffer, allocating n bytes on first use
\        (variables start at zero).
: lazy ( var n -- a )
	over @ dup if nip nip else drop alloc dup rot ! then
;

\ cpy ( src dst n -- )   copy n cells (n >= 1).
: cpy ( src dst n -- )
	0 lit do over i 2 lit lshift + @ over i 2 lit lshift + ! loop 2drop
;

\ zero ( a n -- )   zero n cells (n >= 1).
: zero ( a n -- )   0 lit do 0 lit over i 2 lit lshift + ! loop drop ;

\ ceq ( a b n -- flag )   whether the n cells at a and b are equal.
: ceq ( a b n -- flag )
	-1 lit swap 0 lit do
		2 lit pick i 2 lit lshift + @ 2 lit pick i 2 lit lshift + @ = and
	loop
	nip nip
;

\ strlen ( s -- n )   a "..." string's length (they end in a zero byte).
: strlen ( s -- n )   0 lit begin 2dup + c@ while 1 lit + repeat nip ;

