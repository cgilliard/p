Bench {
	perm {
		60 lit alloc
		18 lit 0 lit do 0 lit over i 2 lit lshift + ! loop
		bgo
		64 lit 0 lit do dup p2perm loop
		drop
		64 lit bops
	}
	fmul {
		bgo
		1234567u lit
		3E8 lit 0 lit do 2013265920u lit fmul loop
		drop
		3E8 lit bops
	}
}
