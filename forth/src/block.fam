\ Tree proofs: 2^19 rows, blowup 16, 26 queries, 24 grinding bits on main
\ (log_lde 25); 2^17 rows, blowup 4, 4 queries, none on dev (log_lde 21).
: btlen ( -- n )    bnet @ if 20000 lit else 80000 lit then ;
: btlde ( -- k )    bnet @ if 15 lit else 19 lit then ;
: btparm ( -- )
	bnet @ if 2 lit slb !  4 lit snq !  0 lit sgb !
	else 4 lit slb !  1A lit snq !  18 lit sgb ! then
;
: bwcap ( -- a )   bnet @ if dwcap else mwcap then ;
: bacap ( -- a )   bnet @ if dacap else macap then ;

\ ── Parsing ──

: blok variable ;
: bcheck ( flag -- )   0= if 0 lit blok ! then ;

\ be32 ( a -- w )   a big-endian word.   rbe ( -- w )   read one.
: be32 ( a -- w )
	dup c@ 8 lit lshift over 1 lit + c@ or 8 lit lshift
	over 2 lit + c@ or 8 lit lshift swap 3 lit + c@ or
;
: rbe ( -- w )   4 lit rtake be32 ;

\ The block last parsed: header; inputs, outputs, nonces (count, address);
\ the block proof and the chain proof (length, address).
: bhdr variable ;   : bnin variable ;  : bin variable ;   : bnout variable ;
: bout variable ;   : bnnon variable ; : bnon variable ;  : bpl variable ;
: bpr variable ;    : bcl variable ;   : bcp variable ;

\ bparse ( a n -- ok )   parse a block's bytes, exactly.
: bparse ( a n -- ok )
	rinit  -1 lit blok !
	BC lit rtake bhdr !
	rbe dup bnin ! dup 100000 lit u< bcheck 5 lit lshift rtake bin !
	rbe dup bnout ! dup 100000 lit u< bcheck 5 lit lshift rtake bout !
	rbe dup bnnon ! dup 100000 lit u< bcheck 4 lit lshift rtake bnon !
	rbe dup bpl ! rtake bpr !
	rbe dup bcl ! rtake bcp !
	rpos @ rend @ = rbad @ 0= and bcheck
	blok @
;

\ Header fields.
: bver ( -- v )        bhdr @ be32 ;
: bsroot ( -- a )      bhdr @ 24 lit + ;
: bbhash ( -- a )      bhdr @ 44 lit + ;
: bhcnt ( -- lo hi )  bhdr @ 88 lit + be32  bhdr @ 84 lit + be32 ;
: bheight ( -- lo hi ) bhdr @ 90 lit + be32  bhdr @ 8C lit + be32 ;

\ canon? ( a n -- flag )   whether n words in bytes at a are all below p.
: canon? ( a n -- flag )
	-1 lit swap 0 lit do over i 2 lit lshift + u@ 2013265921u lit u< and loop nip
;

\ ── The root's statement ──

: bch variable ;   \ challenge (r, gamma), as cells
: bchv variable ;  : bchal ( -- a )  bchv 20 lit lazy ;
: bstv variable ;  : bst ( -- a )    bstv 60 lit lazy ;     \ a hashing state
: bxv variable ;   : bx ( -- a )     bxv 100 lit lazy ;     \ scratch ext values
: b# ( k -- a )    4 lit lshift bx + ;
: bprod ( -- a )   0 lit b# ;   : bg1 ( -- a ) 1 lit b# ;   : bg2 ( -- a ) 2 lit b# ;
: bg3 ( -- a )     3 lit b# ;   : bg4 ( -- a ) 4 lit b# ;   : bf ( -- a ) 5 lit b# ;
: bxt ( -- a )      6 lit b# ;

\ bwords+ ( a n -- )   absorb n words from bytes at a (reduced).
: bwords+ ( a n -- )   0 lit do dup i 2 lit lshift + u@ fred os+ loop drop ;
\ bnonce+ ( a -- )   absorb a nonce's 8 limbs (16-bit, little-endian).
: blimb ( a k -- x )   1 lit lshift + dup c@ swap 1 lit + c@ 8 lit lshift or ;
: bnonce+ ( a -- )   8 lit 0 lit do dup i blimb os+ loop drop ;

: bdata variable ;   \ the root's data (bytes)

\ bchall ( -- )   hash_octets(10, n, [data, #in, #out, inputs, (output,
\        nonce)...]) into bchal.
: bchall ( -- )
	bst A lit  bnin @ 3 lit lshift bnout @ 4 lit lshift + A lit +  osbeg
	bdata @ 8 lit bwords+
	bnin @ os+  bnout @ os+
	bnin @ ?dup if 0 lit do bin @ i 5 lit lshift + 8 lit bwords+ loop then
	bnout @ ?dup if 0 lit do
		bout @ i 5 lit lshift + 8 lit bwords+
		bnon @ i 4 lit lshift + bnonce+
	loop then
	osend
	bst bchal 8 lit cpy
;

\ bcom ( a -- )   a commitment's 8 elements (reduced) into bcc: its halves
\        lo = bcc, hi = bcc + 16, as extension values.
: bccv variable ;  : bcc ( -- a )   bccv 20 lit lazy ;
: bcom ( a -- )   bcc 8 lit ucells ;
\ bnlimbs ( a -- )   a nonce's 8 limbs into bcn (halves likewise).
: bcnv variable ;  : bcn ( -- a )   bcnv 20 lit lazy ;
: bnlimbs ( a -- )   8 lit 0 lit do dup i blimb bcn i 2 lit lshift + ! loop drop ;

\ bf+ ( v g -- )   bf += v * g.
: bf+ ( v g -- )   bxt emul  bf bxt bf eadd ;

\ bterm ( -- )   bprod *= r - bf.
: bterm ( -- )   bchal bf bxt esub  bprod bxt bprod emul ;

\ bproduct ( -- )   the product over the body: r - (5 + lo g + hi g^2) per
\        input, r - (6 + lo g + hi g^2 + nlo g^3 + nhi g^4) per output.
: bproduct ( -- )
	bchal 10 lit + bg1 4 lit cpy
	bg1 bg1 bg2 emul  bg2 bg1 bg3 emul  bg2 bg2 bg4 emul
	bprod 4 lit zero  1 lit bprod !
	bnin @ ?dup if 0 lit do
		bin @ i 5 lit lshift + bcom
		5 lit bf ecst  bcc bg1 bf+  bcc 10 lit + bg2 bf+
		bterm
	loop then
	bnout @ ?dup if 0 lit do
		bout @ i 5 lit lshift + bcom  bnon @ i 4 lit lshift + bnlimbs
		6 lit bf ecst  bcc bg1 bf+  bcc 10 lit + bg2 bf+  bcn bg3 bf+  bcn 10 lit + bg4 bf+
		bterm
	loop then
;

\ ── The public octets and tuples ──

: bpvv variable ;  : bpv ( -- a )   bpvv 100 lit lazy ;    \ 8 octets
: btpv variable ;  : btup ( -- a )  btpv 200 lit lazy ;    \ the bus tuples
: bo# ( k -- a )   5 lit lshift bpv + ;

\ blimbs16 ( lo hi a -- )   a u64's four 16-bit limbs, low first, into a.
: blimbs16 ( lo hi a -- )
	over 10 lit rshift over C lit + !
	swap FFFF lit and over 8 lit + !
	over 10 lit rshift over 4 lit + !
	swap FFFF lit and swap !
;

\ bwide ( lo hi a -- )   a count's two 20-bit limbs (`aggregate::wide`).
: bwide ( lo hi a -- )
	-rot
	C lit lshift over 14 lit rshift or fred  2 lit pick 4 lit + !
	FFFFF lit and swap !
;

\ u64s as (lo hi) word pairs.
: dal variable ;  : dah variable ;  : dbl variable ;  : dbh variable ;
: d! ( alo ahi blo bhi -- )   dbh ! dbl ! dah ! dal ! ;
\ d- ( a b -- a-b )   (mod 2^64).   du< ( a b -- flag )
: d- ( alo ahi blo bhi -- dlo dhi )
	d!  dal @ dbl @ -  dah @ dbh @ -  dal @ dbl @ u< if 1 lit - then
;
: du< ( alo ahi blo bhi -- flag )
	d!  dah @ dbh @ u<  dah @ dbh @ = dal @ dbl @ u< and or
;

\ What a block is checked against: the parent's state root (32 bytes) and
\ output count, and the reward at the block's height.
: bproot variable ;  : bpcl variable ;  : bpch variable ;
: brwl variable ;    : brwh variable ;
\ The proof's header: amounts A, B; whether it aggregates.
: bal variable ;  : bah variable ;  : bbl variable ;  : bbh variable ;  : bagg variable ;

\ bvk ( -- )   octet 0: the aggregation key's digest, or zeros for a wrap:
\        hash_octets(7, 256, its cap's elements).
: bvk ( -- )
	0 lit bo# 8 lit zero
	bagg @ if
		bst 7 lit 100 lit osbeg  bacap 100 lit bwords+  osend
		bst 0 lit bo# 8 lit cpy
	then
;

\ bpublic ( -- )   the eight public octets, then the bus tuples: each octet
\        and its index, multiplicity -1.
: bpublic ( -- )
	bvk
	bdata @ 1 lit bo# 8 lit ucells
	bal @ bah @ 2 lit bo# blimbs16   bbl @ bbh @ 2 lit bo# 10 lit + blimbs16
	bproot @ 3 lit bo# 8 lit ucells
	bsroot 4 lit bo# 8 lit ucells
	bpcl @ bpch @ 5 lit bo# bwide          bhcnt 5 lit bo# 8 lit + bwide
	bpcl @ bpch @ 5 lit bo# 10 lit + bwide  bhcnt 5 lit bo# 18 lit + bwide
	bchal 6 lit bo# 8 lit cpy
	7 lit bo# 8 lit zero  bprod 7 lit bo# 4 lit cpy  bheight drop 7 lit bo# 10 lit + !
	8 lit btup !
	8 lit 0 lit do
		btup i B lit * 1 lit + 2 lit lshift +              ( t )
		2013265920u lit over !  9 lit over 4 lit + !
		i bo# over 8 lit + 8 lit cpy
		i swap 28 lit + !
	loop
;

\ bverify ( a n -- ok )   whether the block's bytes parse and its proof
\        proves its body, its state change from the parent (bproot, bpcl/
\        bpch) and the reward (brwl/brwh) -- `Block::proof_is_valid`.
: bverify ( a n -- ok )
	bparse drop
	blok @ if
		bnnon @ bnout @ = bcheck
		bin @ bnin @ 3 lit lshift canon? bcheck
		bout @ bnout @ 3 lit lshift canon? bcheck
		bheight nip 0= bcheck                                 \ a u32 height
		\ The outputs fill the window from the parent's count to the block's.
		bhcnt bpcl @ bpch @ du< 0= bcheck
		bhcnt bpcl @ bpch @ d- 0= swap bnout @ = and bcheck
		\ The proof's header.
		bpr @ bpl @ rinit
		r8 1 lit = bcheck
		r32 bal ! r32 bah !  r32 bbl ! r32 bbh !
		r8 dup 2 lit u< bcheck bagg !
		20 lit rtake dup bdata ! 8 lit canon? bcheck
		rbad @ 0= bcheck
		\ It claims exactly the reward: A - B.
		bal @ bah @ bbl @ bbh @ du< 0= bcheck
		bal @ bah @ bbl @ bbh @ d- brwh @ = swap brwl @ = and bcheck
	then
	blok @ if
		rpos @ rend @ over -                                  ( stark len )
		bchall bproduct bpublic
		btparm
		btlen  bagg @ if bacap else bwcap then  btlde  btup  cverify bcheck
	then
	blok @
;

\ ── Structure and the body hash (`Block::validate_structure`, but for proof
\ of work, which the caller checks against the target) ──

\ c32cmp ( a b -- n )   compare two 32-byte strings: -1, 0 or 1.
: ccr variable ;
: c32cmp ( a b -- n )
	0 lit ccr !
	8 lit 0 lit do
		ccr @ 0= if
			over i 2 lit lshift + be32 over i 2 lit lshift + be32
			2dup u< if 2drop -1 lit ccr ! else u> if 1 lit ccr ! then then
		then
	loop
	2drop ccr @
;

\ bsorted? ( a n -- flag )   whether n 32-byte commitments at a are strictly
\        increasing.
: bsorted? ( a n -- flag )
	-1 lit swap                                          ( a f n )
	dup 1 lit u> if
		1 lit do
			over i 1 lit - 5 lit lshift +  2 lit pick i 5 lit lshift +
			c32cmp -1 lit = and
		loop
	else drop then
	nip
;

\ bselfsp? ( -- flag )   whether an input is also an output: a merge of the
\        two sorted lists.
: bspi variable ;   : bspj variable ;   : bspf variable ;
: bselfsp? ( -- flag )
	0 lit bspi !  0 lit bspj !  0 lit bspf !
	begin bspi @ bnin @ u< bspj @ bnout @ u< and bspf @ 0= and while
		bin @ bspi @ 5 lit lshift +  bout @ bspj @ 5 lit lshift +  c32cmp
		dup 0= if -1 lit bspf ! then
		0< if bspi @ 1 lit + bspi ! else bspj @ 1 lit + bspj ! then
	repeat
	bspf @
;

\ bbodyh ( -- )   the body hash (`BlockBody::body_hash`) into bst: hash_bytes
\        of 3, the counts and lists as they lie in the body, then the hashes
\        of the block proof and the chain proof.
: bphv variable ;   : bph ( -- a )   bphv 20 lit lazy ;
: bcphv variable ;  : bcph ( -- a )  bcphv 20 lit lazy ;
: bbodyh ( -- )
	bst bpl @ hbbeg  bpr @ bpl @ hbytes  hbend  bst bph 8 lit cpy
	bst bcl @ hbbeg  bcp @ bcl @ hbytes  hbend  bst bcph 8 lit cpy
	bst
	bnin @ bnout @ + 5 lit lshift  bnnon @ 4 lit lshift +  4D lit +   ( 1 + 12 + 64 bytes more )
	hbbeg
	3 lit hb1
	bhdr @ BC lit +  bnon @ bnnon @ 4 lit lshift + over -  hbytes
	8 lit 0 lit do bph i 2 lit lshift + @ hbw loop
	8 lit 0 lit do bcph i 2 lit lshift + @ hbw loop
	hbend
;

\ bstruct ( n -- ok )   for a parsed block of n bytes: its version, the size
\        limit, sorted commitments, no output spent in its own block, and
\        the body hash.  (Canonical commitments and the nonce count are
\        bverify's.)
: bstruct ( n -- ok )
	200001 lit u<
	bver 1 lit u< 0= and
	bin @ bnin @ bsorted? and
	bout @ bnout @ bsorted? and
	bselfsp? 0= and
	dup if bbodyh bbhash bst 8 lit ueq and then
;

\ bvalid ( a n -- ok )   everything `Block::validate` checks but proof of
\        work: the structure and body hash first (cheap), then the proof.
: bvalid ( a n -- ok )
	2dup bparse if dup bstruct else 0 lit then
	if bverify else 2drop 0 lit then
;
