63 7A 6E 03	# bgeu t3,s6,c9c <.Lfq_nf>
#     lw      t0, 0(t3)
83 22 0E 00	# lw t0,0(t3)
#     bne     t0, t5, .Lfq_adv
63 92 E2 03	# bne t0,t5,c94 <.Lfq_adv>
#     lw      t0, 4(t3)
83 22 4E 00	# lw t0,4(t3)
#     bne     t0, t6, .Lfq_adv
63 9E F2 01	# bne t0,t6,c94 <.Lfq_adv>
#     lw      t0, 8(t3)                   # kind
83 22 8E 00	# lw t0,8(t3)
#     li      t1, 2
13 03 20 00	# li t1,2
#     bne     t0, t1, .Lfq_adv            # only an immediate ??? is invocable
63 98 62 00	# bne t0,t1,c94 <.Lfq_adv>
#     lw      a6, 12(t3)                  # field0 = entry
03 28 CE 00	# lw a6,12(t3)
#     li      a4, 1
13 07 10 00	# li a4,1
#     RET
6F 00 C0 12	# j dbc <__dispatch>
# .Lfq_adv:
#     addi    t3, t3, 20
13 0E 4E 01	# addi t3,t3,20
#     j       .Lfq_lp
6F F0 1F FD	# j c68 <.Lfq_lp>
