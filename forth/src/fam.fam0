# patch_la -- a0 = address of an `auipc gp` (paired `addi gp,gp` at a0+4),
#   a1 = target. Rewrites the pair to load `target` PC-relative: off = target-a0;
#   auipc gets %hi(off)=(off+0x800)>>12 in imm[31:12], addi gets %lo(off)=off&0xFFF
#   in imm[31:20]. Placeholders are `auipc gp,0`=0x197 / `addi gp,gp,0`=0x18193.
#   Clobbers a2-a5.
# patch_la:
#     sub     a2, a1, a0                  # off = target - auipc address
33 86 A5 40	# sub a2,a1,a0
#     li      a3, 0x800
B7 16 00 00	# lui a3,0x1
93 86 06 80	# addi a3,a3,-2048 # 800 <Lret_24+0x10>
#     add     a3, a2, a3
B3 06 D6 00	# add a3,a2,a3
#     srli    a3, a3, 12                  # a3 = %hi(off)
93 D6 C6 00	# srli a3,a3,0xc
#     slli    a3, a3, 12
93 96 C6 00	# slli a3,a3,0xc
#     ori     a3, a3, 0x197               # rebuild `auipc gp, %hi`
93 E6 76 19	# ori a3,a3,407
#     sw      a3, 0(a0)
23 20 D5 00	# sw a3,0(a0)
#     slli    a4, a2, 20                  # %lo(off) -> imm[31:20]
13 17 46 01	# slli a4,a2,0x14
#     li      a5, 0x18193
B7 87 01 00	# lui a5,0x18
93 87 37 19	# addi a5,a5,403 # 18193 <data+0x171ef>
#     or      a4, a4, a5                  # rebuild `addi gp, gp, %lo`
33 67 F7 00	# or a4,a4,a5
#     sw      a4, 4(a0)
23 22 E5 00	# sw a4,4(a0)
#     RET
6F 00 00 30	# j dbc <__dispatch>

# gen_bst -- a0 = lo, a1 = hi.  Emit a balanced BST node covering return-id
#   range [lo, hi] into the output at gp:
#       li t1, mid ; bne t0,t1,+8 ; j site[mid]   (hit)
#       bge t0,t1,+8 ; j Lleft                     (t0<mid -> left subtree)
#       <right subtree>  (fall-through, t0>mid)    Lleft: <left subtree>
#   A leaf (lo==hi) is just `j site[lo]`; the range check upstream guarantees
#   a valid id reaches the right leaf. Recursive: lo/hi/mid/jleft live in a
#   16-byte sp frame across the two recursive calls. site[id] = *((s7+0x100000)
#   + 4 + id*4).  Clobbers t0-t6, a0-a1 (frame-saved values reloaded each time).
# gen_bst:
#     blt     a1, a0, .Lgb_done           # lo > hi: empty subtree
63 CA A5 02	# blt a1,a0,af4 <Lret_33>
#     bne     a0, a1, .Lgb_node           # lo != hi: internal node
63 1A B5 02	# bne a0,a1,af8 <.Lgb_node>
#     li      t3, 0x100004                # leaf: lo == hi -> j site[lo]
37 0E 10 00	# lui t3,0x100
13 0E 4E 00	# addi t3,t3,4 # 100004 <data+0xff060>
#     add     t3, s7, t3                  # &site[0]
33 8E CB 01	# add t3,s7,t3
#     slli    t4, a0, 2
93 1E 25 00	# slli t4,a0,0x2
#     add     t3, t3, t4                  # &site[lo]
33 0E DE 01	# add t3,t3,t4
#     lw      a0, 0(t3)
03 25 0E 00	# lw a0,0(t3)
#     CALL    emit_j
93 8D CD FF	# addi s11,s11,-4
63 EC AD 29	# bltu s11,s10,d7c <__panic>
93 02 10 02	# li t0,33
23 A0 5D 00	# sw t0,0(s11)
6F F0 9F F4	# j a38 <emit_j>
# .Lgb_done:
#     RET
6F 00 80 2C	# j dbc <__dispatch>
# .Lgb_node:
#     addi    sp, sp, -16                 # frame: [lo, hi, mid, jleft]
13 01 01 FF	# addi sp,sp,-16
#     addi    t0, s3, -0x400              # t0 = stack floor (= heap top)
93 82 09 C0	# addi t0,s3,-1024
#     bltu    sp, t0, __panic             # frame overflowed its 1 KiB stack
63 6E 51 26	# bltu sp,t0,d7c <__panic>
#     sw      a0, 0(sp)                   # lo
23 20 A1 00	# sw a0,0(sp)
#     sw      a1, 4(sp)                   # hi
23 22 B1 00	# sw a1,4(sp)
#     add     t3, a0, a1
33 0E B5 00	# add t3,a0,a1
#     srli    t3, t3, 1
13 5E 1E 00	# srli t3,t3,0x1
#     sw      t3, 8(sp)                   # mid = (lo + hi) / 2
23 24 C1 01	# sw t3,8(sp)
#     mv      a0, t3                      # li t1, mid   (lui+addi: mid may exceed 2047)
13 05 0E 00	# mv a0,t3
#     li      a1, 0x337                   #   lui t1, 0
93 05 70 33	# li a1,823
#     li      a2, 0x30313                 #   addi t1, t1, 0
37 06 03 00	# lui a2,0x30
13 06 36 31	# addi a2,a2,787 # 30313 <data+0x2f36f>
#     CALL    emit_li
93 8D CD FF	# addi s11,s11,-4
63 E8 AD 25	# bltu s11,s10,d7c <__panic>
93 02 20 02	# li t0,34
23 A0 5D 00	# sw t0,0(s11)
6F 00 00 18	# j cb8 <emit_li>
#     li      a0, 0x00629463             # bne t0, t1, +8  (skip the hit jump)
37 95 62 00	# lui a0,0x629
13 05 35 46	# addi a0,a0,1123 # 629463 <data+0x6284bf>
#     CALL    emit_word
93 8D CD FF	# addi s11,s11,-4
63 EA AD 23	# bltu s11,s10,d7c <__panic>
93 02 30 02	# li t0,35
23 A0 5D 00	# sw t0,0(s11)
6F 00 00 15	# j ca4 <emit_word>
#     li      t3, 0x100004                # j site[mid]
37 0E 10 00	# lui t3,0x100
13 0E 4E 00	# addi t3,t3,4 # 100004 <data+0xff060>
#     add     t3, s7, t3
33 8E CB 01	# add t3,s7,t3
#     lw      t4, 8(sp)
83 2E 81 00	# lw t4,8(sp)
#     slli    t4, t4, 2
93 9E 2E 00	# slli t4,t4,0x2
#     add     t3, t3, t4
33 0E DE 01	# add t3,t3,t4
#     lw      a0, 0(t3)
03 25 0E 00	# lw a0,0(t3)
#     CALL    emit_j
93 8D CD FF	# addi s11,s11,-4
63 E2 AD 21	# bltu s11,s10,d7c <__panic>
93 02 40 02	# li t0,36
23 A0 5D 00	# sw t0,0(s11)
6F F0 5F EB	# j a38 <emit_j>
#     li      a0, 0x0062D463             # bge t0, t1, +8  (t0>=mid -> skip left jump)
37 D5 62 00	# lui a0,0x62d
13 05 35 46	# addi a0,a0,1123 # 62d463 <data+0x62c4bf>
#     CALL    emit_word
93 8D CD FF	# addi s11,s11,-4
63 E4 AD 1F	# bltu s11,s10,d7c <__panic>
93 02 50 02	# li t0,37
23 A0 5D 00	# sw t0,0(s11)
6F 00 40 10	# j ca4 <emit_word>
#     mv      t5, gp                      # jleft = slot of the placeholder j
13 8F 01 00	# mv t5,gp
#     sw      t5, 12(sp)
23 26 E1 01	# sw t5,12(sp)
#     li      a0, 0x6F                   # j Lleft  (placeholder, backpatched below)
13 05 F0 06	# li a0,111
#     CALL    emit_word
93 8D CD FF	# addi s11,s11,-4
63 E4 AD 1D	# bltu s11,s10,d7c <__panic>
93 02 60 02	# li t0,38
23 A0 5D 00	# sw t0,0(s11)
6F 00 40 0E	# j ca4 <emit_word>
#     lw      t3, 8(sp)                   # recurse right: gen_bst(mid+1, hi)
03 2E 81 00	# lw t3,8(sp)
#     addi    a0, t3, 1
13 05 1E 00	# addi a0,t3,1
#     lw      a1, 4(sp)
83 25 41 00	# lw a1,4(sp)
#     CALL    gen_bst
93 8D CD FF	# addi s11,s11,-4
63 E4 AD 1B	# bltu s11,s10,d7c <__panic>
93 02 70 02	# li t0,39
23 A0 5D 00	# sw t0,0(s11)
6F F0 1F EE	# j ac0 <gen_bst>
    # Patch the left-jump placeholder. The left subtree is gen_bst(lo, mid-1),
    # which is EMPTY when mid==lo (a 2-element node [lo, lo+1]). For a valid id
    # the t0<mid edge is then unreachable -- but a corrupt RID could take it, so
    # point it at a `j .` self-loop halt rather than at the next code / EOF
    # (which is where `gp` lands when nothing follows). Matches the upstream
    # range-check sentinel; keeps the CFG closed and every dead edge bounded.
#     lw      t3, 8(sp)                   # mid
03 2E 81 00	# lw t3,8(sp)
#     lw      t4, 0(sp)                   # lo
83 2E 01 00	# lw t4,0(sp)
#     lw      a0, 12(sp)                  # Lleft placeholder slot
03 25 C1 00	# lw a0,12(sp)
#     beq     t3, t4, .Lgb_left_empty     # mid==lo -> left empty -> halt, no recurse
63 02 DE 05	# beq t3,t4,c34 <.Lgb_left_empty>
#     mv      a1, gp                      # left non-empty: Lleft -> left subtree (gp)
93 85 01 00	# mv a1,gp
#     CALL    patch_j
93 8D CD FF	# addi s11,s11,-4
63 E0 AD 19	# bltu s11,s10,d7c <__panic>
93 02 80 02	# li t0,40
23 A0 5D 00	# sw t0,0(s11)
6F F0 DF E5	# j a64 <patch_j>
#     lw      a0, 0(sp)                   # recurse left: gen_bst(lo, mid-1)
03 25 01 00	# lw a0,0(sp)
#     lw      t3, 8(sp)
03 2E 81 00	# lw t3,8(sp)
#     addi    a1, t3, -1
93 05 FE FF	# addi a1,t3,-1
#     CALL    gen_bst
93 8D CD FF	# addi s11,s11,-4
63 E0 AD 17	# bltu s11,s10,d7c <__panic>
93 02 90 02	# li t0,41
23 A0 5D 00	# sw t0,0(s11)
6F F0 9F E9	# j ac0 <gen_bst>
#     addi    sp, sp, 16
13 01 01 01	# addi sp,sp,16
#     RET
6F 00 C0 18	# j dbc <__dispatch>
# .Lgb_left_empty:
#     mv      a1, a0                      # target = the j's own address -> `j .` halt
93 05 05 00	# mv a1,a0
#     CALL    patch_j
93 8D CD FF	# addi s11,s11,-4
63 E0 AD 15	# bltu s11,s10,d7c <__panic>
93 02 A0 02	# li t0,42
23 A0 5D 00	# sw t0,0(s11)
6F F0 DF E1	# j a64 <patch_j>
#     addi    sp, sp, 16
13 01 01 01	# addi sp,sp,16
#     RET
6F 00 C0 16	# j dbc <__dispatch>

# imm_tramp -- one-slot trampoline for invoking an immediate word at a runtime-
#   determined address without jalr. .Lc_invimm patches this to `j <entry>` then
#   `CALL imm_tramp`; the body returns via `j __dispatch`. Only reached via that
#   CALL (the preceding RET means it is never fallen into); the self-loop is just
#   a safe placeholder if it somehow runs unpatched.
# imm_tramp:
#     j       imm_tramp
6F 00 00 00	# j c54 <imm_tramp>

# find_qqq -- look up the immediate word named "???" (packed name lo=0x003F3F3F,
#   hi=0). Returns a4=1 and a6=entry if a kind=2 entry exists, else a4=0.
#   Preserves t2/s1 (the caller's token span). Clobbers t0,t1,t3,t5,t6,a4,a6.
