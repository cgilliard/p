\ einv ( a out -- )   the inverse (0 maps to 0), by the tower F_p(u)(x), u =
\        x^2, u^2 = 11: a = A + B x with A = c0 + c2 u, B = c1 + c3 u, and
\        a^-1 = (A - B x) / D, D = A^2 - B^2 u = d0 + d1 u in F_p(u), whose
\        inverse is (d0 - d1 u) / (d0^2 - 11 d1^2) -- one base-field inverse
\        and some twenty multiplies, where a^(p^4 - 2) took some 2,900.
: eic0 variable ;  : eic1 variable ;  : eic2 variable ;  : eic3 variable ;
: eid0 variable ;  : eid1 variable ;  : eie0 variable ;  : eie1 variable ;
: einv ( a out -- )
	swap dup @ eic0 !  dup 4 lit + @ eic1 !  dup 8 lit + @ eic2 !  C lit + @ eic3 !
	eic0 @ dup fmul  eic2 @ dup fmul B lit fmul fadd                  \ c0^2 + 11 c2^2
	eic1 @ eic3 @ fmul dup fadd B lit fmul fsub  eid0 !               \ - 11 (2 c1 c3)
	eic0 @ eic2 @ fmul dup fadd                                       \ 2 c0 c2
	eic1 @ dup fmul  eic3 @ dup fmul B lit fmul fadd  fsub  eid1 !    \ - (c1^2 + 11 c3^2)
	eid0 @ dup fmul  eid1 @ dup fmul B lit fmul fsub  finv            ( out 1/n )
	dup eid0 @ fmul eie0 !
	eid1 @ fmul 0 lit swap fsub eie1 !                                \ E = D^-1 = e0 + e1 u
	eic0 @ eie0 @ fmul  eic2 @ eie1 @ fmul B lit fmul fadd  over !            \ A E, then
	0 lit  eic1 @ eie0 @ fmul  eic3 @ eie1 @ fmul B lit fmul fadd  fsub  over 4 lit + !
	eic0 @ eie1 @ fmul  eic2 @ eie0 @ fmul fadd  over 8 lit + !               \ - B E x
	0 lit  eic1 @ eie1 @ fmul  eic3 @ eie0 @ fmul fadd  fsub  swap C lit + !
;

\ epow ( a e out -- )   a^e for a 32-bit e (out may be a).
: epbv variable ;   : epb ( -- a )   epbv 10 lit lazy ;   \ the running power
: epow ( a e out -- )
	rot epb 4 lit cpy                                   ( e out )
	dup 4 lit zero  1 lit over !                        \ out = 1
	swap
	begin dup while                                     ( out e )
		dup 1 lit and if over epb 3 lit pick emul then
		epb epb epb emul
		1 lit rshift
	repeat
	2drop
;

\ ── Tests (./tools/fam --test src/poseidon2.fam src/ext.fam) ──
\ Vectors printed by the Rust node's ext module.

\ et ( -- a b out )   a, b and an output, fresh each call.
: et ( -- a b out )
	30 lit alloc
	123456789u lit over !  987654321u lit over 4 lit + !
	555555555u lit over 8 lit + !  1000000007u lit over C lit + !
	31337u lit over 10 lit + !  40000000 lit over 14 lit + !
	7 lit over 18 lit + !  2013265920u lit over 1C lit + !
	dup 10 lit + over 20 lit +
;
\ c4? ( a x0 x1 x2 x3 -- flag )   whether the 4 cells at a are x0..x3 (for
\        tests; returns a flag because asrt_eq exists only in test builds).
: c4? ( a x0 x1 x2 x3 -- flag )
	4 lit pick C lit + @ =
	swap 4 lit pick 8 lit + @ = and
	swap 3 lit pick 4 lit + @ = and
	swap 2 lit pick @ = and
	nip
;

Test {
	ext_mul {
		et 2 lit pick 2 lit pick 2 lit pick emul nip nip
		619148263u lit 142539038u lit 540439412u lit 970188393u lit c4? assert
	}
	ext_add_sub {
		et 2 lit pick 2 lit pick 2 lit pick eadd nip nip
		123488126u lit 48130224u lit 555555562u lit 1000000006u lit c4? assert
		et 2 lit pick 2 lit pick 2 lit pick esub nip nip
		123425452u lit 1927178418u lit 555555548u lit 1000000008u lit c4? assert
	}
	ext_mul_base {
		et nip over 12345u lit 2 lit pick emulb nip
		31758008u lit 254175169u lit 1149599549u lit 1666724764u lit c4? assert
	}
	ext_inverse {
		et nip 2dup einv nip
		397913375u lit 1394126716u lit 1080238130u lit 463907256u lit c4? assert
		et nip 2dup einv 2dup dup emul nip               \ a * (1/a) = 1
		1 lit 0 lit 0 lit 0 lit c4? assert
		et nip dup 4 lit zero over 4 lit zero 2dup einv nip  \ 1/0 = 0
		0 lit 0 lit 0 lit 0 lit c4? assert
	}
	x4_is_11 {
		et nip nip dup 4 lit zero 1 lit over 4 lit + !     ( x )
		dup dup dup emul  dup dup dup emul                 \ x^2, then x^4
		11u lit 0 lit 0 lit 0 lit c4? assert
	}
	ext_pow {
		et nip 2dup A lit swap epow                        \ out = a^10
		et 2drop                                           ( a out c: another copy of a )
		9 lit 0 lit do dup 3 lit pick over emul loop      \ c = a^10, by repeated multiplication
		4 lit ceq assert drop
	}
	base_inverse {
		123456789u lit finv 266041062u lit asrt_eq
		2 lit finv 1006632961u lit asrt_eq
		3 lit 7 lit fpow 2187u lit asrt_eq
	}
}
