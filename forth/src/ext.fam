\ ──────────────────────────────────────────────────────────────────────────────
\ src/ext.fam — the degree-4 extension of BabyBear, BabyBear[x] / (x^4 - 11)
\ (see ../rust/src/ext.rs), where a STARK's challenges live; plus base-field
\ powers and inverses.
\
\ An extension element is 4 cells, c0 + c1 x + c2 x^2 + c3 x^3, passed by
\ address.  Results go to `out`, which may be either input.
\ ──────────────────────────────────────────────────────────────────────────────

\ fpow ( x e -- x^e )   square and multiply over e's bits.
: fpow ( x e -- r )
	1 lit -rot                                   ( r x e )
	begin dup while
		dup 1 lit and if rot 2 lit pick fmul -rot then
		swap dup fmul swap 1 lit rshift
	repeat
	2drop
;

\ finv ( x -- 1/x )   x^(p - 2); 0 maps to 0.
: finv ( x -- y )   2013265919u lit fpow ;

\ eadd / esub ( a b out -- )   coefficient-wise.
: eadd ( a b out -- )
	4 lit 0 lit do
		2 lit pick i 2 lit lshift + @ 2 lit pick i 2 lit lshift + @ fadd over i 2 lit lshift + !
	loop
	2drop drop
;
: esub ( a b out -- )
	4 lit 0 lit do
		2 lit pick i 2 lit lshift + @ 2 lit pick i 2 lit lshift + @ fsub over i 2 lit lshift + !
	loop
	2drop drop
;

\ emulb ( a x out -- )   times a base-field element.
: emulb ( a x out -- )
	4 lit 0 lit do
		2 lit pick i 2 lit lshift + @ 2 lit pick fmul over i 2 lit lshift + !
	loop
	2drop drop
;

\ emul ( a b out -- )   the schoolbook product into degree 6, then x^4 = 11
\        folds terms 4..6 back down.  src/emul.S, assembled by tools/s2words.py
\        (rerun it, and paste the words here, after editing that): one loop
\        over the 16 products around a branch-free multiply (src/p2core.S).
: emul ( a b out -- )
03260100 ,   \ lw a2,0(sp)
