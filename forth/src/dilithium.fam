\ ── The polynomials: a pool of 64 ──
: dipv variable ;  : dip ( k -- f )   A lit lshift dipv 10000 lit lazy + ;
: dic@ ( f i -- x )   2 lit lshift + @ ;
: dic! ( x f i -- )   2 lit lshift + ! ;
: dizero ( f -- )   100 lit zero ;
: dicopy ( f g -- )   100 lit cpy ;

: dif variable ;  : dig variable ;  : dih variable ;  : dil variable ;  : dis variable ;  : dim variable ;  : dizt variable ;  : dit variable ;

\ dintt ( f -- )   in place (FIPS 204, Algorithm 41).
: dintt ( f -- )
	dif !  0 lit dim !  80 lit dil !
	begin dil @ while
		0 lit dis !
		begin dis @ 100 lit u< while
			dim @ 1 lit + dim !  dizeta dim @ dic@ dizt !
			dis @ dil @ + dis @ do
				dif @ i dil @ + dic@ dizt @ dimul dit !
				dif @ i dic@ dit @ disub  dif @ i dil @ + dic!
				dif @ i dic@ dit @ diadd  dif @ i dic!
			loop
			dis @ dil @ 1 lit lshift + dis !
		repeat
		dil @ 1 lit rshift dil !
	repeat
;

\ diintt ( f -- )   in place (Algorithm 42), times 256^-1 (8347681).
: diintt ( f -- )
	dif !  100 lit dim !  1 lit dil !
	begin dil @ 100 lit u< while
		0 lit dis !
		begin dis @ 100 lit u< while
			dim @ 1 lit - dim !  diq dizeta dim @ dic@ - dizt !
			dis @ dil @ + dis @ do
				dif @ i dic@ dit !
				dit @ dif @ i dil @ + dic@ diadd  dif @ i dic!
				dit @ dif @ i dil @ + dic@ disub dizt @ dimul  dif @ i dil @ + dic!
			loop
			dis @ dil @ 1 lit lshift + dis !
		repeat
		dil @ 1 lit lshift dil !
	repeat
	100 lit 0 lit do dif @ i dic@ 7F6021 lit dimul dif @ i dic! loop
;

\ dimacc ( f g h -- )   h += f g, pointwise (NTT domain).
: dimacc ( f g h -- )
	dih ! dig ! dif !
	100 lit 0 lit do dif @ i dic@ dig @ i dic@ dimul  dih @ i dic@ diadd  dih @ i dic! loop
;
\ dipmul ( f g h -- )   h = f g, pointwise.
: dipmul ( f g h -- )   dup dizero dimacc ;
: diaddp ( f g -- )   100 lit 0 lit do over i dic@ over i dic@ diadd over i dic! loop 2drop ;     \ g += f
: disubp ( f g -- )   100 lit 0 lit do dup i dic@ 2 lit pick i dic@ disub over i dic! loop 2drop ;   \ g -= f

\ ── Sampling (Algorithms 29 to 34) ──

: dibv variable ;  : dib ( -- a )  dibv 280 lit lazy ;      \ bytes squeezed
: dij variable ;

\ direj ( rho s r f -- )   A[r][s]: RejNTTPoly of SHAKE128(rho s r).
: direj ( rho s r f -- )
	dif !  dib 1 lit + c!  dib c!
	A8 lit 1F lit kbeg  20 lit kabs  dib 2 lit kabs  kend
	0 lit dij !
	begin dij @ 100 lit u< while
		dib 3 lit ksqz
		dib c@  dib 1 lit + c@ 8 lit lshift or  dib 2 lit + c@ 7F lit and 10 lit lshift or
		dup diq u< if dif @ dij @ dic!  dij @ 1 lit + dij ! else drop then
	repeat
;

\ dibnd ( rho' r f -- )   RejBoundedPoly (eta 2) of SHAKE256(rho' r), r as two
\        bytes: half-bytes below 15 give 2 - (b mod 5).
: dihalf ( b -- )
	dup F lit u< dij @ 100 lit u< and if 2 lit swap 5 lit % - dimodq dif @ dij @ dic!  dij @ 1 lit + dij ! else drop then
;
: dibnd ( rho' r f -- )
	dif !  dup dib c!  8 lit rshift dib 1 lit + c!
	88 lit 1F lit kbeg  40 lit kabs  dib 2 lit kabs  kend
	0 lit dij !
	begin dij @ 100 lit u< while
		dib 1 lit ksqz  dib c@ dup F lit and dihalf  4 lit rshift dihalf
	repeat
;

\ dipack ( f bits out -- )   coefficients of `bits` bits, little-endian bit
\ diunpk ( in bits f -- )    order, 256 of them -- and back.
: dibt variable ;  : dio variable ;  : diac variable ;  : din variable ;
: dipack ( f bits out -- )
	dio ! dibt ! dif !  0 lit diac !  0 lit din !
	100 lit 0 lit do
		dif @ i dic@ din @ lshift diac @ or diac !  din @ dibt @ + din !
		begin din @ 7 lit u> while
			diac @ dio @ c!  dio @ 1 lit + dio !  diac @ 8 lit rshift diac !  din @ 8 lit - din !
		repeat
	loop
;
: diunpk ( in bits f -- )
	dif ! dibt ! dio !  0 lit diac !  0 lit din !
	100 lit 0 lit do
		begin din @ dibt @ u< while
			dio @ c@ din @ lshift diac @ or diac !  dio @ 1 lit + dio !  din @ 8 lit + din !
		repeat
		diac @  1 lit dibt @ lshift 1 lit - and  dif @ i dic!
		diac @ dibt @ rshift diac !  din @ dibt @ - din !
	loop
;
\ dioff ( f c -- )   each coefficient x to c - x (mod q): the packings' offsets.
: dioff ( f c -- )   swap dif ! 100 lit 0 lit do dup dif @ i dic@ disub dif @ i dic! loop drop ;

\ dimask ( rho'' n f -- )   ExpandMask's polynomial: 18-bit values of
\        SHAKE256(rho'' n), as gamma1 - x.
: dimask ( rho'' n f -- )
	dif !  dup dib c!  8 lit rshift dib 1 lit + c!
	88 lit 1F lit kbeg  40 lit kabs  dib 2 lit kabs  kend  dib 240 lit ksqz
	dib 12 lit dif @ diunpk  dif @ 20000 lit dioff
;

\ diball ( ct f -- )   SampleInBall: tau = 39 coefficients of +-1, from
\        SHAKE256(c~): 8 bytes of signs, then the places.
: disgl variable ;  : disgh variable ;
: diball ( ct f -- )
	dif !  88 lit 1F lit kbeg  20 lit kabs  kend
	dif @ dizero
	dib 8 lit ksqz  dib dup c@ over 1 lit + c@ 8 lit lshift or over 2 lit + c@ 10 lit lshift or swap 3 lit + c@ 18 lit lshift or disgl !
	dib 4 lit + dup c@ over 1 lit + c@ 8 lit lshift or over 2 lit + c@ 10 lit lshift or swap 3 lit + c@ 18 lit lshift or disgh !
	100 lit D9 lit do
		begin dib 1 lit ksqz dib c@ i u> while repeat
		dif @ dib c@ dic@  dif @ i dic!
		disgl @ 1 lit and if diq 1 lit - else 1 lit then  dif @ dib c@ dic!
		disgl @ 1 lit rshift  disgh @ 1F lit lshift or disgl !  disgh @ 1 lit rshift disgh !
	loop
;

\ ── Rounding (Algorithms 35 to 40) ──

\ dip2r ( r -- r1 r0 )   Power2Round, d = 13: r0 = r mod+- 2^13 (signed).
: dip2r ( r -- r1 r0 )   dup 1FFF lit and dup 1000 lit u> if 2000 lit - then  tuck - D lit rshift swap ;

\ didec ( r -- r1 r0 )   Decompose, alpha = 2 gamma2 = 190464: r0 signed.
: dialf ( -- a )   2E800 lit ;
: didec ( r -- r1 r0 )
	dup dialf % dup 17400 lit u> if dialf - then                     ( r r0 )
	2dup - diq 1 lit - = if nip 1 lit - 0 lit swap else tuck - dialf / swap then
;
: dihigh ( r -- r1 )   didec drop ;
\ dihint ( z r -- h )   MakeHint: whether r's high bits change when z is added.
: dihint ( z r -- h )   tuck diadd dihigh swap dihigh <> 1 lit and ;
\ diuse ( h r -- r1 )   UseHint, m = 44.
: diuse ( h r -- r1 )
	didec rot if 0 lit > if 1 lit + dup 2C lit = if drop 0 lit then else dup 0= if drop 2B lit else 1 lit - then then else drop then
;
\ dinorm ( f b -- bad )   whether any coefficient's |x| is b or more.
: dinorm ( f b -- bad )
	swap dif !  0 lit swap  100 lit 0 lit do dif @ i dic@ dicen diabs over u< 0= rot or swap loop drop
;

\ ── Keys, signing, verifying (Algorithms 6, 7, 8) ──
\ The pool: A[r][s] 4r + s (0..15), s1 16..19, s2 20..23, t (then t1)
\ 24..27, t0 28..31, y 32..35, w 36..39, z 40..43, c 44, a scratch 45,
\ h 48..51, cs2 52..55, ct0 56..59, y's NTT 60..63.

: dirv variable ;  : diseed ( -- a )  dirv 80 lit lazy ;    \ rho, rho', K
: dimuv variable ;  : dimu ( -- a )  dimuv 40 lit lazy ;   \ mu
: dir2v variable ;  : dirho2 ( -- a )  dir2v 40 lit lazy ; \ rho''
: dictv variable ;  : dict ( -- a )  dictv 20 lit lazy ;   \ c~
: diwv variable ;  : diw1 ( -- a )  diwv 300 lit lazy ;    \ w1, encoded
: dipk variable ;  : disk variable ;  : disig variable ;

\ dimat ( rho -- )   ExpandA.
: dimat ( rho -- )   4 lit 0 lit do 4 lit 0 lit do dup i j  j 4 lit * i + dip direj loop loop drop ;

\ dimv ( v0 out0 -- )   out = invNTT(A v) for the NTT vector at pool v0.
: dimv ( v0 out0 -- )
	4 lit 0 lit do
		dup i + dip dizero
		4 lit 0 lit do  j 4 lit * i + dip  2 lit pick i + dip  2 lit pick j + dip dimacc  loop
		dup i + dip diintt
	loop 2drop
;

\ dih64 ( a n out -- )   H: SHAKE256, 64 bytes.
: dih64 ( a n out -- )   40 lit shake256 ;

\ dihpack ( out -- )   HintBitPack of h (pool 48..51): the places of the
\        ones, then each polynomial's running count (omega + k bytes).
\ dihunpk ( in -- ok )   HintBitUnpack, into h: refused if malformed.
: dix variable ;  : dio2 variable ;
: dihpack ( out -- )
	dio2 !  dio2 @ 54 lit nzero  0 lit dix !
	4 lit 0 lit do
		100 lit 0 lit do
			j 30 lit + dip i dic@ if i dio2 @ dix @ + c!  dix @ 1 lit + dix ! then
		loop
		dix @ dio2 @ 50 lit + i + c!
	loop
;
: diok variable ;  : difirst variable ;
: dihunpk ( in -- ok )
	dio2 !  0 lit dix !  -1 lit diok !
	4 lit 0 lit do
		i 30 lit + dip dizero
		dio2 @ 50 lit + i + c@  dup dix @ u<  over 50 lit u> or if 0 lit diok ! then
		dix @ difirst !
		begin dix @ over u< diok @ and while
			dix @ difirst @ u>  if dio2 @ dix @ + 1 lit - c@  dio2 @ dix @ + c@ u< 0= if 0 lit diok ! then then
			1 lit  i 30 lit + dip  dio2 @ dix @ + c@ dic!
			dix @ 1 lit + dix !
		repeat drop
	loop
	diok @ if dix @ 50 lit u< if 50 lit dix @ do dio2 @ i + c@ if 0 lit diok ! then loop then then   \ the rest: zeros
	diok @
;

\ diw1 encoding: each polynomial's 256 high bits, 6 bits each (192 bytes).
: diw1e ( p0 -- )   4 lit 0 lit do dup i + dip 6 lit diw1 i C0 lit * + dipack loop drop ;

\ dikeys ( xi pk sk -- )   KeyGen (Algorithm 6).
: dikeys ( xi pk sk -- )
	disk ! dipk !
	diw1 20 lit ncpy  4 lit diw1 20 lit + c!  4 lit diw1 21 lit + c!
	diw1 22 lit diseed 80 lit shake256                                  \ (rho, rho', K) = H(xi k l, 128)
	diseed dimat
	4 lit 0 lit do diseed 20 lit + i i 10 lit + dip dibnd loop          \ s1
	4 lit 0 lit do diseed 20 lit + i 4 lit + i 14 lit + dip dibnd loop  \ s2
	4 lit 0 lit do i 10 lit + dip i 3C lit + dip dicopy  i 3C lit + dip dintt loop
	3C lit 18 lit dimv                                                  \ t = invNTT(A NTT(s1)) + s2
	4 lit 0 lit do
		i 14 lit + dip i 18 lit + dip diaddp
		100 lit 0 lit do                                                \ (t1, t0) = Power2Round(t)
			j 18 lit + dip i dic@ dip2r dimodq  j 1C lit + dip i dic!  j 18 lit + dip i dic!
		loop
	loop
	diseed dipk @ 20 lit ncpy
	4 lit 0 lit do i 18 lit + dip A lit dipk @ 20 lit + i 140 lit * + dipack loop
	diseed disk @ 20 lit ncpy  diseed 60 lit + disk @ 20 lit + 20 lit ncpy
	dipk @ 520 lit disk @ 40 lit + dih64                                \ tr = H(pk, 64)
	4 lit 0 lit do
		i 10 lit + dip 2 lit dioff  i 10 lit + dip 3 lit disk @ 80 lit + i 60 lit * + dipack
		i 14 lit + dip 2 lit dioff  i 14 lit + dip 3 lit disk @ 200 lit + i 60 lit * + dipack
		i 1C lit + dip 1000 lit dioff  i 1C lit + dip D lit disk @ 380 lit + i 1A0 lit * + dipack
	loop
;

\ dimsg ( tr m n -- )   mu = H(tr M', 64), M' = 0 0 m (no context).
: dizz variable ;
: dimsg ( tr m n -- )
	88 lit 1F lit kbeg  rot 40 lit kabs  0 lit dizz !  dizz 2 lit kabs  kabs  kend  dimu 40 lit ksqz
;

\ disign ( sk m n rnd sig -- )   Sign (Algorithms 2 and 7).
: dikap variable ;  : dirnd variable ;  : dibad variable ;  : dihn variable ;
: disign ( sk m n rnd sig -- )
	disig ! dirnd ! rot disk !
	disk @ 40 lit + -rot dimsg
	4 lit 0 lit do                                                      \ s1, s2, t0: unpacked, NTT
		disk @ 80 lit + i 60 lit * + 3 lit i 10 lit + dip diunpk  i 10 lit + dip 2 lit dioff  i 10 lit + dip dintt
		disk @ 200 lit + i 60 lit * + 3 lit i 14 lit + dip diunpk  i 14 lit + dip 2 lit dioff  i 14 lit + dip dintt
		disk @ 380 lit + i 1A0 lit * + D lit i 1C lit + dip diunpk  i 1C lit + dip 1000 lit dioff  i 1C lit + dip dintt
	loop
	disk @ dimat
	88 lit 1F lit kbeg  disk @ 20 lit + 20 lit kabs  dirnd @ 20 lit kabs  dimu 40 lit kabs  kend  dirho2 40 lit ksqz
	0 lit dikap !
	begin
		4 lit 0 lit do dirho2 dikap @ i + i 20 lit + dip dimask  i 20 lit + dip i 3C lit + dip dicopy  i 3C lit + dip dintt loop
		dikap @ 4 lit + dikap !
		3C lit 24 lit dimv                                              \ w
		4 lit 0 lit do 100 lit 0 lit do j 24 lit + dip i dic@ dihigh  j 2C lit + dip i dic! loop loop
		2C lit diw1e                                                     \ c~ = H(mu w1Encode(w1), 32)
		88 lit 1F lit kbeg  dimu 40 lit kabs  diw1 300 lit kabs  kend  dict 20 lit ksqz
		dict 2C lit dip diball  2C lit dip dintt
		0 lit dibad !
		4 lit 0 lit do                                                  \ z = y + c s1; cs2; ct0
			2C lit dip i 10 lit + dip i 28 lit + dip dipmul  i 28 lit + dip diintt  i 20 lit + dip i 28 lit + dip diaddp
			2C lit dip i 14 lit + dip i 34 lit + dip dipmul  i 34 lit + dip diintt
			2C lit dip i 1C lit + dip i 38 lit + dip dipmul  i 38 lit + dip diintt
			i 28 lit + dip 20000 lit 4E lit - dinorm dibad @ or dibad !
			i 38 lit + dip 17400 lit dinorm dibad @ or dibad !
			100 lit 0 lit do                                            \ r0 = LowBits(w - cs2)
				j 24 lit + dip i dic@  j 34 lit + dip i dic@ disub  didec nip diabs 17400 lit 4E lit - u< 0= dibad @ or dibad !
			loop
		loop
		dibad @ 0= if
			0 lit dihn !
			4 lit 0 lit do 100 lit 0 lit do                             \ h = MakeHint(-ct0, w - cs2 + ct0)
				diq j 38 lit + dip i dic@ - dup diq = if drop 0 lit then
				j 24 lit + dip i dic@ j 34 lit + dip i dic@ disub j 38 lit + dip i dic@ diadd
				dihint dup j 30 lit + dip i dic!  dihn @ + dihn !
			loop loop
			dihn @ 50 lit u> dibad !
		then
		dibad @ 0=
	until
	dict disig @ 20 lit ncpy
	4 lit 0 lit do i 28 lit + dip 20000 lit dioff  i 28 lit + dip 12 lit disig @ 20 lit + i 240 lit * + dipack loop
	disig @ 920 lit + dihpack
;

\ diverify ( pk m n sig -- ok )   Verify (Algorithms 3 and 8).
: diverify ( pk m n sig -- ok )
	disig ! rot dipk !
	dipk @ 520 lit dimu dih64  dimu -rot dimsg                          \ tr, then mu
	disig @ 920 lit + dihunpk dup if
		0 lit dibad !
		4 lit 0 lit do
			disig @ 20 lit + i 240 lit * + 12 lit i 28 lit + dip diunpk  i 28 lit + dip 20000 lit dioff
			i 28 lit + dip 20000 lit 4E lit - dinorm dibad @ or dibad !
			dipk @ 20 lit + i 140 lit * + A lit i 18 lit + dip diunpk
		loop
		dibad @ 0= and
	then
	dup if
		dipk @ dimat
		disig @ 2C lit dip diball  2C lit dip dintt
		4 lit 0 lit do
			i 28 lit + dip dintt
			100 lit 0 lit do j 18 lit + dip i dic@ D lit lshift  j 18 lit + dip i dic! loop    \ t1 2^d
			i 18 lit + dip dintt
		loop
		4 lit 0 lit do                                                  \ w' = invNTT(A z - c t1 2^d)
			i 24 lit + dip dizero
			4 lit 0 lit do  j 4 lit * i + dip  i 28 lit + dip  j 24 lit + dip dimacc  loop
			2C lit dip  i 18 lit + dip  2D lit dip dipmul
			2D lit dip  i 24 lit + dip disubp
			i 24 lit + dip diintt
			100 lit 0 lit do  j 30 lit + dip i dic@  j 24 lit + dip i dic@ diuse  j 34 lit + dip i dic!  loop
		loop
		34 lit diw1e
		88 lit 1F lit kbeg  dimu 40 lit kabs  diw1 300 lit kabs  kend  dict 20 lit ksqz
		dict disig @ 20 lit mcmp 0= and
	then
;
