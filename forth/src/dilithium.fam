\ ──────────────────────────────────────────────────────────────────────────────
\ src/dilithium.fam — Dilithium2: ML-DSA-44 of FIPS 204 (called Dilithium
\ here): the signatures on the payment network's records.  q = 8380417,
\ n = 256, k = l = 4, eta = 2, tau = 39, gamma1 = 2^17, gamma2 = (q-1)/88,
\ omega = 80, d = 13; an empty context string.  Keys from a 32-byte seed;
\ signing from 32 bytes of randomness (hedged; the caller's, so it's
\ testable -- zeros for the deterministic variant).
\
\   dikeys ( xi pk sk -- )            pk: 1,312 bytes, sk: 2,560
\   disign ( sk m n rnd sig -- )      sig: 2,420 bytes
\   diverify ( pk m n sig -- ok )
\ Polynomials are 256 cells, coefficients in [0, q): -x is q - x.
\ ──────────────────────────────────────────────────────────────────────────────

: diq ( -- q )   7FE001 lit ;

\ dimul ( a b -- a b mod q ): src/dimul.S, assembled by tools/s2words.py.
: dimul ( a b -- c )
83250100 ,   \ lw a1,0(sp)
03254100 ,   \ lw a0,4(sp)
13014100 ,   \ addi sp,sp,4
13060000 ,   \ addi a2,zero,0
93060000 ,   \ addi a3,zero,0
93070500 ,   \ addi a5,a0,0
13070000 ,   \ addi a4,zero,0
638A0502 ,   \ beq a1,zero,50 <red>
93F21500 ,   \ andi t0,a1,1
638A0200 ,   \ beq t0,zero,38 <red-0x18>
3306F600 ,   \ add a2,a2,a5
B332F600 ,   \ sltu t0,a2,a5
B386E600 ,   \ add a3,a3,a4
B3865600 ,   \ add a3,a3,t0
13171700 ,   \ slli a4,a4,0x1
93D2F701 ,   \ srli t0,a5,0x1f
33675700 ,   \ or a4,a4,t0
93971700 ,   \ slli a5,a5,0x1
93D51500 ,   \ srli a1,a1,0x1
E39A05FC ,   \ bne a1,zero,20 <red-0x30>
93527601 ,   \ srli t0,a2,0x17
13939600 ,   \ slli t1,a3,0x9
B3E26200 ,   \ or t0,t0,t1
37038000 ,   \ lui t1,0x800
1303F3FF ,   \ addi t1,t1,-1 # 7fffff <__global_pointer$+0x7fe73b>
B3736600 ,   \ and t2,a2,t1
13DEA200 ,   \ srli t3,t0,0xa
93FEF23F ,   \ andi t4,t0,1023
131FDE00 ,   \ slli t5,t3,0xd
B383E301 ,   \ add t2,t2,t5
139FDE00 ,   \ slli t5,t4,0xd
B383E301 ,   \ add t2,t2,t5
B383C341 ,   \ sub t2,t2,t3
B3835340 ,   \ sub t2,t2,t0
37CFFF00 ,   \ lui t5,0xffc
130F2F00 ,   \ addi t5,t5,2 # ffc002 <__global_pointer$+0xffa73e>
B383E301 ,   \ add t2,t2,t5
13DE7301 ,   \ srli t3,t2,0x17
B3F36300 ,   \ and t2,t2,t1
931EDE00 ,   \ slli t4,t3,0xd
B383D301 ,   \ add t2,t2,t4
B383C341 ,   \ sub t2,t2,t3
37EF7F00 ,   \ lui t5,0x7fe
130F1F00 ,   \ addi t5,t5,1 # 7fe001 <__global_pointer$+0x7fc73d>
63E4E301 ,   \ bltu t2,t5,b8 <red+0x68>
B383E341 ,   \ sub t2,t2,t5
63E4E301 ,   \ bltu t2,t5,c0 <red+0x70>
B383E341 ,   \ sub t2,t2,t5
23207100 ,   \ sw t2,0(sp)
;
: diadd ( a b -- c )   + dup diq u< 0= if diq - then ;
: disub ( a b -- c )   - diq + dup diq u< 0= if diq - then ;
\ dimodq ( n -- c )   a small signed integer (|n| < q) mod q.
: dimodq ( n -- c )   dup 0< if diq + then ;
\ dicen ( c -- n )   c as a signed integer, in -(q-1)/2 .. (q-1)/2.
: dicen ( c -- n )   dup 3FF000 lit u> if diq - then ;
: diabs ( n -- u )   dup 0< if 0 lit swap - then ;

\ zeta^brv8(i) mod q (zeta = 1753): the NTT's twiddles, made once.
