\ ──────────────────────────────────────────────────────────────────────────────
\ src/consensus.fam — the relay list (docs/RELAYS.md): a relay's key and
\ line, the consensus.txt that lists them, and the aux tree a block's
\ aux_hash roots.
\
\ A relay's key is its onion key, Kyber's (d, z) = SHAKE256(
\ "tabernacle-relay-kyber-v1" ‖ seed ‖ n, 64), n the relaykey= setting (a
\ u32, big-endian; 0): from the wallet's seed, as the payment address's
\ keys are, so the backup words bring it back; a new n, a new key.  Its
\ relay id is SHA3-256 of the public key.
\
\ consensus.txt: the line "tabernacle-consensus 2 main" ("dev" on dev),
\ then a line "relay A.B.C.D:PORT ID" for each relay -- where it's reached
\ and its id in lower-case hex -- sorted by id, numbers without leading
\ zeros, every line ending in a newline.  Anything else (a bad line, an
\ id twice, out of order, more than cnmax) and it's not valid.  Nothing
\ expires: a line changes when its relay's address or key does.  The keys
\ themselves come from the relays, through peers (src/rlist.fam: GET_RKEY),
\ each checked against its id.
\
\ The aux tree: a node's bytes are 0x01 ‖ left ‖ right, a leaf's 0x00 ‖
\ its content; each hash is SHA-256 of those bytes.  The root's left child
\ is the leaf of the consensus.txt the block backs (zeros: none).
\
\   cnkeys ( -- )               our key: cnek, cndk, its id cnmid
\   cnonion ( g ek dk -- )      the key for n = g
\   cnfmt ( ip port id -- a n )  a consensus.txt line (its newline too)
\   cnparse ( a n -- ok )       a consensus.txt: then cnn relays, the k-th
\                               at cnent k (0 ip, 4 port, 8 its key's
\                               known), its id at cnids k, key at cnkey k
\   cnleaf ( a n out -- )       a leaf's hash
\   cnnode ( l r out -- )       a node's hash
\ ──────────────────────────────────────────────────────────────────────────────

: cnmax ( -- n )   40 lit ;                               \ relays a file may hold

\ ── Our key ──

: cnekv variable ;  : cnek ( -- a )  cnekv 320 lit lazy ;   \ Kyber's public key
: cndkv variable ;  : cndk ( -- a )  cndkv 660 lit lazy ;   \ its secret key
: cnmiv variable ;  : cnmid ( -- a )  cnmiv 20 lit lazy ;   \ our relay id
: cnok variable ;   \ made
: cnkn variable ;   \ the relaykey= setting
: cnmaddr variable ;   \ the relayaddr= setting: our public IP

\ cnonion ( g ek dk -- )
: cngv variable ;  : cng ( -- a )  cngv 4 lit lazy ;
: cnonion ( g ek dk -- )
	rot cng be!
	88 lit 1F lit kbeg  "tabernacle-relay-kyber-v1" 19 lit kabs  wlseed 20 lit kabs  cng 4 lit kabs  kend  pab 40 lit ksqz
	pab -rot kykeys
;

: cnkeys ( -- )
	cnok @ 0= if cnkn @ cnek cndk cnonion  cnek 320 lit cnmid sha3256  -1 lit cnok ! then
;

\ ── A line ──

: cnfv variable ;  : cnfb ( -- a )  cnfv 80 lit lazy ;  : cnfn variable ;
: cnfc ( c -- )   cnfb cnfn @ + c!  cnfn @ 1 lit + cnfn ! ;
: cnfd ( n -- )   dup A lit u< if 30 lit + cnfc else dup A lit / cnfd A lit % 30 lit + cnfc then ;
: cnfx ( n -- )   F lit and dup A lit u< if 30 lit + else 57 lit + then cnfc ;

\ cnfmt ( ip port id -- a n )
: cnfmt ( ip port id -- a n )
	0 lit cnfn !  "relay " dup strlen 0 lit do dup i + c@ cnfc loop drop
	rot 4 lit 0 lit do dup 18 lit i 3 lit lshift - rshift FF lit and cnfd  i 3 lit u< if 2E lit cnfc then loop drop
	swap 3A lit cnfc cnfd  20 lit cnfc
	20 lit 0 lit do dup i + c@ dup 4 lit rshift cnfx cnfx loop drop
	A lit cnfc  cnfb cnfn @
;

\ ── consensus.txt ──

: cnlv variable ;  : cnent ( k -- a )  5 lit lshift cnlv cnmax 5 lit lshift lazy + ;
: cniv variable ;  : cnids ( k -- a )  5 lit lshift cniv cnmax 5 lit lshift lazy + ;
: cnkv variable ;  : cnkey ( k -- a )  320 lit * cnkv cnmax 320 lit * lazy + ;
: cnn variable ;
: cnhas? ( k -- f )   cnent 8 lit + @ ;

: cnhead ( -- s )   bnet @ if "tabernacle-consensus 2 dev\n" else "tabernacle-consensus 2 main\n" then ;

\ cnhv ( c -- v | -1 )   a hex digit's value (lower case).
: cnhv ( c -- v | -1 )
	dup 30 lit - A lit u< if 30 lit - else
	dup 61 lit - 6 lit u< if 57 lit - else drop -1 lit then then
;

\ cnunhex ( a out n -- ok )   2n hex digits at a as n bytes at out.
: cnhok variable ;
: cnunhex ( a out n -- ok )
	-1 lit cnhok !
	0 lit do
		over i 1 lit lshift + dup c@ cnhv swap 1 lit + c@ cnhv
		2dup or 0< if 2drop 0 lit cnhok ! else swap 4 lit lshift or over i + c! then
	loop 2drop cnhok @
;

\ cnparse ( a n -- ok )
: cnpa variable ;  : cnpe variable ;  : cnpok variable ;
: cnpc ( -- c )   cnpa @ cnpe @ u< if cnpa @ c@ else 0 lit then ;
\ cnpnum ( max c -- n )   a decimal number below max, no leading zero,
\        then the character c (else not valid).
: cnpv variable ;  : cnpd variable ;
: cnpnum ( max c -- n )
	0 lit cnpv !  0 lit cnpd !
	begin cnpc 30 lit - A lit u< cnpd @ 6 lit u< and while
		cnpv @ A lit * cnpc 30 lit - + cnpv !  cnpd @ 1 lit + cnpd !  cnpa @ 1 lit + cnpa !
	repeat
	cnpc = 0= if 0 lit cnpok ! then  cnpa @ 1 lit + cnpa !
	cnpd @ 0= if 0 lit cnpok ! then
	cnpd @ 1 lit u> if cnpa @ cnpd @ - 1 lit - c@ 30 lit = if 0 lit cnpok ! then then
	cnpv @ swap u< 0= if 0 lit cnpok ! then  cnpv @
;
: cnpline ( -- )
	cnpe @ cnpa @ - 6 lit u< 0= if cnpa @ "relay " 6 lit mcmp 0= else 0 lit then
	cnn @ cnmax u< and if
		cnpa @ 6 lit + cnpa !
		cnn @ cnent dup 20 lit nzero
		0 lit  3 lit 0 lit do 100 lit 2E lit cnpnum swap 8 lit lshift or loop  100 lit 3A lit cnpnum swap 8 lit lshift or
		dup 0= if 0 lit cnpok ! then  over !
		10000 lit 20 lit cnpnum  dup 0= if 0 lit cnpok ! then  swap 4 lit + !
		cnpe @ cnpa @ - 41 lit u< 0= if
			cnpa @ cnn @ cnids 20 lit cnunhex  cnpa @ 40 lit + c@ A lit = and 0= if 0 lit cnpok ! then
			cnpa @ 41 lit + cnpa !
		else 0 lit cnpok ! then
		cnn @ if cnn @ 1 lit - cnids cnn @ cnids 20 lit mcmp 0< 0= if 0 lit cnpok ! then then   \ in order
		cnn @ 1 lit + cnn !
	else 0 lit cnpok ! then
;
: cnparse ( a n -- ok )
	over + cnpe !  cnpa !  0 lit cnn !
	cnhead strlen  cnpe @ cnpa @ - over u< 0=  if
		cnpa @ cnhead 2 lit pick mcmp 0= cnpok !  cnpa @ + cnpa !
	else drop 0 lit cnpok ! then
	begin cnpok @ cnpa @ cnpe @ u< and while cnpline repeat
	cnpok @ 0= if 0 lit cnn ! then
	cnpok @
;

\ ── The aux tree ──

: cnbv variable ;  : cnb ( -- a )  cnbv 4 lit lazy ;
: cnout variable ;  : cnl variable ;  : cnr variable ;

\ cnleaf ( a n out -- )
: cnleaf ( a n out -- )   cnout !  shinit  0 lit cnb c!  cnb 1 lit shupd  shupd  cnout @ shfin ;

\ cnnode ( l r out -- )
: cnnode ( l r out -- )
	cnout ! cnr ! cnl !
	shinit  1 lit cnb c!  cnb 1 lit shupd  cnl @ 20 lit shupd  cnr @ 20 lit shupd  cnout @ shfin
;
