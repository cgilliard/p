	# If s5 == 0 (no seeds parsed), skip the mod loop entirely — `bltu
	# t2, 0` is always false, so the unguarded loop never terminates.
	# RND_START stays whatever it was zeroed to, but reprobe_entry's
	# all-failed check (`bge NF_CNT, s5` with NF_CNT=0, s5=0) halts
	# immediately so we never read it.
# 	beqz    s5, 2f
63 8A 0A 00	# beqz s5,8000057c <rx_desc_done+0x8c>
# 	andi    t2, t1, 0x1F                    # mtime low 5 bits
93 73 F3 01	# andi t2,t1,31
# 1:	bltu    t2, s5, 2f
63 E6 53 01	# bltu t2,s5,8000057c <rx_desc_done+0x8c>
# 	sub     t2, t2, s5
B3 83 53 41	# sub t2,t2,s5
# 	j       1b
6F F0 9F FF	# j 80000570 <rx_desc_done+0x80>
# 2:	li      t0, RND_START
B7 A2 00 00	# lui t0,0xa
93 82 C2 FD	# addi t0,t0,-36 # 9fdc <RND_START>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sb      t2, 0(t0)
23 80 72 00	# sb t2,0(t0)

# reprobe_entry:
	# All-failed check: if every seed is blacklisted, halt 'N'.
# 	li      t0, NF_CNT
B7 A2 00 00	# lui t0,0xa
93 82 22 FF	# addi t0,t0,-14 # 9ff2 <NF_CNT>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lhu     t1, 0(t0)
03 D3 02 00	# lhu t1,0(t0)
# 	bge     t1, s5, halt_no_net
63 54 53 6D	# bge t1,s5,80000c64 <halt_no_net>
	# Reset per-attempt state: locked_idx, received count, bitmap.
# 	li      s6, 0xFF
13 0B F0 0F	# li s6,255
# 	li      s1, 0
93 04 00 00	# li s1,0
# 	lw      s2, -40(gp)
03 A9 81 FD	# lw s2,-40(gp) # 80002b64 <__BSS_END__+0x7d8>
	# Zero the bitmap (NB_BMAP_BYTES = 1024 → 256 words).
# 	li      t0, NB_BMAP
B7 A2 00 00	# lui t0,0xa
93 82 02 08	# addi t0,t0,128 # a080 <NB_BMAP>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	li      t1, NB_BMAP_BYTES / 4
13 03 00 10	# li t1,256
# 1:	sw      zero, 0(t0)
23 A0 02 00	# sw zero,0(t0)
# 	addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
# 	addi    t1, t1, -1
13 03 F3 FF	# addi t1,t1,-1 # fff <PAGE_MASK>
# 	bnez    t1, 1b
E3 1A 03 FE	# bnez t1,800005bc <reprobe_entry+0x30>
