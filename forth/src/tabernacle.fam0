03 C3 52 00	# lbu t1,5(t0)
83 43 E6 02	# lbu t2,46(a2)
63 10 73 02	# bne t1,t2,8000081c <sm_mismatch>
# 	lbu     t1, 4(t0); lbu t2, 47(a2); bne t1, t2, sm_mismatch
03 C3 42 00	# lbu t1,4(t0)
83 43 F6 02	# lbu t2,47(a2)
63 1A 73 00	# bne t1,t2,8000081c <sm_mismatch>
