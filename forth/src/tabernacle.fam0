# 	addi    t0, a2, 60
93 02 C6 03	# addi t0,a2,60
# 	addi    t1, gp, -32                     # our hash
13 83 01 FE	# addi t1,gp,-32 # 800030f0 <__BSS_END__+0x7e0>
# 	li      t2, 32
93 03 00 02	# li t2,32
# 1:	lbu     t3, 0(t0)
03 CE 02 00	# lbu t3,0(t0)
# 	lbu     t4, 0(t1)
83 4E 03 00	# lbu t4,0(t1)
