# ──────────────────────────────────────────────────────────────────────────────
# src/tabernacle.S — sealed bootstrap loader for famchain.
#
# Built via:
#     python3 tools/s2fam0_tabernacle.py src/tabernacle.S src/tabernacle.fam0
#     run bin/tabernacle.uncompressed bin/fam0 src/tabernacle.fam0
# (src/tabernacle.fam0 is checked in; scripts/build.sh runs only the second
#  step — rerun the generator after editing this file.)
#
# Boot ABI (we set up our own gp via auto-prologue below):
#     PC = 0x80000000     entry of this binary
#     gp = end_marker     byte just past tabernacle.bin
#                         (full_node.bin is concatenated after, so
#                          gp = full_node base; gp-40 = config [nchunks,bin_size,hash].)
#
# Calling convention — NO JALR.  Subroutines are reached via direct `j`
# with a per-call-site dispatch tag.  Mirrors the CALL/BST macros in
# src/fam.S; pinned registers:
#     s11 = current return ID (set by CALL)
#     s10 = RID-stack ptr     (decreases on push)
#     s9  = RID-stack bottom  (bounds check)
#     s7  = full_node base    (page-aligned, persists for handoff)
# Callee saves nothing on RID stack itself; CALL pushes/pops s11.
# ──────────────────────────────────────────────────────────────────────────────

# 	.text
# 	.globl _start

# ── Constants ─────────────────────────────────────────────────────────────
# 	.equ UART_BASE,         0x10000000
# 	.equ UART_LSR,                 0x5
# 	.equ UART_RX_READY,            0x1
# 	.equ SHUTDOWN_ADDR,       0x100000
# 	.equ SHUTDOWN_PASS,         0x5555
# 	.equ SHUTDOWN_FAIL,        0x13333

# 	.equ STACK_SIZE,         0x100000      # 1 MiB data stack
# 	.equ RID_BASE_OFF,       0x100000      # RID stack lives just above sp top
# 	.equ RID_SIZE,             0x1000      # 256 frames × 16 B header (overkill)
# 	.equ PAGE_SIZE,             0x1000
# 	.equ NEG_PAGE_SIZE,     0xFFFFF000
# 	.equ PAGE_MASK,              0xFFF

	# BIN_SIZE and NCHUNKS are data words at gp-36 and gp-40,
	# patched by scripts/build.sh after compiling tabernacle.fam0.

# 	.equ SEED_LIST_OFFSET,      0xA000
# 	.equ TIMETIK,               0x9FFC
# 	.equ BPSAVE,                0x9FF8
# 	.equ WD_TICK,               0x9FE0      # watchdog: last-progress mtime (4 B)
# 	.equ DBGFLAG,               0x9FD8      # debug flag (4 B): 0=quiet, 1=verbose
# 	.equ NETFLAG,               0x9FCC      # network (4 B): 0 = main, 1 = dev
# 	.equ MAX_SEEDS,                 16
# 	.equ DEFAULT_TIMEOUT_TK, 0x05F5E100
# 	.equ MTIME_ADDR,         0x200BFF8      # CLINT mtime (RV virt machine)
# 	.equ MT_KHZ,                 10000      # mtime frequency in kHz (10 MHz)
	# NB_BMAP — chunk-received bitmap.  ceil(NCHUNKS / 8) bytes.
	# At 8 KB max NCHUNKS supported (= 64K bits).
# 	.equ NB_BMAP,               0xA080
# 	.equ NB_BMAP_BYTES,           1024


# ── Static-dispatch macros (no JALR), lifted from src/fam.S ───────────────
# 	.altmacro
# 	.set _CSN, 0

# .macro CALL target
# 	.set _CSN, _CSN + 1
# 	addi    s10, s10, -4
# 	bgeu    s10, s9, .L_call_ok_\@
# 	j       panic
# .L_call_ok_\@:
# 	sw      s11, 0(s10)
# 	li      s11, _CSN
# 	j       \target
# 	EMIT_LABEL %_CSN
# 	lw      s11, 0(s10)
# 	addi    s10, s10, 4
# .endm

# .macro EMIT_LABEL n
# .L_csret_\n:
# .endm

# .macro BST lo, hi
# 	BST_R %\lo, %\hi
# .endm
# .macro BST_R lo, hi
# 	.if \hi == \lo
# .L_bst_\lo\()_\hi:
# 		j .L_csret_\lo
# 	.else
# 		.set _BST_MID, (\lo + \hi) / 2
# 		BST_NODE %\lo, %\hi, %_BST_MID, %(_BST_MID - 1), %(_BST_MID + 1)
# 	.endif
# .endm
# .macro BST_NODE lo, hi, mid, lhi, rlo
# .L_bst_\lo\()_\hi:
# 	li      t0, \mid
# 	.if \lhi >= \lo
# 		bge s11, t0, .L_bst_\lo\()_\hi\()_R
# 		j   .L_bst_\lo\()_\lhi
# .L_bst_\lo\()_\hi\()_R:
# 	.endif
# 	.if \rlo <= \hi
# 		ble s11, t0, .L_bst_\lo\()_\hi\()_E
# 		j   .L_bst_\rlo\()_\hi
# .L_bst_\lo\()_\hi\()_E:
# 	.endif
# 	j       .L_csret_\mid
# 	.if \lhi >= \lo
# 		BST_R %\lo, %\lhi
# 	.endif
# 	.if \rlo <= \hi
# 		BST_R %\rlo, %\hi
# 	.endif
# .endm

# PC-relative load-address (avoids `la` which doesn't relax under -march=rv32i).
# .macro LOAD_ADDRESS reg, label
# _base\@:
# 	.equ _offset\@, (\label - _base\@)
# 	auipc   \reg, %pcrel_hi(\label)
# 	addi    \reg, \reg, %pcrel_lo(_base\@)
# .endm

# ──────────────────────────────────────────────────────────────────────────────
# _start
# ──────────────────────────────────────────────────────────────────────────────

# _start:
	# ── §0 Auto-prologue (NOP magic + gp = end_marker). ──────────────
# 	addi    zero, zero, 0
13 00 00 00	# nop
# 	LOAD_ADDRESS gp, end_marker
97 21 00 00	# auipc gp,0x2
93 81 C1 90	# addi gp,gp,-1780 # 80001910 <end_marker>

	# ── §1 Page-align s7, then carve sp / s10 / s9 above it. ─────────
	# s7 = full_node base (page-aligned).
	# sp     = s7 + STACK_SIZE              (data stack top, grows down)
	# s10    = s7 + STACK_SIZE + RID_SIZE   (RID stack top, grows down)
	# s9     = s7 + STACK_SIZE              (RID stack bottom — when s10
	#                                        reaches s9 we're full)
# 	mv      s7, gp
93 8B 01 00	# mv s7,gp
# 	lw      t0, -36(gp)
83 A2 C1 FD	# lw t0,-36(gp) # 800030ec <__BSS_END__+0x7dc>
# 	add     s7, s7, t0
B3 8B 5B 00	# add s7,s7,t0
# 	li      t0, PAGE_MASK
B7 12 00 00	# lui t0,0x1
93 82 F2 FF	# addi t0,t0,-1 # fff <PAGE_MASK>
# 	add     s7, s7, t0
B3 8B 5B 00	# add s7,s7,t0
# 	li      t0, NEG_PAGE_SIZE
B7 F2 FF FF	# lui t0,0xfffff
# 	and     s7, s7, t0
B3 FB 5B 00	# and s7,s7,t0

# 	li      t0, STACK_SIZE
B7 02 10 00	# lui t0,0x100
# 	add     sp, s7, t0
33 81 5B 00	# add sp,s7,t0
# 	mv      s9, sp                          # RID bottom = sp top
93 0C 01 00	# mv s9,sp
# 	li      t0, RID_SIZE
B7 12 00 00	# lui t0,0x1
# 	add     s10, s9, t0                     # RID top
33 8D 5C 00	# add s10,s9,t0
	# Per fam.S convention, s11 starts at 0 (no enclosing call frame).
# 	li      s11, 0
93 0D 00 00	# li s11,0

	# ── §2 Zero 0xB000 bytes at s7 (covers virtio queues + buffers + the
	#     control / seed-list / chunk-bitmap region around 0xA000). ──
# 	mv      t0, s7
93 82 0B 00	# mv t0,s7
# 	li      t1, 0x2C00                     # 0xB000 / 4 = 0x2C00 words
37 33 00 00	# lui t1,0x3
13 03 03 C0	# addi t1,t1,-1024 # 2c00 <MT_KHZ+0x4f0>
# zero_top:
# 	sw      zero, 0(t0)
23 A0 02 00	# sw zero,0(t0) # 1000 <PAGE_SIZE>
# 	addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
# 	addi    t1, t1, -1
13 03 F3 FF	# addi t1,t1,-1
# 	bne     t1, zero, zero_top
E3 1A 03 FE	# bnez t1,80000050 <zero_top>

	# UART base in s8 (callee-saved across CALL).
# 	lui     s8, %hi(UART_BASE)
37 0C 00 10	# lui s8,0x10000
# 	li      t3, 0                           # skip_phase2 flag
13 0E 00 00	# li t3,0


# ──────────────────────────────────────────────────────────────────────────────
# UART config parser — reads
#   "<bind_port> <debug> <timeout_ms> <network> <ip:port> ...\004"
# (network: 0 main, 1 dev; the ip:ports are the seeds).
# Storing parsed state at:
#   s4               = bind_port
#   s7 + DBGFLAG     = debug flag (0=quiet, 1=verbose)
#   s7 + TIMETIK     = timeout in MTIME ticks
#   s7 + NETFLAG     = network
#   s7 + BPSAVE      = bind_port (mirror)
#   s7 + SEED_LIST_OFFSET = [u8 count][N × 6 B (4 IP + 2 LE port)]
# ──────────────────────────────────────────────────────────────────────────────

# ── Phase 1: bind_port ────────────────────────────────────────────────────
# 	li      s6, 0
13 0B 00 00	# li s6,0
# ph1_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8) # 10000005 <UART_BASE+0x5>
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph1_top
E3 8C 02 FE	# beqz t0,8000006c <ph1_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, 1f
63 96 5F 00	# bne t6,t0,8000008c <ph1_top+0x20>
# 	li      t3, 1
13 0E 10 00	# li t3,1
# 	j       ph1_done
6F 00 40 02	# j 800000ac <ph1_done>
# 1:	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph1_done
63 FC 62 00	# bgeu t0,t1,800000ac <ph1_done>

# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph1_top
6F F0 5F FC	# j 8000006c <ph1_top>
# ph1_done:
# 	mv      s4, s6
13 0A 0B 00	# mv s4,s6

# ── Phase 1a: debug flag ─────────────────────────────────────────────────
# 	bnez    t3, ph1a_skip
63 14 0E 04	# bnez t3,800000f8 <ph1a_done>
# 	li      s6, 0
13 0B 00 00	# li s6,0
# ph1a_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8)
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph1a_top
E3 8C 02 FE	# beqz t0,800000b8 <ph1a_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, 1f
63 96 5F 00	# bne t6,t0,800000d8 <ph1a_top+0x20>
# 	li      t3, 1
13 0E 10 00	# li t3,1
# 	j       ph1a_done
6F 00 40 02	# j 800000f8 <ph1a_done>
# 1:	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph1a_done
63 FC 62 00	# bgeu t0,t1,800000f8 <ph1a_done>

# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph1a_top
6F F0 5F FC	# j 800000b8 <ph1a_top>
# ph1a_done:
# ph1a_skip:
# 	li      t0, DBGFLAG
B7 A2 00 00	# lui t0,0xa
93 82 82 FD	# addi t0,t0,-40 # 9fd8 <DBGFLAG>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      s6, 0(t0)
23 A0 62 01	# sw s6,0(t0)

# ── Phase 1b: timeout_ms ──────────────────────────────────────────────────
# 	bnez    t3, ph1b_skip
63 14 0E 04	# bnez t3,80000150 <ph1b_done>
# 	li      s6, 0
13 0B 00 00	# li s6,0
# ph1b_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8)
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph1b_top
E3 8C 02 FE	# beqz t0,80000110 <ph1b_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, 1f
63 96 5F 00	# bne t6,t0,80000130 <ph1b_top+0x20>
# 	li      t3, 1
13 0E 10 00	# li t3,1
# 	j       ph1b_done
6F 00 40 02	# j 80000150 <ph1b_done>
# 1:	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph1b_done
63 FC 62 00	# bgeu t0,t1,80000150 <ph1b_done>

# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph1b_top
6F F0 5F FC	# j 80000110 <ph1b_top>
# ph1b_done:
# ph1b_skip:


# ── Compute timeout in MTIME ticks → mem[s7 + TIMETIK] ───────────────────
# 	beqz    s6, timeout_default
63 02 0B 02	# beqz s6,80000174 <timeout_default>
# 	slli    t0, s6, 13
93 12 DB 00	# slli t0,s6,0xd
# 	slli    t1, s6, 11;  add t0, t0, t1
13 13 BB 00	# slli t1,s6,0xb
B3 82 62 00	# add t0,t0,t1
# 	slli    t1, s6, 8;   sub t0, t0, t1
13 13 8B 00	# slli t1,s6,0x8
B3 82 62 40	# sub t0,t0,t1
# 	slli    t1, s6, 4;   add t0, t0, t1
13 13 4B 00	# slli t1,s6,0x4
B3 82 62 00	# add t0,t0,t1
# 	j       timeout_store
6F 00 C0 00	# j 8000017c <timeout_store>
# timeout_default:
# 	li      t0, DEFAULT_TIMEOUT_TK
B7 E2 F5 05	# lui t0,0x5f5e
93 82 02 10	# addi t0,t0,256 # 5f5e100 <DEFAULT_TIMEOUT_TK>
# timeout_store:
# 	li      t1, TIMETIK
37 A3 00 00	# lui t1,0xa
13 03 C3 FF	# addi t1,t1,-4 # 9ffc <TIMETIK>
# 	add     t1, s7, t1
33 83 6B 00	# add t1,s7,t1
# 	sw      t0, 0(t1)
23 20 53 00	# sw t0,0(t1)

# ── Phase 1c: network ─────────────────────────────────────────────────────
# 	li      s6, 0
13 0B 00 00	# li s6,0
# 	bnez    t3, ph1c_skip
63 12 0E 04	# bnez t3,800001d4 <ph1c_skip>
# ph1c_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8)
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph1c_top
E3 8C 02 FE	# beqz t0,80000194 <ph1c_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, 1f
63 96 5F 00	# bne t6,t0,800001b4 <ph1c_top+0x20>
# 	li      t3, 1
13 0E 10 00	# li t3,1
# 	j       ph1c_skip
6F 00 40 02	# j 800001d4 <ph1c_skip>
# 1:	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph1c_skip
63 FC 62 00	# bgeu t0,t1,800001d4 <ph1c_skip>

# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph1c_top
6F F0 5F FC	# j 80000194 <ph1c_top>
# ph1c_skip:
# 	li      t0, NETFLAG
B7 A2 00 00	# lui t0,0xa
93 82 C2 FC	# addi t0,t0,-52 # 9fcc <NETFLAG>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      s6, 0(t0)
23 A0 62 01	# sw s6,0(t0)


# ── Phase 2: seed list ────────────────────────────────────────────────────
# 	li      s5, 0                           # seed count
93 0A 00 00	# li s5,0
# 	bnez    t3, ph2_skip
63 16 0E 0C	# bnez t3,800002b4 <ph2_done>

# 	li      t2, SEED_LIST_OFFSET
B7 A3 00 00	# lui t2,0xa
# 	add     t2, s7, t2
B3 83 7B 00	# add t2,s7,t2
# 	addi    t2, t2, 1                       # entries base (skip count byte)
93 83 13 00	# addi t2,t2,1 # a001 <SEED_LIST_OFFSET+0x1>
# 	li      s6, 0                           # accumulator
13 0B 00 00	# li s6,0
# 	li      t3, 0                           # field 0..3 = octets, 4 = port
13 0E 00 00	# li t3,0

# ph2_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8)
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph2_top
E3 8C 02 FE	# beqz t0,80000200 <ph2_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, ph2_not_eot
63 90 5F 02	# bne t6,t0,80000234 <ph2_not_eot>
# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t3, t0, ph2_done
63 1C 5E 08	# bne t3,t0,800002b4 <ph2_done>
# 	li      t0, MAX_SEEDS
93 02 00 01	# li t0,16
# 	bge     s5, t0, ph2_done
63 D8 5A 08	# bge s5,t0,800002b4 <ph2_done>
# 	sh      s6, 4(t2)
23 92 63 01	# sh s6,4(t2)
# 	addi    s5, s5, 1
93 8A 1A 00	# addi s5,s5,1
# 	j       ph2_done
6F 00 40 08	# j 800002b4 <ph2_done>

# ph2_not_eot:
# 	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph2_sep
63 FC 62 00	# bgeu t0,t1,80000254 <ph2_sep>
# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph2_top
6F F0 1F FB	# j 80000200 <ph2_top>

# ph2_sep:
# 	li      t0, '.'
93 02 E0 02	# li t0,46
# 	bne     t6, t0, ph2_not_dot
63 98 5F 00	# bne t6,t0,80000268 <ph2_not_dot>
# 	li      t0, 3
93 02 30 00	# li t0,3
# 	bge     t3, t0, ph2_top
E3 50 5E FA	# bge t3,t0,80000200 <ph2_top>
# 	j       ph2_store_advance
6F 00 40 01	# j 80000278 <ph2_store_advance>
# ph2_not_dot:
# 	li      t0, ':'
93 02 A0 03	# li t0,58
# 	bne     t6, t0, ph2_space
63 90 5F 02	# bne t6,t0,8000028c <ph2_space>
# 	li      t0, 3
93 02 30 00	# li t0,3
# 	bne     t3, t0, ph2_top
E3 16 5E F8	# bne t3,t0,80000200 <ph2_top>
# ph2_store_advance:
# 	add     t4, t2, t3
B3 8E C3 01	# add t4,t2,t3
# 	sb      s6, 0(t4)
23 80 6E 01	# sb s6,0(t4)
# 	addi    t3, t3, 1
13 0E 1E 00	# addi t3,t3,1
# 	li      s6, 0
13 0B 00 00	# li s6,0
# 	j       ph2_top
6F F0 9F F7	# j 80000200 <ph2_top>
# ph2_space:
# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t3, t0, ph2_reset
63 1C 5E 00	# bne t3,t0,800002a8 <ph2_reset>
# 	li      t0, MAX_SEEDS
93 02 00 01	# li t0,16
# 	bge     s5, t0, ph2_reset
63 D8 5A 00	# bge s5,t0,800002a8 <ph2_reset>
# 	sh      s6, 4(t2)
23 92 63 01	# sh s6,4(t2)
# 	addi    s5, s5, 1
93 8A 1A 00	# addi s5,s5,1
# 	addi    t2, t2, 6
93 83 63 00	# addi t2,t2,6
# ph2_reset:
# 	li      s6, 0
13 0B 00 00	# li s6,0
# 	li      t3, 0
13 0E 00 00	# li t3,0
# 	j       ph2_top
6F F0 1F F5	# j 80000200 <ph2_top>

# ph2_done:
# ph2_skip:

# 	li      t0, SEED_LIST_OFFSET
B7 A2 00 00	# lui t0,0xa
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sb      s5, 0(t0)
23 80 52 01	# sb s5,0(t0) # a000 <SEED_LIST_OFFSET>
# 	li      t0, BPSAVE
B7 A2 00 00	# lui t0,0xa
93 82 82 FF	# addi t0,t0,-8 # 9ff8 <BPSAVE>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      s4, 0(t0)
23 A0 42 01	# sw s4,0(t0)


# ──────────────────────────────────────────────────────────────────────────────
# §3 Disk boot:
#     scan_disk → init virtio-blk → read full_node into [s7..s7+BIN_SIZE)
#     → gimli_hash → compare to hash_data → handoff.
# A missing block device or a read error halts (halt_no_disk); a successful
# read whose hash does not match falls through to §5 net boot.
# ──────────────────────────────────────────────────────────────────────────────

# 	CALL    scan_disk                       # → s3 = disk MMIO base, or fall to halt_d
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,800002dc <ph2_done+0x28>
6F 00 D0 35	# j 80000e34 <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 10 00	# li s11,1
6F 00 50 38	# j 80000e68 <scan_disk>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4

	# ── Virtio-blk handshake (legacy MMIO) ──
# 	sw      zero, 0x70(s3)                  # status = 0
23 A8 09 06	# sw zero,112(s3)
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sw      t1, 0x70(s3)                    # status = 1 (ACKNOWLEDGE)
23 A8 69 06	# sw t1,112(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 2
13 63 23 00	# ori t1,t1,2
# 	sw      t1, 0x70(s3)                    # status |= 2 (DRIVER)
23 A8 69 06	# sw t1,112(s3)
# 	sw      zero, 0x20(s3)                  # driver_features = 0
23 A0 09 02	# sw zero,32(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 8
13 63 83 00	# ori t1,t1,8
# 	sw      t1, 0x70(s3)                    # status |= 8 (FEATURES_OK)
23 A8 69 06	# sw t1,112(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	andi    t2, t1, 8
93 73 83 00	# andi t2,t1,8
# 	beqz    t2, halt_no_disk                # FEATURES_OK didn't stick
E3 8A 03 30	# beqz t2,80000e34 <halt_no_disk>

# 	li      t1, PAGE_SIZE
37 13 00 00	# lui t1,0x1
# 	sw      t1, 0x28(s3)                    # V_GPS = 0x1000
23 A4 69 02	# sw t1,40(s3)
# 	sw      zero, 0x30(s3)                  # V_QSEL = 0
23 A8 09 02	# sw zero,48(s3)
# 	sw      t1, 0x3C(s3)                    # V_QALGN = 0x1000
23 AE 69 02	# sw t1,60(s3)
# 	li      t1, 16
13 03 00 01	# li t1,16
# 	sw      t1, 0x38(s3)                    # V_QNUM = 16
23 AC 69 02	# sw t1,56(s3)
# 	srli    t1, s7, 12
13 D3 CB 00	# srli t1,s7,0xc
# 	sw      t1, 0x40(s3)                    # V_QPFN = s7 >> 12
23 A0 69 04	# sw t1,64(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 4
13 63 43 00	# ori t1,t1,4
# 	sw      t1, 0x70(s3)                    # status |= 4 (DRIVER_OK)
23 A8 69 06	# sw t1,112(s3)


# ── Read loop: load BIN_SIZE bytes from disk into [gp..gp+BIN_SIZE). ─────
# gp = full_node base (where the bin gets loaded); s7 = queue/stack base
# (post-full_node, page-aligned).  We mustn't write disk data into s7's
# region or we'd clobber descriptors / status / stack.
# 	mv      s0, gp                          # dest walker = full_node base
13 84 01 00	# mv s0,gp
# 	lw      t0, -36(gp)
83 A2 C1 FD	# lw t0,-36(gp) # 800030ec <__BSS_END__+0x7dc>
# 	mv      s1, t0                          # bytes remaining
93 84 02 00	# mv s1,t0
# 	li      s2, 0                           # sector counter
13 09 00 00	# li s2,0
# 	li      s6, 0                           # avail idx (was s7 in old; conflict)
13 0B 00 00	# li s6,0

# read_loop_top:
# 	beqz    s1, read_done
63 8E 04 06	# beqz s1,800003e0 <read_done>

	# chunk = min(remaining, DSK_CHK), rounded up to sector (512 B).
# 	li      t0, 0x10000                     # DSK_CHK = 64 KiB
B7 02 01 00	# lui t0,0x10
# 	mv      a3, t0
93 86 02 00	# mv a3,t0
# 	bge     s1, t0, 1f
63 D8 54 00	# bge s1,t0,80000380 <read_loop_top+0x1c>
# 	addi    a3, s1, 0x1FF                   # round up to 512
93 86 F4 1F	# addi a3,s1,511
# 	li      t0, 0xFFFFFE00                  # NEG_SECT
93 02 00 E0	# li t0,-512
# 	and     a3, a3, t0
B3 F6 56 00	# and a3,a3,t0
# 1:
# 	mv      a0, s2                          # sector
13 05 09 00	# mv a0,s2
# 	addi    s6, s6, 1
13 0B 1B 00	# addi s6,s6,1
# 	mv      a1, s6                          # avail idx
93 05 0B 00	# mv a1,s6
# 	mv      a2, s0                          # dest
13 06 04 00	# mv a2,s0

	# disk_read clobbers a3; save chunk on stack.
# 	addi    sp, sp, -4
13 01 C1 FF	# addi sp,sp,-4
# 	sw      a3, 0(sp)
23 20 D1 00	# sw a3,0(sp)
# 	CALL    disk_read
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,800003a4 <read_loop_top+0x40>
6F 00 50 29	# j 80000e34 <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 20 00	# li s11,2
6F 00 D0 2E	# j 80000e98 <disk_read>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4
# 	lw      t0, 0(sp)
83 22 01 00	# lw t0,0(sp)
# 	addi    sp, sp, 4
13 01 41 00	# addi sp,sp,4

	# disk_read returns a0 = status byte (0 = success).
# 	bnez    a0, halt_no_disk
E3 1A 05 26	# bnez a0,80000e34 <halt_no_disk>

# 	srli    t1, t0, 9                       # chunk / 512
13 D3 92 00	# srli t1,t0,0x9
# 	add     s2, s2, t1
33 09 69 00	# add s2,s2,t1

	# s0 += min(t0, s1); s1 -= min(t0, s1).
# 	bge     s1, t0, 1f
63 D4 54 00	# bge s1,t0,800003d4 <read_loop_top+0x70>
# 	mv      t0, s1
93 82 04 00	# mv t0,s1
# 1:	add     s0, s0, t0
33 04 54 00	# add s0,s0,t0
# 	sub     s1, s1, t0
B3 84 54 40	# sub s1,s1,t0
# 	j       read_loop_top
6F F0 9F F8	# j 80000364 <read_loop_top>

# read_done:

# ── Hash + check ─────────────────────────────────────────────────────────
	# Allocate 32-B scratch on stack for computed hash.
# 	addi    sp, sp, -32
13 01 01 FE	# addi sp,sp,-32
# 	mv      a2, sp                          # output buf
13 06 01 00	# mv a2,sp
# 	mv      a0, gp                          # data = full_node base
13 85 01 00	# mv a0,gp
# 	lw      a1, -36(gp)
83 A5 C1 FD	# lw a1,-36(gp) # 800030ec <__BSS_END__+0x7dc>
# 	CALL    gimli_hash
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,800003fc <read_done+0x1c>
6F 00 D0 23	# j 80000e34 <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 30 00	# li s11,3
6F 00 D0 44	# j 80001050 <gimli_hash>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4

	# Compare 32 bytes at sp vs hash_data (= gp − 32).
# 	mv      t0, sp
93 02 01 00	# mv t0,sp
# 	addi    t1, gp, -32
13 83 01 FE	# addi t1,gp,-32 # 800030f0 <__BSS_END__+0x7e0>
# 	li      t2, 8                           # 8 words
93 03 80 00	# li t2,8
# hash_cmp:
# 	lw      t3, 0(t0)
03 AE 02 00	# lw t3,0(t0) # 10000 <PEERS+0x5800>
# 	lw      t4, 0(t1)
83 2E 03 00	# lw t4,0(t1) # 1000 <PAGE_SIZE>
# 	bne     t3, t4, hash_mismatch
63 1E DE 03	# bne t3,t4,80000460 <hash_mismatch>
# 	addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
# 	addi    t1, t1, 4
13 03 43 00	# addi t1,t1,4
# 	addi    t2, t2, -1
93 83 F3 FF	# addi t2,t2,-1
# 	bnez    t2, hash_cmp
E3 94 03 FE	# bnez t2,8000041c <hash_cmp>

	# Match!  Free scratch, set handoff regs, jal over hash data to gp.
# 	addi    sp, sp, 32
13 01 01 02	# addi sp,sp,32

# 	li      t0, SEED_LIST_OFFSET
B7 A2 00 00	# lui t0,0xa
# 	add     a0, s7, t0                      # a0 = seed list ptr
33 85 5B 00	# add a0,s7,t0
# 	li      a1, 0                           # a1 = boot source (0 = disk)
93 05 00 00	# li a1,0
# 	mv      a2, s4                          # a2 = bind_port
13 06 0A 00	# mv a2,s4
# 	addi    t0, a0, DBGFLAG - SEED_LIST_OFFSET   # t0 = s7 + DBGFLAG (= a0 - 40)
93 02 85 FD	# addi t0,a0,-40
# 	lw      a3, 0(t0)                       # a3 = debug flag
83 A6 02 00	# lw a3,0(t0) # a000 <SEED_LIST_OFFSET>
# 	mv      a4, gp                          # a4 = full_node base address (handoff arg)
13 87 01 00	# mv a4,gp
# 	nop                                     # layout pad
13 00 00 00	# nop
# 	j       end_marker                      # gp = end_marker = full_node entry
6F 10 40 4B	# j 80001910 <end_marker>


# hash_mismatch:
# 	addi    sp, sp, 32
13 01 01 02	# addi sp,sp,32
# 	li      t6, 'H'
93 0F 80 04	# li t6,72
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
# 	li      t6, '\n'
93 0F A0 00	# li t6,10
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
	# Fall through to scan_net.


# ──────────────────────────────────────────────────────────────────────────────
# §5 Net boot.
#   scan_net → (or halt if no virtio-net) → handshake → RX/TX queue setup
#   → mark DRIVER_OK → kick RX → enter the REQ_RANGE seed-fetch loop
#   (probe → lock → batch-fetch via chunk bitmap → gimli_hash → handoff).
# Layout in s7's region:
#     s7 + 0x0000  RX queue 0 page (descriptors, avail, used)
#     s7 + 0x2000  16 × 1536 B RX buffers (= 0x6000 B)
#     s7 + 0x8000  TX queue 1 page
# ──────────────────────────────────────────────────────────────────────────────

# 	CALL    scan_net                        # → s3 = virtio-net MMIO base
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,80000480 <hash_mismatch+0x20>
6F 00 90 1B	# j 80000e34 <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 40 00	# li s11,4
6F 00 90 1E	# j 80000e70 <scan_net>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4

	# ── Reset used.idx after disk path. ────────────────────────────────
	# disk_read uses the same V_QPFN = s7 (legacy MMIO 1-page-per-queue
	# layout) as the net RX queue.  Each disk read bumps the device's
	# used.idx at s7+0x1002 and writes a status entry at s7+0x1004.
	# After the 48 disk reads needed to load a 3 MiB full_node.bin,
	# used.idx = 48; net rx_loop would then walk through 48 phantom
	# 1-byte "packets" pointing into zero-filled buffers, never see a
	# real BIN0 reply in time, and halt 'N'.  Just zero used.flags +
	# used.idx (4 B) — stale used.ring[] entries are harmless since the
	# device overwrites them as it processes new packets.  Don't touch
	# the FSM control region at s7+0x9FDA..0x9FFF (TIMETIK lives there)
	# nor the seed list at s7+0xA000.
# 	li      t0, 0x1000
B7 12 00 00	# lui t0,0x1
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      zero, 0(t0)                     # used.flags = used.idx = 0
23 A0 02 00	# sw zero,0(t0) # 1000 <PAGE_SIZE>

	# ── Virtio-net handshake (legacy MMIO) ─────────────────────────────
# 	sw      zero, 0x70(s3)                  # status = 0
23 A8 09 06	# sw zero,112(s3)
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sw      t1, 0x70(s3)                    # status = 1 (ACK)
23 A8 69 06	# sw t1,112(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 2
13 63 23 00	# ori t1,t1,2
# 	sw      t1, 0x70(s3)                    # status |= 2 (DRIVER)
23 A8 69 06	# sw t1,112(s3)
# 	li      t1, 0x8020                      # negotiate F_MAC | F_MRG_RXBUF
37 83 00 00	# lui t1,0x8
13 03 03 02	# addi t1,t1,32 # 8020 <SHUTDOWN_PASS+0x2acb>
# 	sw      t1, 0x20(s3)                    # V_DRVF
23 A0 69 02	# sw t1,32(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 8
13 63 83 00	# ori t1,t1,8
# 	sw      t1, 0x70(s3)                    # status |= 8 (FEATURES_OK)
23 A8 69 06	# sw t1,112(s3)
# 	li      t1, PAGE_SIZE
37 13 00 00	# lui t1,0x1
# 	sw      t1, 0x28(s3)                    # V_GPS = 0x1000
23 A4 69 02	# sw t1,40(s3)

	# ── RX queue (queue 0, 16 entries × 1536 B buffers) ───────────────
# 	sw      zero, 0x30(s3)                  # V_QSEL = 0
23 A8 09 02	# sw zero,48(s3)
# 	li      t1, 16
13 03 00 01	# li t1,16
# 	sw      t1, 0x38(s3)                    # V_QNUM = 16
23 AC 69 02	# sw t1,56(s3)
# 	li      t1, PAGE_SIZE
37 13 00 00	# lui t1,0x1
# 	sw      t1, 0x3C(s3)                    # V_QALGN
23 AE 69 02	# sw t1,60(s3)
# 	srli    t1, s7, 12
13 D3 CB 00	# srli t1,s7,0xc
# 	sw      t1, 0x40(s3)                    # V_QPFN = s7 >> 12 (RX queue at s7)
23 A0 69 04	# sw t1,64(s3)

	# Populate 16 RX descriptors.  desc base = s7; buffer base = s7+0x2000.
# 	mv      t0, s7                          # descriptor walker
93 82 0B 00	# mv t0,s7
# 	li      t6, 0x2000
B7 2F 00 00	# lui t6,0x2
# 	add     t2, s7, t6                      # buffer walker = s7 + 0x2000
B3 83 FB 01	# add t2,s7,t6
# 	li      t3, 0                           # i
13 0E 00 00	# li t3,0
# 	li      t5, 1536
13 0F 00 60	# li t5,1536
# rx_desc_top:
# 	li      t6, 16
93 0F 00 01	# li t6,16
# 	bge     t3, t6, rx_desc_done
63 5E FE 03	# bge t3,t6,80000548 <rx_desc_done>
# 	sw      t2, 0(t0)                       # desc[i].addr = buffer
23 A0 72 00	# sw t2,0(t0)
# 	sw      zero, 4(t0)                     # addr_hi = 0
23 A2 02 00	# sw zero,4(t0)
# 	sw      t5, 8(t0)                       # desc[i].len = 1536
23 A4 E2 01	# sw t5,8(t0)
# 	li      t6, 2
93 0F 20 00	# li t6,2
# 	sh      t6, 12(t0)                      # flags = WRITE
23 96 F2 01	# sh t6,12(t0)
# 	sh      zero, 14(t0)                    # next = 0
23 97 02 00	# sh zero,14(t0)
	# avail.ring[i] = i  (avail ring at s7 + 256+4)
# 	addi    t6, s7, 260                     # &avail.ring[0]
93 8F 4B 10	# addi t6,s7,260
# 	slli    t4, t3, 1                       # i*2
93 1E 1E 00	# slli t4,t3,0x1
# 	add     t4, t6, t4                      # &avail.ring[i]
B3 8E DF 01	# add t4,t6,t4
# 	sh      t3, 0(t4)
23 90 CE 01	# sh t3,0(t4)
	# advance
# 	addi    t0, t0, 16                      # next descriptor
93 82 02 01	# addi t0,t0,16
# 	add     t2, t2, t5                      # next buffer
B3 83 E3 01	# add t2,t2,t5
# 	addi    t3, t3, 1
13 0E 1E 00	# addi t3,t3,1
# 	j       rx_desc_top
6F F0 5F FC	# j 80000508 <rx_desc_top>
# rx_desc_done:
# 	li      t1, 16
13 03 00 01	# li t1,16
# 	addi    t6, s7, 258                     # avail.idx
93 8F 2B 10	# addi t6,s7,258
# 	sh      t1, 0(t6)
23 90 6F 00	# sh t1,0(t6) # 2000 <_offset0+0x6f4>

	# ── TX queue (queue 1, SIZE = 1) ──────────────────────────────────
	# V_QNUM = 1 forces every TX to drain before the next is posted.
	# With V_QNUM = 16, repeated tx_req_range calls let avail.idx run
	# 16+ entries ahead of used.idx whenever slirp couldn't deliver
	# responses (e.g., non-loopback IPs while ARP is pending), tripping
	# QEMU's "Guest moved used index" virtio violation and wedging the
	# device.  Hence V_QNUM = 1.
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sw      t1, 0x30(s3)                    # V_QSEL = 1
23 A8 69 02	# sw t1,48(s3)
# 	sw      t1, 0x38(s3)                    # V_QNUM = 1
23 AC 69 02	# sw t1,56(s3)
# 	li      t1, PAGE_SIZE
37 13 00 00	# lui t1,0x1
# 	sw      t1, 0x3C(s3)
23 AE 69 02	# sw t1,60(s3)
# 	li      t6, 0x8000
B7 8F 00 00	# lui t6,0x8
# 	add     t1, s7, t6
33 83 FB 01	# add t1,s7,t6
# 	srli    t1, t1, 12
13 53 C3 00	# srli t1,t1,0xc
# 	sw      t1, 0x40(s3)                    # V_QPFN = (s7+0x8000) >> 12
23 A0 69 04	# sw t1,64(s3)

	# ── Driver ready + kick RX ────────────────────────────────────────
# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 4
13 63 43 00	# ori t1,t1,4
# 	sw      t1, 0x70(s3)                    # status |= 4 (DRIVER_OK)
23 A8 69 06	# sw t1,112(s3)
# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow
# 	sw      zero, 0x50(s3)                  # notify queue 0 (RX)
23 A8 09 04	# sw zero,80(s3)


# ──────────────────────────────────────────────────────────────────────────────
# §6 Fetching the node from the network, in the node's own protocol
# (src/peer.fam, src/image.fam): magic "TBRN" ("TBRD" on dev), version 12,
# type, body; numbers big-endian.
#
#   GET_HOSTS (1)   nonce u64, max u16, zero padding  (the answer is at most
#                   3x the ask, so it's padded to 48 bytes for 16 hosts)
#   HOSTS (2)       nonce u64, cookie u64, count u16, count x (ip, port)
#   GET_BIN (15)    cookie u64, hash (32), first u32, count u16
#   BIN_CHUNK (16)  hash (32), index u32, up to 1024 bytes
#
# Discovery first: every host in the peer table is asked GET_HOSTS -- the
# seeds, then the hosts they name (127.x becomes 10.0.2.2, this machine under
# QEMU, as the node does for its seed), up to MAX_PEERS.  A HOSTS answer
# (with our nonce, from the host asked) makes it a peer and carries its
# cookie.  Then the image, in windows of WINDOW chunks: every tick, each peer
# that has sent chunks is asked for the next window still missing, and the
# rest are tried every eighth tick (Rust nodes, and nodes with another build,
# never answer).  The seeds are asked only once SEED_WAIT has passed with no
# other peer sending any -- the image comes from the network, not the seeds,
# whenever anyone else has it.  Chunks are taken only from peers, only for
# our hash, each once (the bitmap).  When all are in, the image is hashed:
# a match boots it; a mismatch drops every peer that sent chunks and starts
# over.  No progress for the timeout (discovery or chunks) halts 'N'.
#
# Peer table at s7 + PEERS, MAX_PEERS x 16 B:
#     +0 ip (4 B, network order)  +4 port (2 B, network order)
#     +6 state: 0 new, 1 asked for hosts, 2 a peer (cookie), 3 dropped
#     +7 flags: bit 0 seed, bit 1 sent chunks; bits 4..7 GET_HOSTS asks
#     +8 cookie (8 B, as received)
#
# Pinned registers:
#     s0 = consumed RX used.idx       s1 = chunks received
#     s2 = NCHUNKS                    s3 = virtio-net MMIO base
#     s4 = bind port                  s5 = seed count (parsed)
#     s7 = data region base           s8 = UART base
#     gp = full_node base (write target)
# Per packet: a2 = RX buffer, a1 = its bytes, a7 = its descriptor.
# ──────────────────────────────────────────────────────────────────────────────

# 	.equ PEERS,                 0xA800      # peer table
# 	.equ MAX_PEERS,                 32
# 	.equ NPEERS,                0x9FD0      # entries in the peer table (4 B)
# 	.equ NETMAGIC,              0x9FD4      # "TBRN" or "TBRD", as a LE word
# 	.equ CURSOR,                0x9FC8      # next chunk to ask for (4 B)
# 	.equ LASTTICK,              0x9FC4      # mtime of the last tick (4 B)
# 	.equ T_START,               0x9FC0      # mtime the fetch started (4 B)
# 	.equ HAVE_NS,               0x9FBC      # a non-seed peer has sent chunks (4 B)
# 	.equ TICKN,                 0x9FB8      # ticks so far (4 B)
# 	.equ NONCE,                 0x9FB0      # our GET_HOSTS nonce (8 B)
# 	.equ ADDRTMP,               0x9FA8      # a seed's address, as a host's (6 B)
# 	.equ TICK_TK,              2500000      # 250 ms a tick
# 	.equ SEED_WAIT_TK,        30000000      # 3 s before asking seeds for chunks
# 	.equ WINDOW,                    32      # chunks a GET_BIN
# 	.equ PKT,                   0x8236      # the TX payload (frame + 42)

# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sw      t1, 0x30(s3)                    # V_QSEL = 1 (TX)
23 A8 69 02	# sw t1,48(s3)
# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow

# 	li      t0, 0x1000
B7 12 00 00	# lui t0,0x1
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lhu     s0, 2(t0)                       # consumed = the device's used.idx
03 D4 22 00	# lhu s0,2(t0) # 1002 <PAGE_SIZE+0x2>
# 	li      s1, 0
93 04 00 00	# li s1,0
# 	lw      s2, -40(gp)                     # NCHUNKS
03 A9 81 FD	# lw s2,-40(gp) # 800030e8 <__BSS_END__+0x7d8>

	# Our magic: dev ("TBRD") or main ("TBRN").
# 	li      t0, NETFLAG
B7 A2 00 00	# lui t0,0xa
93 82 C2 FC	# addi t0,t0,-52 # 9fcc <NETFLAG>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
# 	li      t2, 0x4E524254                  # "TBRN"
B7 43 52 4E	# lui t2,0x4e524
93 83 43 25	# addi t2,t2,596 # 4e524254 <UART_BASE+0x3e524254>
# 	beqz    t1, 1f
63 06 03 00	# beqz t1,800005d4 <rx_desc_done+0x8c>
# 	li      t2, 0x44524254                  # "TBRD"
B7 43 52 44	# lui t2,0x44524
93 83 43 25	# addi t2,t2,596 # 44524254 <UART_BASE+0x34524254>
# 1:	li      t0, NETMAGIC
B7 A2 00 00	# lui t0,0xa
93 82 42 FD	# addi t0,t0,-44 # 9fd4 <NETMAGIC>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      t2, 0(t0)
23 A0 72 00	# sw t2,0(t0)

	# The nonce: the time, and "TABN".
# 	li      t0, MTIME_ADDR
B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME_ADDR>
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
# 	li      t0, NONCE
B7 A2 00 00	# lui t0,0xa
93 82 02 FB	# addi t0,t0,-80 # 9fb0 <NONCE>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)
# 	li      t1, 0x4E424154
37 43 42 4E	# lui t1,0x4e424
13 03 43 15	# addi t1,t1,340 # 4e424154 <UART_BASE+0x3e424154>
# 	sw      t1, 4(t0)
23 A2 62 00	# sw t1,4(t0)

	# Clocks: the start, the watchdog; the first tick is now.
# 	li      t0, MTIME_ADDR
B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME_ADDR>
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
# 	li      t0, T_START
B7 A2 00 00	# lui t0,0xa
93 82 02 FC	# addi t0,t0,-64 # 9fc0 <T_START>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)
# 	li      t0, WD_TICK
B7 A2 00 00	# lui t0,0xa
93 82 02 FE	# addi t0,t0,-32 # 9fe0 <WD_TICK>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)
# 	li      t0, TICK_TK
B7 22 26 00	# lui t0,0x262
93 82 02 5A	# addi t0,t0,1440 # 2625a0 <TICK_TK>
# 	sub     t1, t1, t0
33 03 53 40	# sub t1,t1,t0
# 	li      t0, LASTTICK
B7 A2 00 00	# lui t0,0xa
93 82 42 FC	# addi t0,t0,-60 # 9fc4 <LASTTICK>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)

	# The seeds into the peer table (their ports are LE in the seed list).
# 	li      s6, 0
13 0B 00 00	# li s6,0
# seed_top:
# 	bge     s6, s5, seed_done
63 54 5B 09	# bge s6,s5,800006e0 <seed_done>
# 	li      t0, SEED_LIST_OFFSET
B7 A2 00 00	# lui t0,0xa
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	addi    t0, t0, 1
93 82 12 00	# addi t0,t0,1 # a001 <SEED_LIST_OFFSET+0x1>
# 	slli    t1, s6, 2
13 13 2B 00	# slli t1,s6,0x2
# 	add     t0, t0, t1
B3 82 62 00	# add t0,t0,t1
# 	slli    t1, s6, 1
13 13 1B 00	# slli t1,s6,0x1
# 	add     t0, t0, t1                      # &seed[s6]
B3 82 62 00	# add t0,t0,t1
# 	li      a0, ADDRTMP
37 A5 00 00	# lui a0,0xa
13 05 85 FA	# addi a0,a0,-88 # 9fa8 <ADDRTMP>
# 	add     a0, s7, a0
33 85 AB 00	# add a0,s7,a0
# 	lbu     t1, 0(t0); sb t1, 0(a0)
03 C3 02 00	# lbu t1,0(t0)
23 00 65 00	# sb t1,0(a0)
# 	lbu     t1, 1(t0); sb t1, 1(a0)
03 C3 12 00	# lbu t1,1(t0)
A3 00 65 00	# sb t1,1(a0)
# 	lbu     t1, 2(t0); sb t1, 2(a0)
03 C3 22 00	# lbu t1,2(t0)
23 01 65 00	# sb t1,2(a0)
# 	lbu     t1, 3(t0); sb t1, 3(a0)
03 C3 32 00	# lbu t1,3(t0)
A3 01 65 00	# sb t1,3(a0)
# 	lbu     t1, 5(t0); sb t1, 4(a0)         # port, big-endian
03 C3 52 00	# lbu t1,5(t0)
23 02 65 00	# sb t1,4(a0)
# 	lbu     t1, 4(t0); sb t1, 5(a0)
03 C3 42 00	# lbu t1,4(t0)
A3 02 65 00	# sb t1,5(a0)
# 	li      a1, 1                           # a seed
93 05 10 00	# li a1,1
# 	CALL    add_peer
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,800006c4 <seed_top+0x6c>
6F 00 40 77	# j 80000e34 <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 50 00	# li s11,5
6F 00 D0 33	# j 80001208 <add_peer>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4
# 	addi    s6, s6, 1
13 0B 1B 00	# addi s6,s6,1
# 	j       seed_top
6F F0 DF F7	# j 80000658 <seed_top>
# seed_done:
# 	li      t0, NPEERS
B7 A2 00 00	# lui t0,0xa
93 82 02 FD	# addi t0,t0,-48 # 9fd0 <NPEERS>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lw      t0, 0(t0)
83 A2 02 00	# lw t0,0(t0)
# 	beqz    t0, halt_no_net                 # no one to ask
63 86 02 74	# beqz t0,80000e3c <halt_no_net>

# ── The loop: a packet, or else (when it's time) a tick. ────────────────
# net_loop:
# 	bge     s1, s2, net_done
63 D6 24 61	# bge s1,s2,80000d00 <net_done>
# 	fence   iorw, iorw
0F 00 F0 0F	# fence
# 	li      t6, 0x1000
B7 1F 00 00	# lui t6,0x1
# 	add     t0, s7, t6                      # RX used ring
B3 82 FB 01	# add t0,s7,t6
# 	lhu     t1, 2(t0)
03 D3 22 00	# lhu t1,2(t0)
# 	beq     t1, s0, net_idle
63 02 83 42	# beq t1,s0,80000b2c <net_idle>
# 	andi    t2, s0, 15
93 73 F4 00	# andi t2,s0,15
# 	slli    t2, t2, 3
93 93 33 00	# slli t2,t2,0x3
# 	add     t2, t0, t2
B3 83 72 00	# add t2,t0,t2
# 	lw      a7, 4(t2)                       # descriptor
83 A8 43 00	# lw a7,4(t2)
# 	lw      a1, 8(t2)                       # bytes written
83 A5 83 00	# lw a1,8(t2)
# 	slli    t3, a7, 4
13 9E 48 00	# slli t3,a7,0x4
# 	add     t3, s7, t3
33 8E CB 01	# add t3,s7,t3
# 	lw      a2, 0(t3)                       # buffer
03 26 0E 00	# lw a2,0(t3)

# 	lhu     t4, 24(a2)                      # ethertype
83 5E 86 01	# lhu t4,24(a2)
# 	li      t5, 0x0608
13 0F 80 60	# li t5,1544
# 	beq     t4, t5, arp_reply
63 8E EE 2D	# beq t4,t5,80000a10 <arp_reply>
# 	li      t5, 0x0008
13 0F 80 00	# li t5,8
# 	bne     t4, t5, rx_refill
63 90 EE 3D	# bne t4,t5,80000afc <rx_refill>
# 	lbu     t4, 48(a2)                      # UDP destination port
83 4E 06 03	# lbu t4,48(a2)
# 	slli    t4, t4, 8
93 9E 8E 00	# slli t4,t4,0x8
# 	lbu     t5, 49(a2)
03 4F 16 03	# lbu t5,49(a2)
# 	or      t4, t4, t5
B3 EE EE 01	# or t4,t4,t5
# 	bne     t4, s4, rx_refill
63 96 4E 3B	# bne t4,s4,80000afc <rx_refill>
# 	addi    t0, a1, -60                     # at least our header
93 82 45 FC	# addi t0,a1,-60
# 	bltz    t0, rx_refill
63 C2 02 3A	# bltz t0,80000afc <rx_refill>
# 	li      t0, NETMAGIC
B7 A2 00 00	# lui t0,0xa
93 82 42 FD	# addi t0,t0,-44 # 9fd4 <NETMAGIC>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lhu     t1, 0(t0)
03 D3 02 00	# lhu t1,0(t0)
# 	lhu     t4, 54(a2)
83 5E 66 03	# lhu t4,54(a2)
# 	bne     t4, t1, rx_refill
63 96 6E 38	# bne t4,t1,80000afc <rx_refill>
# 	lhu     t1, 2(t0)
03 D3 22 00	# lhu t1,2(t0)
# 	lhu     t4, 56(a2)
83 5E 86 03	# lhu t4,56(a2)
# 	bne     t4, t1, rx_refill
63 90 6E 38	# bne t4,t1,80000afc <rx_refill>
# 	lbu     t4, 58(a2)
83 4E A6 03	# lbu t4,58(a2)
# 	li      t5, 12                          # version
13 0F C0 00	# li t5,12
# 	bne     t4, t5, rx_refill
63 9A EE 37	# bne t4,t5,80000afc <rx_refill>
# 	lbu     t4, 59(a2)                      # type
83 4E B6 03	# lbu t4,59(a2)
# 	li      t5, 2
13 0F 20 00	# li t5,2
# 	beq     t4, t5, rx_hosts
63 88 EE 01	# beq t4,t5,800007a4 <rx_hosts>
# 	li      t5, 16
13 0F 00 01	# li t5,16
# 	beq     t4, t5, rx_chunk
63 8C EE 11	# beq t4,t5,800008b4 <rx_chunk>
# 	j       rx_refill
6F 00 C0 35	# j 80000afc <rx_refill>

# HOSTS: nonce 60, cookie 68, count 76, hosts 78.
# rx_hosts:
# 	addi    t0, a1, -78
93 82 25 FB	# addi t0,a1,-78
# 	bltz    t0, rx_refill
63 CA 02 34	# bltz t0,80000afc <rx_refill>
# 	li      t0, NONCE
B7 A2 00 00	# lui t0,0xa
93 82 02 FB	# addi t0,t0,-80 # 9fb0 <NONCE>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	addi    t1, a2, 60
13 03 C6 03	# addi t1,a2,60
# 	li      t2, 8
93 03 80 00	# li t2,8
# 1:	lbu     t3, 0(t0)
03 CE 02 00	# lbu t3,0(t0)
# 	lbu     t4, 0(t1)
83 4E 03 00	# lbu t4,0(t1)
# 	bne     t3, t4, rx_refill               # not our nonce
63 1A DE 33	# bne t3,t4,80000afc <rx_refill>
# 	addi    t0, t0, 1
93 82 12 00	# addi t0,t0,1
# 	addi    t1, t1, 1
13 03 13 00	# addi t1,t1,1
# 	addi    t2, t2, -1
93 83 F3 FF	# addi t2,t2,-1
# 	bnez    t2, 1b
E3 94 03 FE	# bnez t2,800007c0 <rx_hosts+0x1c>
# 	CALL    find_src
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,800007e8 <rx_hosts+0x44>
6F 00 00 65	# j 80000e34 <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 60 00	# li s11,6
6F 00 D0 2D	# j 800012cc <find_src>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4
# 	beqz    a5, rx_refill
63 80 07 30	# beqz a5,80000afc <rx_refill>
# 	lbu     t0, 6(a5)
83 C2 67 00	# lbu t0,6(a5)
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	bne     t0, t1, rx_refill               # only the hosts we asked
63 9A 62 2E	# bne t0,t1,80000afc <rx_refill>
# 	li      t0, 2
93 02 20 00	# li t0,2
# 	sb      t0, 6(a5)                       # a peer
23 83 57 00	# sb t0,6(a5)
# 	addi    t0, a2, 68
93 02 46 04	# addi t0,a2,68
# 	addi    t1, a5, 8
13 83 87 00	# addi t1,a5,8
# 	li      t2, 8
93 03 80 00	# li t2,8
# 1:	lbu     t3, 0(t0)                       # its cookie for us
03 CE 02 00	# lbu t3,0(t0)
# 	sb      t3, 0(t1)
23 00 C3 01	# sb t3,0(t1)
# 	addi    t0, t0, 1
93 82 12 00	# addi t0,t0,1
# 	addi    t1, t1, 1
13 03 13 00	# addi t1,t1,1
# 	addi    t2, t2, -1
93 83 F3 FF	# addi t2,t2,-1
# 	bnez    t2, 1b
E3 96 03 FE	# bnez t2,80000820 <rx_hosts+0x7c>
# 	lbu     a3, 76(a2)                      # count
83 46 C6 04	# lbu a3,76(a2)
# 	slli    a3, a3, 8
93 96 86 00	# slli a3,a3,0x8
# 	lbu     t0, 77(a2)
83 42 D6 04	# lbu t0,77(a2)
# 	or      a3, a3, t0
B3 E6 56 00	# or a3,a3,t0
# 	addi    a4, a1, -78                     # bytes of hosts
13 87 25 FB	# addi a4,a1,-78
# 	addi    a6, a2, 78                      # the next host
13 08 E6 04	# addi a6,a2,78
# rh_host:
# 	beqz    a3, rh_done
63 80 06 04	# beqz a3,80000890 <rh_done>
# 	addi    a4, a4, -6
13 07 A7 FF	# addi a4,a4,-6
# 	bltz    a4, rh_done
63 4C 07 02	# bltz a4,80000890 <rh_done>
# 	mv      a0, a6
13 05 08 00	# mv a0,a6
# 	li      a1, 0                           # not a seed
93 05 00 00	# li a1,0
# 	CALL    add_peer
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,80000870 <rh_host+0x20>
