93 DF 3E 00	# srli t6,t4,0x3
# 	li      t3, NB_BMAP
37 AE 00 00	# lui t3,0xa
13 0E 0E 08	# addi t3,t3,128 # a080 <NB_BMAP>
# 	add     t3, s7, t3
33 8E CB 01	# add t3,s7,t3
# 	add     t3, t3, t6                      # &bitmap[byte]
33 0E FE 01	# add t3,t3,t6
# 	lbu     t6, 0(t3)                       # current byte
83 4F 0E 00	# lbu t6,0(t3)
# 	andi    t2, t4, 7
93 F3 7E 00	# andi t2,t4,7
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sll     t1, t1, t2                      # 1 << (seq & 7)
33 13 73 00	# sll t1,t1,t2
# 	and     t2, t6, t1
B3 F3 6F 00	# and t2,t6,t1
# 	bnez    t2, rx_refill                   # already received → drop
63 90 03 18	# bnez t2,800009ec <rx_refill>
# 	or      t6, t6, t1
B3 EF 6F 00	# or t6,t6,t1
# 	sb      t6, 0(t3)                       # mark received
23 00 FE 01	# sb t6,0(t3)

