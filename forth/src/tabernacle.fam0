63 64 55 01	# bltu a0,s5,8000062c <probe_top+0x10>
# 	sub     a0, a0, s5
33 05 55 41	# sub a0,a0,s5
# 1:	# Skip if blacklisted: fail_mask & (1 << a0).
# 	li      t0, NF_MASK
B7 A2 00 00	# lui t0,0xa
93 82 42 FF	# addi t0,t0,-12 # 9ff4 <NF_MASK>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lhu     t1, 0(t0)
03 D3 02 00	# lhu t1,0(t0)
