B3 82 5B 00	# add t0,s7,t0
# 	lhu     t1, 0(t0)
03 D3 02 00	# lhu t1,0(t0)
# 	li      t2, 1
93 03 10 00	# li t2,1
# 	sll     t2, t2, t3
B3 93 C3 01	# sll t2,t2,t3
# 	and     t2, t1, t2
B3 73 73 00	# and t2,t1,t2
# 	bnez    t2, sm_scan_next
63 90 03 08	# bnez t2,80000824 <sm_scan_next>
# sm_compare:
