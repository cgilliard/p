# 	lw      t6, -40(gp)
83 AF 81 FD	# lw t6,-40(gp) # 80002b64 <__BSS_END__+0x7d8>
# 	bge     t4, t6, rx_refill
63 D6 FE 1B	# bge t4,t6,800009ec <rx_refill>

