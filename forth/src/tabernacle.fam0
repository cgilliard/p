# 	li      t5, NP_CNT
37 AF 00 00	# lui t5,0xa
13 0F 4F FE	# addi t5,t5,-28 # 9fe4 <NP_CNT>
# 	add     t5, s7, t5
33 8F EB 01	# add t5,s7,t5
# 	sw      zero, 0(t5)
23 20 0F 00	# sw zero,0(t5)

