B7 12 00 00	# lui t0,0x1
# 	add     t0, s7, t0                      # RX used ring base
B3 82 5B 00	# add t0,s7,t0
# 	lhu     s0, 2(t0)                       # s0 = used.idx
03 D4 22 00	# lhu s0,2(t0) # 1002 <PAGE_SIZE+0x2>

