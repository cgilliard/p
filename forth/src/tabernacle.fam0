	# reprobe_entry and refreshed only on actual progress).
# 	li      t0, NP_CNT
B7 A2 00 00	# lui t0,0xa
93 82 42 FE	# addi t0,t0,-28 # 9fe4 <NP_CNT>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      zero, 0(t0)
23 A0 02 00	# sw zero,0(t0)

# rx_loop:
# 	bge     s1, s2, rx_done
63 DA 24 4D	# bge s1,s2,80000b98 <rx_done>

	# Brief delay between RX polls so slirp can deliver.  500K iters
	# ≈ 5–10 ms at QEMU's RV32 emulation speed.
# 	li      t6, 500000
B7 AF 07 00	# lui t6,0x7a
93 8F 0F 12	# addi t6,t6,288 # 7a120 <IPS_TICKS>
# 1:	addi    t6, t6, -1
93 8F FF FF	# addi t6,t6,-1
# 	bnez    t6, 1b
E3 9E 0F FE	# bnez t6,800006d0 <rx_loop+0xc>
# 	fence   iorw, iorw
0F 00 F0 0F	# fence
# 	li      t6, 0x1000
B7 1F 00 00	# lui t6,0x1
