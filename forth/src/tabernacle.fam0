# 	slli    t5, t4, 10
13 9F AE 00	# slli t5,t4,0xa
# 	slli    t6, t4, 8;  add t5, t5, t6
93 9F 8E 00	# slli t6,t4,0x8
33 0F FF 01	# add t5,t5,t6
# 	slli    t6, t4, 7;  add t5, t5, t6
93 9F 7E 00	# slli t6,t4,0x7
33 0F FF 01	# add t5,t5,t6
# 	slli    t6, t4, 3;  sub t5, t5, t6
93 9F 3E 00	# slli t6,t4,0x3
33 0F FF 41	# sub t5,t5,t6
# 	add     t5, gp, t5                      # dst pointer
33 8F E1 01	# add t5,gp,t5

	# src = a2 + 61, length = a1 - 61.
# 	addi    a2, a2, 61
13 06 D6 03	# addi a2,a2,61
# 	addi    a1, a1, -61
93 85 35 FC	# addi a1,a1,-61
# 	bltz    a1, rx_refill                   # runt packet (< 61 B) → drop
63 C6 05 14	# bltz a1,800009ec <rx_refill>
# 	beqz    a1, rx_done_chunk
63 88 05 02	# beqz a1,800008d4 <rx_done_chunk>
	# Clamp copy length so last chunk can't overflow past BIN_SIZE.
# 	lw      t6, -36(gp)
83 AF C1 FD	# lw t6,-36(gp) # 80002b68 <__BSS_END__+0x7dc>
# 	add     t6, gp, t6                      # end of valid region
B3 8F F1 01	# add t6,gp,t6
# 	sub     t6, t6, t5                      # remaining = end - dst
B3 8F EF 41	# sub t6,t6,t5
# 	blt     a1, t6, rx_copy
63 C4 F5 01	# blt a1,t6,800008bc <rx_copy>
# 	mv      a1, t6
93 85 0F 00	# mv a1,t6
# rx_copy:
# 	lbu     t6, 0(a2)
83 4F 06 00	# lbu t6,0(a2)
# 	sb      t6, 0(t5)
23 00 FF 01	# sb t6,0(t5)
# 	addi    a2, a2, 1
13 06 16 00	# addi a2,a2,1
# 	addi    t5, t5, 1
13 0F 1F 00	# addi t5,t5,1
# 	addi    a1, a1, -1
93 85 F5 FF	# addi a1,a1,-1
# 	bnez    a1, rx_copy
E3 96 05 FE	# bnez a1,800008bc <rx_copy>
# rx_done_chunk:
# 	addi    s1, s1, 1                       # received++
93 84 14 00	# addi s1,s1,1
	# Refresh watchdog: WD_TICK = current mtime.
# 	li      t0, MTIME_ADDR
B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME_ADDR>
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
# 	li      t0, WD_TICK
B7 A2 00 00	# lui t0,0xa
93 82 02 FE	# addi t0,t0,-32 # 9fe0 <WD_TICK>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)
# 	j       rx_refill
6F 00 80 0F	# j 800009ec <rx_refill>

# arp_reply:
	# Build ARP reply directly into the shared TX buffer at s7+0x820C
	# (vnet hdr at s7+0x8200, 12 B).  tx_req_range rebuilds the REQ_RANGE
	# from scratch on each call, so overwriting it here is safe.
	# Single NTX_BUF at +0x8200.  42-byte frame.
# 	li      t6, 0x820C
B7 8F 00 00	# lui t6,0x8
93 8F CF 20	# addi t6,t6,524 # 820c <SHUTDOWN_PASS+0x2cb7>
# 	add     a3, s7, t6                      # frame base
B3 86 FB 01	# add a3,s7,t6
	# Ethernet: dst = sender of ARP req (a2+18, 6 bytes) via halfwords.
# 	lhu     t4, 18(a2); sh t4, 0(a3)
83 5E 26 01	# lhu t4,18(a2)
23 90 D6 01	# sh t4,0(a3)
# 	lhu     t4, 20(a2); sh t4, 2(a3)
83 5E 46 01	# lhu t4,20(a2)
23 91 D6 01	# sh t4,2(a3)
# 	lhu     t4, 22(a2); sh t4, 4(a3)
83 5E 66 01	# lhu t4,22(a2)
23 92 D6 01	# sh t4,4(a3)
	# src MAC = 52:54:00:12:34:56 via halfwords
# 	li      t4, 0x5452; sh t4, 6(a3)
B7 5E 00 00	# lui t4,0x5
93 8E 2E 45	# addi t4,t4,1106 # 5452 <MT_KHZ+0x2d42>
23 93 D6 01	# sh t4,6(a3)
# 	li      t4, 0x1200; sh t4, 8(a3)
B7 1E 00 00	# lui t4,0x1
93 8E 0E 20	# addi t4,t4,512 # 1200 <PAGE_SIZE+0x200>
23 94 D6 01	# sh t4,8(a3)
# 	li      t4, 0x5634; sh t4, 10(a3)
B7 5E 00 00	# lui t4,0x5
93 8E 4E 63	# addi t4,t4,1588 # 5634 <SHUTDOWN_PASS+0xdf>
23 95 D6 01	# sh t4,10(a3)
	# ethertype 0x0806 (LE: {06,08})
# 	li      t4, 0x0608; sh t4, 12(a3)
93 0E 80 60	# li t4,1544
23 96 D6 01	# sh t4,12(a3)
	# ARP body: HW type, proto, lengths (6 B) via halfwords.
# 	lhu     t4, 26(a2); sh t4, 14(a3)
83 5E A6 01	# lhu t4,26(a2)
23 97 D6 01	# sh t4,14(a3)
# 	lhu     t4, 28(a2); sh t4, 16(a3)
83 5E C6 01	# lhu t4,28(a2)
23 98 D6 01	# sh t4,16(a3)
# 	lhu     t4, 30(a2); sh t4, 18(a3)
83 5E E6 01	# lhu t4,30(a2)
23 99 D6 01	# sh t4,18(a3)
	# op = 2 (reply) BE: {00,02} → LE halfword 0x0200
# 	li      t4, 0x0200; sh t4, 20(a3)
93 0E 00 20	# li t4,512
23 9A D6 01	# sh t4,20(a3)
	# sender (us): MAC copied from Ethernet src (offset 6), IP 10.0.2.15
# 	lhu     t4, 6(a3);  sh t4, 22(a3)
83 DE 66 00	# lhu t4,6(a3)
23 9B D6 01	# sh t4,22(a3)
# 	lhu     t4, 8(a3);  sh t4, 24(a3)
83 DE 86 00	# lhu t4,8(a3)
23 9C D6 01	# sh t4,24(a3)
# 	lhu     t4, 10(a3); sh t4, 26(a3)
83 DE A6 00	# lhu t4,10(a3)
23 9D D6 01	# sh t4,26(a3)
# 	li      t4, 0x000A; sh t4, 28(a3)
93 0E A0 00	# li t4,10
23 9E D6 01	# sh t4,28(a3)
# 	li      t4, 0x0F02; sh t4, 30(a3)
B7 1E 00 00	# lui t4,0x1
93 8E 2E F0	# addi t4,t4,-254 # f02 <NB_BMAP_BYTES+0xb02>
23 9F D6 01	# sh t4,30(a3)
	# target = incoming sender MAC (pkt+34) + IP (pkt+40) via halfwords.
# 	lhu     t4, 34(a2); sh t4, 32(a3)
83 5E 26 02	# lhu t4,34(a2)
23 90 D6 03	# sh t4,32(a3)
# 	lhu     t4, 36(a2); sh t4, 34(a3)
83 5E 46 02	# lhu t4,36(a2)
23 91 D6 03	# sh t4,34(a3)
# 	lhu     t4, 38(a2); sh t4, 36(a3)
83 5E 66 02	# lhu t4,38(a2)
23 92 D6 03	# sh t4,36(a3)
# 	lhu     t4, 40(a2); sh t4, 38(a3)
83 5E 86 02	# lhu t4,40(a2)
23 93 D6 03	# sh t4,38(a3)
# 	lhu     t4, 42(a2); sh t4, 40(a3)
83 5E A6 02	# lhu t4,42(a2)
23 94 D6 03	# sh t4,40(a3)

# 	mv      a1, a0                          # save desc_idx for rx_refill
93 05 05 00	# mv a1,a0
# 	li      a0, 54                          # 12 vnet + 42 ARP frame
13 05 60 03	# li a0,54
# 	CALL    tx_submit
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,800009d0 <arp_reply+0xd8>
6F 00 00 29	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 60 00	# li s11,6
6F 00 10 06	# j 80001238 <tx_submit>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4
# 	mv      a0, a1                          # restore desc_idx
13 85 05 00	# mv a0,a1
# 	j       rx_refill
6F 00 40 00	# j 800009ec <rx_refill>

# rx_refill:
	# Repost the consumed descriptor.  a0 = desc_idx from used.ring entry.
# 	addi    t0, s7, 256                     # RX avail base
93 82 0B 10	# addi t0,s7,256
# 	lhu     t1, 2(t0)                       # avail.idx
03 D3 22 00	# lhu t1,2(t0)
# 	andi    t2, t1, 15
93 73 F3 00	# andi t2,t1,15
# 	slli    t2, t2, 1
93 93 13 00	# slli t2,t2,0x1
# 	add     t2, t0, t2
B3 83 72 00	# add t2,t0,t2
# 	sh      a0, 4(t2)                       # ring[idx%16] = desc_idx
23 92 A3 00	# sh a0,4(t2)
# 	addi    t1, t1, 1
13 03 13 00	# addi t1,t1,1
# 	sh      t1, 2(t0)                       # avail.idx += 1
23 91 62 00	# sh t1,2(t0)
# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow
# 	sw      zero, 0x50(s3)                  # notify RX queue 0
23 A8 09 04	# sw zero,80(s3)

# 	addi    s0, s0, 1                       # consumed++
13 04 14 00	# addi s0,s0,1
# 	j       rx_loop
6F F0 DF CA	# j 800006c4 <rx_loop>

# ──────────────────────────────────────────────────────────────────────────────
# rx_no_progress — bumps a stall counter; once the threshold is hit, scans the
# chunk bitmap for the first un-received seq and re-sends REQ_RANGE
# [first_missing .. NCHUNKS-1] to the same seed.  The bitmap drops the
# duplicates the server re-bursts, so we converge on the missing tail.
# ──────────────────────────────────────────────────────────────────────────────
# rx_no_progress:
	# Increment NP_CNT; bail back to rx_loop until threshold.
# 	li      t0, NP_CNT
B7 A2 00 00	# lui t0,0xa
93 82 42 FE	# addi t0,t0,-28 # 9fe4 <NP_CNT>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
# 	addi    t1, t1, 1
13 03 13 00	# addi t1,t1,1
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)
# 	li      t6, 10                          # poll threshold
93 0F A0 00	# li t6,10
# 	blt     t1, t6, rx_loop
E3 46 F3 C9	# blt t1,t6,800006c4 <rx_loop>
# 	sw      zero, 0(t0)                     # reset
23 A0 02 00	# sw zero,0(t0)

	# ── Watchdog: check elapsed since last progress against TIMETIK ──
# 	li      t0, MTIME_ADDR
B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME_ADDR>
# 	lw      t1, 0(t0)                       # current mtime
03 A3 02 00	# lw t1,0(t0)
# 	li      t0, WD_TICK
B7 A2 00 00	# lui t0,0xa
93 82 02 FE	# addi t0,t0,-32 # 9fe0 <WD_TICK>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lw      t2, 0(t0)
83 A3 02 00	# lw t2,0(t0)
# 	sub     t2, t1, t2                      # elapsed
B3 03 73 40	# sub t2,t1,t2
# 	li      t0, TIMETIK
B7 A2 00 00	# lui t0,0xa
93 82 C2 FF	# addi t0,t0,-4 # 9ffc <TIMETIK>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lw      t3, 0(t0)
03 AE 02 00	# lw t3,0(t0)
# 	blt     t2, t3, wd_ok
63 C0 C3 03	# blt t2,t3,80000a90 <wd_ok>
	# Timeout!  Either blacklist + reprobe or halt.
# 	li      t6, 0xFF
93 0F F0 0F	# li t6,255
# 	beq     s6, t6, halt_no_net             # never locked → halt
63 06 FB 1F	# beq s6,t6,80000c64 <halt_no_net>
	# Locked seed went silent.  Blacklist and reprobe.
# 	li      t6, 'T'
93 0F 40 05	# li t6,84
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
# 	li      t6, '\n'
93 0F A0 00	# li t6,10
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
# 	j       blacklist_reprobe
6F 00 00 1A	# j 80000c2c <blacklist_reprobe>
# wd_ok:

	# Without a lock yet, do NOT reprobe automatically.  The watchdog
	# will fire after TIMETIK and either halt N (if still unlocked) or
	# blacklist + reprobe (if locked): probe-poll just waits until lock
	# or timeout.
# 	li      t6, 0xFF
93 0F F0 0F	# li t6,255
# 	beq     s6, t6, rx_loop
E3 08 FB C3	# beq s6,t6,800006c4 <rx_loop>

	# Rate-limit batch retries: skip if NS_RTRY (last retry-send mtime)
	# was less than NRTRY_TK ago.  Without this, a partial-data attacker
	# (or undersized seed) makes us spam the wire as we keep asking for
	# chunks that won't come.  WD_TICK still ticks toward TIMETIK based
	# on accepted-chunk freshness, so we'll blacklist after the watchdog
	# fires regardless.
# 	li      t0, MTIME_ADDR
B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME_ADDR>
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
# 	li      t0, NS_RTRY
B7 A2 00 00	# lui t0,0xa
93 82 82 FE	# addi t0,t0,-24 # 9fe8 <NS_RTRY>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lw      t2, 0(t0)
83 A3 02 00	# lw t2,0(t0)
# 	sub     t3, t1, t2
33 0E 73 40	# sub t3,t1,t2
# 	li      t4, NRTRY_TK
B7 8E 1E 00	# lui t4,0x1e8
93 8E 0E 48	# addi t4,t4,1152 # 1e8480 <NRTRY_TK>
# 	blt     t3, t4, rx_loop                 # too soon since last retry
E3 42 DE C1	# blt t3,t4,800006c4 <rx_loop>

	# Batch logic:
	#   1. Re-send REQ_RANGE for [BATCH_START..BATCH_START+63] with bitmap
	#      every NRTRY_TK ms (gated by NS_RTRY) until all 64 land.
	#   2. When the current batch is fully received, advance BATCH_START by 64.
	#   3. Watchdog (TIMETIK on no-new-chunk) handles seed-died blacklist.
# 	li      t0, BATCH_START
B7 A2 00 00	# lui t0,0xa
93 82 A2 FD	# addi t0,t0,-38 # 9fda <BATCH_START>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lhu     t2, 0(t0)                       # t2 = batch start
83 D3 02 00	# lhu t2,0(t0)
	# Done?
# 	lw      t6, -40(gp)
83 AF 81 FD	# lw t6,-40(gp) # 80002b64 <__BSS_END__+0x7d8>
# 	bge     t2, t6, rx_loop                 # batch start past end → nothing left
E3 D6 F3 BF	# bge t2,t6,800006c4 <rx_loop>

	# Compute batch end = min(start + NB_SIZE-1, NCHUNKS - 1).
# batch_clamp:
# 	addi    t1, t2, NB_SIZE - 1             # candidate end
13 83 F3 03	# addi t1,t2,63
# 	lw      t6, -40(gp)
83 AF 81 FD	# lw t6,-40(gp) # 80002b64 <__BSS_END__+0x7d8>
# 	addi    t6, t6, -1
93 8F FF FF	# addi t6,t6,-1
# 	blt     t1, t6, 1f
63 44 F3 01	# blt t1,t6,80000af0 <batch_clamp+0x14>
# 	mv      t1, t6                          # clamp
13 83 0F 00	# mv t1,t6
# 1:
	# Check whether the current batch is fully filled in the bitmap.
	# Walk seq from t2 to t1 inclusive; if any bit is 0, batch incomplete.
# 	mv      t3, t2                          # walker
13 8E 03 00	# mv t3,t2
# batch_check:
# 	bgt     t3, t1, batch_advance           # walked past end → all set
63 4C C3 03	# blt t1,t3,80000b2c <batch_advance>
# 	srli    t4, t3, 3                       # byte index
93 5E 3E 00	# srli t4,t3,0x3
# 	li      t5, NB_BMAP
37 AF 00 00	# lui t5,0xa
13 0F 0F 08	# addi t5,t5,128 # a080 <NB_BMAP>
# 	add     t5, s7, t5
33 8F EB 01	# add t5,s7,t5
# 	add     t5, t5, t4
33 0F DF 01	# add t5,t5,t4
# 	lbu     t4, 0(t5)
83 4E 0F 00	# lbu t4,0(t5)
# 	andi    t6, t3, 7
93 7F 7E 00	# andi t6,t3,7
# 	li      t5, 1
13 0F 10 00	# li t5,1
# 	sll     t5, t5, t6
33 1F FF 01	# sll t5,t5,t6
# 	and     t6, t4, t5
B3 FF EE 01	# and t6,t4,t5
# 	beqz    t6, batch_send                  # bit clear → re-request same range
63 86 0F 02	# beqz t6,80000b4c <batch_send>
# 	addi    t3, t3, 1
13 0E 1E 00	# addi t3,t3,1
# 	j       batch_check
6F F0 DF FC	# j 80000af4 <batch_check>

# batch_advance:
	# All chunks in [t2..t1] received.  Advance BATCH_START past this batch.
# 	addi    t2, t1, 1
93 03 13 00	# addi t2,t1,1
# 	li      t0, BATCH_START
B7 A2 00 00	# lui t0,0xa
93 82 A2 FD	# addi t0,t0,-38 # 9fda <BATCH_START>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sh      t2, 0(t0)
23 90 72 00	# sh t2,0(t0)
	# Are we done?
# 	lw      t6, -40(gp)
83 AF 81 FD	# lw t6,-40(gp) # 80002b64 <__BSS_END__+0x7d8>
# 	bge     t2, t6, rx_loop
E3 D0 F3 B9	# bge t2,t6,800006c4 <rx_loop>
# 	j       batch_clamp
6F F0 5F F9	# j 80000adc <batch_clamp>
# batch_send:
	# Send REQ_RANGE [t2..t1] to locked seed s6.
# 	mv      a0, s6
13 05 0B 00	# mv a0,s6
# 	mv      a1, t2
93 85 03 00	# mv a1,t2
# 	mv      a2, t1
13 06 03 00	# mv a2,t1
# 	CALL    tx_req_range
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,80000b64 <batch_send+0x18>
6F 00 C0 0F	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 70 00	# li s11,7
6F 00 40 4A	# j 80001010 <tx_req_range>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4

	# Stamp NS_RTRY = current mtime to gate the next batch retry.
# 	li      t0, MTIME_ADDR
B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME_ADDR>
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
# 	li      t0, NS_RTRY
B7 A2 00 00	# lui t0,0xa
93 82 82 FE	# addi t0,t0,-24 # 9fe8 <NS_RTRY>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)
# 	j       rx_loop
6F F0 1F B3	# j 800006c4 <rx_loop>

# rx_done:
	# Now run the existing hash check by jumping back to it.  The hash
	# check expects: gp..gp+BIN_SIZE = candidate full_node bytes;
	# scratch buf gets gimli_hash output, compared to hash_data.
# 	addi    sp, sp, -32
13 01 01 FE	# addi sp,sp,-32
# 	mv      a2, sp
13 06 01 00	# mv a2,sp
# 	mv      a0, gp
13 85 01 00	# mv a0,gp
# 	lw      a1, -36(gp)
83 A5 C1 FD	# lw a1,-36(gp) # 80002b68 <__BSS_END__+0x7dc>
# 	CALL    gimli_hash
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,80000bb4 <rx_done+0x1c>
6F 00 C0 0A	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 80 00	# li s11,8
6F 00 C0 2B	# j 80000e78 <gimli_hash>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4

# 	mv      t0, sp
93 02 01 00	# mv t0,sp
# 	addi    t1, gp, -32
13 83 01 FE	# addi t1,gp,-32 # 80002b6c <__BSS_END__+0x7e0>
# 	li      t2, 8
93 03 80 00	# li t2,8
# net_hash_cmp:
# 	lw      t3, 0(t0)
03 AE 02 00	# lw t3,0(t0)
# 	lw      t4, 0(t1)
83 2E 03 00	# lw t4,0(t1)
# 	bne     t3, t4, net_hash_mismatch
63 1E DE 03	# bne t3,t4,80000c18 <net_hash_mismatch>
# 	addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
# 	addi    t1, t1, 4
13 03 43 00	# addi t1,t1,4
# 	addi    t2, t2, -1
93 83 F3 FF	# addi t2,t2,-1
# 	bnez    t2, net_hash_cmp
E3 94 03 FE	# bnez t2,80000bd4 <net_hash_cmp>

	# Match!
# 	addi    sp, sp, 32
13 01 01 02	# addi sp,sp,32
# 	li      t0, SEED_LIST_OFFSET
B7 A2 00 00	# lui t0,0xa
# 	add     a0, s7, t0
33 85 5B 00	# add a0,s7,t0
# 	li      a1, 1                           # boot source = net
93 05 10 00	# li a1,1
# 	mv      a2, s4
13 06 0A 00	# mv a2,s4
# 	addi    t0, a0, DBGFLAG - SEED_LIST_OFFSET   # t0 = s7 + DBGFLAG (= a0 - 40)
93 02 85 FD	# addi t0,a0,-40
# 	lw      a3, 0(t0)                       # a3 = debug flag
83 A6 02 00	# lw a3,0(t0) # a000 <SEED_LIST_OFFSET>
# 	mv      a4, gp                          # a4 = full_node base address (handoff arg)
13 87 01 00	# mv a4,gp
# 	nop                                     # layout pad
13 00 00 00	# nop
# 	j       end_marker
6F 00 80 77	# j 8000138c <end_marker>

# net_hash_mismatch:
# 	addi    sp, sp, 32
13 01 01 02	# addi sp,sp,32
# 	li      t6, 'H'
93 0F 80 04	# li t6,72
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
# 	li      t6, '\n'
93 0F A0 00	# li t6,10
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
	# Blacklist the locked seed and reprobe.  s6 holds the locked idx.
# blacklist_reprobe:
# 	li      t0, NF_CNT
B7 A2 00 00	# lui t0,0xa
93 82 22 FF	# addi t0,t0,-14 # 9ff2 <NF_CNT>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lhu     t1, 2(t0)
03 D3 22 00	# lhu t1,2(t0)
# 	li      t2, 1
93 03 10 00	# li t2,1
# 	sll     t2, t2, s6
B3 93 63 01	# sll t2,t2,s6
# 	or      t1, t1, t2
33 63 73 00	# or t1,t1,t2
# 	sh      t1, 2(t0)
23 91 62 00	# sh t1,2(t0)
# 	lhu     t1, 0(t0)
03 D3 02 00	# lhu t1,0(t0)
# 	addi    t1, t1, 1
13 03 13 00	# addi t1,t1,1
# 	sh      t1, 0(t0)
23 90 62 00	# sh t1,0(t0)
# 	j       reprobe_entry
6F F0 5F 93	# j 8000058c <reprobe_entry>


# halt_no_disk:
# panic:
# 	li      t6, 'N'
93 0F E0 04	# li t6,78
# 	j       halt_tail
6F 00 00 01	# j 80000c70 <halt_tail>

# halt_no_net:
# 	li      t6, 'N'
93 0F E0 04	# li t6,78
# 	beqz    s1, halt_tail
63 84 04 00	# beqz s1,80000c70 <halt_tail>
# 	li      t6, 'H'
93 0F 80 04	# li t6,72
# halt_tail:
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
# 	li      t6, '\n'
93 0F A0 00	# li t6,10
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
# 	lui     t0, %hi(SHUTDOWN_ADDR)
B7 02 10 00	# lui t0,0x100
# 	li      t1, SHUTDOWN_FAIL
37 33 01 00	# lui t1,0x13
13 03 33 33	# addi t1,t1,819 # 13333 <SHUTDOWN_FAIL>
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0) # 100000 <RID_BASE_OFF>
# 1:	j       1b
6F 00 00 00	# j 80000c8c <halt_tail+0x1c>


# ──────────────────────────────────────────────────────────────────────────────
# scan_disk — walk virtio MMIO from V_SCAN_S down to V_SCAN_E looking for
#             a device with magic = 'virt' and device_id = 2 (block).
# Out:    s3 = MMIO base of the found device.
# Trashes: t0..t2.  Returns via dispatch.
# Falls through to caller's halt_no_disk path if no device found (back-jumps
# via `j halt_no_disk` instead of dispatching, so we don't pollute the BST).
# ──────────────────────────────────────────────────────────────────────────────

# scan_disk:
# 	li      t1, 2                           # device_id we want (virtio-blk)
13 03 20 00	# li t1,2
# 	j       scan_common
6F 00 80 00	# j 80000c9c <scan_common>

# ──────────────────────────────────────────────────────────────────────────────
# scan_net — same as scan_disk but looking for device_id=1 (virtio-net).
# ──────────────────────────────────────────────────────────────────────────────

# scan_net:
# 	li      t1, 1                           # virtio-net
13 03 10 00	# li t1,1

# scan_common:
# 	lui     s3, 0x10008                     # start at top virtio-mmio slot
B7 89 00 10	# lui s3,0x10008
# 	lui     t2, 0x10001                     # lower bound (s3 >= t2)
B7 13 00 10	# lui t2,0x10001
# 	lui     t3, 0xFFFFF                     # -PAGE_SIZE (sign-extended u20<<12)
37 FE FF FF	# lui t3,0xfffff
# 1:	bge     s3, t2, 2f
63 D4 79 00	# bge s3,t2,80000cb0 <scan_common+0x14>
# 	j       halt_no_disk
6F F0 1F FB	# j 80000c5c <halt_no_disk>
# 2:	lw      t0, 8(s3)                       # device_id
83 A2 89 00	# lw t0,8(s3) # 10008008 <UART_BASE+0x8008>
# 	beq     t0, t1, dispatch                # found → return
63 86 62 60	# beq t0,t1,800012c0 <dispatch>
# 	add     s3, s3, t3                      # next slot down
B3 89 C9 01	# add s3,s3,t3
# 	j       1b
6F F0 DF FE	# j 80000ca8 <scan_common+0xc>


# ──────────────────────────────────────────────────────────────────────────────
# disk_read — issue a virtio-blk READ for one chunk.
#   In:   a0 = sector,  a1 = avail idx,  a2 = dest,  a3 = byte count.
#         s3 = MMIO base, s7 = queue base (page-aligned).
#   Out:  a0 = status byte (0 = success, nonzero = failure).
#   Trashes: t0..t6.  Returns via dispatch.
# Layout (offsets from s7):
#   0x000..0x180  descriptor table (3 descs × 16 B = 48 B used)
#   0x100..       available ring   (offset 256 from descriptor table)
#   0x1200        status byte   (1 B)
#   0x1202        request header (16 B)
# ──────────────────────────────────────────────────────────────────────────────

# disk_read:
# 	mv      t1, s7                          # t1 = queue base
13 83 0B 00	# mv t1,s7
# 	li      t3, 0x1200
37 1E 00 00	# lui t3,0x1
13 0E 0E 20	# addi t3,t3,512 # 1200 <PAGE_SIZE+0x200>
# 	add     t3, s7, t3                      # t3 = status byte addr
33 8E CB 01	# add t3,s7,t3
# 	addi    t2, t3, 2                       # t2 = req hdr addr
93 03 2E 00	# addi t2,t3,2

	# Request header (16 B at t2): type=READ(0), reserved=0, sector(lo,hi).
# 	sw      zero, 0(t2)
23 A0 03 00	# sw zero,0(t2) # 10001000 <UART_BASE+0x1000>
# 	sw      zero, 4(t2)
23 A2 03 00	# sw zero,4(t2)
# 	sw      a0, 8(t2)
23 A4 A3 00	# sw a0,8(t2)
# 	sw      zero, 12(t2)
23 A6 03 00	# sw zero,12(t2)

	# Descriptor[0]: req hdr.
# 	sw      t2, 0(t1)
23 20 73 00	# sw t2,0(t1)
# 	sw      zero, 4(t1)
23 22 03 00	# sw zero,4(t1)
# 	li      t4, 16
93 0E 00 01	# li t4,16
# 	sw      t4, 8(t1)
23 24 D3 01	# sw t4,8(t1)
# 	li      t4, 1
93 0E 10 00	# li t4,1
# 	sh      t4, 12(t1)                      # flags = NEXT
23 16 D3 01	# sh t4,12(t1)
# 	sh      t4, 14(t1)                      # next  = 1
23 17 D3 01	# sh t4,14(t1)
# 	sw      t4, 0x28(t1)                    # desc[2].len = 1
23 24 D3 03	# sw t4,40(t1)

	# Descriptor[1]: data buffer.
# 	sw      a2, 16(t1)
23 28 C3 00	# sw a2,16(t1)
# 	sw      zero, 20(t1)
23 2A 03 00	# sw zero,20(t1)
# 	sw      a3, 24(t1)
23 2C D3 00	# sw a3,24(t1)
# 	li      t4, 2
93 0E 20 00	# li t4,2
# 	sh      t4, 30(t1)                      # next  = 2
23 1F D3 01	# sh t4,30(t1)
# 	sh      t4, 0x2C(t1)                    # desc[2].flags = WRITE
23 16 D3 03	# sh t4,44(t1)
# 	li      t4, 3
93 0E 30 00	# li t4,3
# 	sh      t4, 28(t1)                      # desc[1].flags = NEXT|WRITE
23 1E D3 01	# sh t4,28(t1)

	# Descriptor[2]: status byte.
# 	sw      t3, 32(t1)
23 20 C3 03	# sw t3,32(t1)
# 	sw      zero, 36(t1)
23 22 03 02	# sw zero,36(t1)
# 	sh      zero, 0x2E(t1)                  # next = 0
23 17 03 02	# sh zero,46(t1)

	# Available ring at t1+256.
# 	addi    t4, t1, 256
93 0E 03 10	# addi t4,t1,256
# 	sh      zero, 0(t4)                     # avail.flags = 0
23 90 0E 00	# sh zero,0(t4)
# 	li      t5, 0xFF
13 0F F0 0F	# li t5,255
# 	sb      t5, 0(t3)                       # status byte = 0xFF (init)
23 00 EE 01	# sb t5,0(t3)
# 	sh      a1, 2(t4)                       # avail.ring[0]
23 91 BE 00	# sh a1,2(t4)
# 	sh      zero, 4(t4)                     # avail.idx (placeholder)
23 92 0E 00	# sh zero,4(t4)

# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow
	# Notify device.
# 	sw      zero, 0x50(s3)
23 A8 09 04	# sw zero,80(s3)

	# Poll status byte (no watchdog yet — virtio-blk under qemu always responds).
# dr_poll:
# 	lbu     t4, 0(t3)
83 4E 0E 00	# lbu t4,0(t3)
# 	li      t5, 0xFF
13 0F F0 0F	# li t5,255
# 	beq     t4, t5, dr_poll
E3 8C EE FF	# beq t4,t5,80000d50 <dr_poll>

# 	fence   ir, iorw
0F 00 F0 0A	# fence ir,iorw
# 	mv      a0, t4
13 85 0E 00	# mv a0,t4
# 	j       dispatch
6F 00 C0 55	# j 800012c0 <dispatch>


# ──────────────────────────────────────────────────────────────────────────────
# gimli_permute — 384-bit Gimli permutation, 24 rounds.
#   In/out:  state at a0 (12 × 32-bit LE words).
#   Trashes: t0..t6, s0, s1.
#   Returns via `j dispatch`.
#
# Per round (r descending 24..1):
#   for col in 0..3:
#       x = rotl(state[col],     24)
#       y = rotl(state[col + 4],  9)
#       z =       state[col + 8]
#       state[col + 8] = x ^ (z << 1) ^ ((y & z) << 2)
#       state[col + 4] = y ^ x        ^ ((x | z) << 1)
#       state[col]     = z ^ y        ^ ((x & y) << 3)
#   if r % 4 == 0: small-swap + state[0] ^= 0x9e377900 | r
#   if r % 4 == 2: big-swap
# ──────────────────────────────────────────────────────────────────────────────

# gimli_permute:
	# Save s0/s1 — callees must per RISC-V ABI; gimli_hash relies on s1.
# 	addi    sp, sp, -8
13 01 81 FF	# addi sp,sp,-8
# 	sw      s0, 0(sp)
23 20 81 00	# sw s0,0(sp)
# 	sw      s1, 4(sp)
23 22 91 00	# sw s1,4(sp)
# 	mv      s0, a0                          # state base
13 04 05 00	# mv s0,a0
# 	li      s1, 24                          # round counter
93 04 80 01	# li s1,24

# gp_round:
# 	mv      a0, s0
13 05 04 00	# mv a0,s0
# 	li      t6, 4
93 0F 40 00	# li t6,4

# gp_col:
# 	lw      t3, 0(a0)
03 2E 05 00	# lw t3,0(a0)
# 	lw      t4, 16(a0)
83 2E 05 01	# lw t4,16(a0)
# 	lw      t5, 32(a0)
03 2F 05 02	# lw t5,32(a0)

	# x = rotl(t3, 24)
# 	slli    t0, t3, 24
93 12 8E 01	# slli t0,t3,0x18
# 	srli    t1, t3, 8
13 53 8E 00	# srli t1,t3,0x8
# 	or      t0, t0, t1
B3 E2 62 00	# or t0,t0,t1

	# y = rotl(t4, 9)
# 	slli    t1, t4, 9
13 93 9E 00	# slli t1,t4,0x9
# 	srli    t2, t4, 23
93 D3 7E 01	# srli t2,t4,0x17
# 	or      t1, t1, t2
33 63 73 00	# or t1,t1,t2

	# state[col]     = z ^ y ^ ((x & y) << 3)
# 	and     t3, t0, t1
33 FE 62 00	# and t3,t0,t1
# 	slli    t3, t3, 3
13 1E 3E 00	# slli t3,t3,0x3
# 	xor     t3, t3, t5
33 4E EE 01	# xor t3,t3,t5
# 	xor     t3, t3, t1
33 4E 6E 00	# xor t3,t3,t1
# 	sw      t3, 0(a0)
23 20 C5 01	# sw t3,0(a0)

	# state[col + 4] = y ^ x ^ ((x | z) << 1)
# 	or      t4, t0, t5
B3 EE E2 01	# or t4,t0,t5
# 	slli    t4, t4, 1
93 9E 1E 00	# slli t4,t4,0x1
# 	xor     t4, t4, t1
B3 CE 6E 00	# xor t4,t4,t1
# 	xor     t4, t4, t0
B3 CE 5E 00	# xor t4,t4,t0
# 	sw      t4, 16(a0)
23 28 D5 01	# sw t4,16(a0)

	# state[col + 8] = x ^ (z << 1) ^ ((y & z) << 2)
# 	and     t2, t1, t5
B3 73 E3 01	# and t2,t1,t5
# 	slli    t2, t2, 2
93 93 23 00	# slli t2,t2,0x2
# 	slli    t5, t5, 1
13 1F 1F 00	# slli t5,t5,0x1
# 	xor     t5, t5, t0
33 4F 5F 00	# xor t5,t5,t0
# 	xor     t5, t5, t2
33 4F 7F 00	# xor t5,t5,t2
# 	sw      t5, 32(a0)
23 20 E5 03	# sw t5,32(a0)

# 	addi    a0, a0, 4
13 05 45 00	# addi a0,a0,4
# 	addi    t6, t6, -1
93 8F FF FF	# addi t6,t6,-1
# 	bnez    t6, gp_col
E3 9A 0F F8	# bnez t6,80000d84 <gp_col>

# 	andi    t0, s1, 3
93 F2 34 00	# andi t0,s1,3
# 	bnez    t0, gp_check_2
63 90 02 04	# bnez t0,80000e38 <gp_check_2>
	# Small swap.
# 	lw      t0, 0(s0)
83 22 04 00	# lw t0,0(s0)
# 	lw      t1, 4(s0)
03 23 44 00	# lw t1,4(s0)
# 	sw      t1, 0(s0)
23 20 64 00	# sw t1,0(s0)
# 	sw      t0, 4(s0)
23 22 54 00	# sw t0,4(s0)
# 	lw      t0, 8(s0)
83 22 84 00	# lw t0,8(s0)
# 	lw      t1, 12(s0)
03 23 C4 00	# lw t1,12(s0)
# 	sw      t1, 8(s0)
23 24 64 00	# sw t1,8(s0)
# 	sw      t0, 12(s0)
23 26 54 00	# sw t0,12(s0)
	# Round constant.
# 	li      t0, 0x9E377900
B7 82 37 9E	# lui t0,0x9e378
93 82 02 90	# addi t0,t0,-1792 # 9e377900 <__global_pointer$+0x1e374d74>
# 	or      t0, t0, s1
B3 E2 92 00	# or t0,t0,s1
# 	lw      t1, 0(s0)
03 23 04 00	# lw t1,0(s0)
# 	xor     t1, t1, t0
33 43 53 00	# xor t1,t1,t0
# 	sw      t1, 0(s0)
23 20 64 00	# sw t1,0(s0)
# 	j       gp_next
6F 00 C0 02	# j 80000e60 <gp_next>

# gp_check_2:
# 	li      t1, 2
13 03 20 00	# li t1,2
# 	bne     t0, t1, gp_next
63 92 62 02	# bne t0,t1,80000e60 <gp_next>
	# Big swap.
# 	lw      t0, 0(s0)
83 22 04 00	# lw t0,0(s0)
# 	lw      t1, 8(s0)
03 23 84 00	# lw t1,8(s0)
# 	sw      t1, 0(s0)
23 20 64 00	# sw t1,0(s0)
# 	sw      t0, 8(s0)
23 24 54 00	# sw t0,8(s0)
# 	lw      t0, 4(s0)
83 22 44 00	# lw t0,4(s0)
# 	lw      t1, 12(s0)
03 23 C4 00	# lw t1,12(s0)
# 	sw      t1, 4(s0)
23 22 64 00	# sw t1,4(s0)
# 	sw      t0, 12(s0)
23 26 54 00	# sw t0,12(s0)

# gp_next:
# 	addi    s1, s1, -1
93 84 F4 FF	# addi s1,s1,-1
# 	bnez    s1, gp_round
E3 9C 04 F0	# bnez s1,80000d7c <gp_round>
# 	lw      s0, 0(sp)
03 24 01 00	# lw s0,0(sp)
# 	lw      s1, 4(sp)
83 24 41 00	# lw s1,4(sp)
# 	addi    sp, sp, 8
13 01 81 00	# addi sp,sp,8
# 	j       dispatch
6F 00 C0 44	# j 800012c0 <dispatch>


# ──────────────────────────────────────────────────────────────────────────────
# gimli_hash — sponge construction over gimli_permute.
#   a0 = data ptr,  a1 = length,  a2 = 32-byte output buf.
#   Uses s0..s3 internally; saves and restores all of them so callers'
#   pinned values survive (s3 in particular is the virtio-net MMIO base,
#   without which post-hash net I/O would silently target stack memory).
#   Returns via `j dispatch`.
# ──────────────────────────────────────────────────────────────────────────────

# gimli_hash:
# 	addi    sp, sp, -64
13 01 01 FC	# addi sp,sp,-64
# 	sw      s0,  0(sp)                      # save callee-saved s-regs we
23 20 81 00	# sw s0,0(sp)
# 	sw      s1,  4(sp)                      # use as scratch (s3 in
23 22 91 00	# sw s1,4(sp)
# 	sw      s2,  8(sp)                      # particular is the virtio-net
23 24 21 01	# sw s2,8(sp)
# 	sw      s3, 12(sp)                      # MMIO base — must be preserved)
23 26 31 01	# sw s3,12(sp)
	# state base = sp + 16 (12 words = 48 bytes, fits in sp+16..sp+64)

# 	li      t0, 12
93 02 C0 00	# li t0,12
# 	addi    t1, sp, 16
13 03 01 01	# addi t1,sp,16
# gh_zero:
# 	sw      zero, 0(t1)
23 20 03 00	# sw zero,0(t1)
# 	addi    t1, t1, 4
13 03 43 00	# addi t1,t1,4
# 	addi    t0, t0, -1
93 82 F2 FF	# addi t0,t0,-1
# 	bnez    t0, gh_zero
E3 9A 02 FE	# bnez t0,80000e94 <gh_zero>

# 	addi    s0, sp, 16                      # state base
13 04 01 01	# addi s0,sp,16
# 	mv      s1, a0                          # data ptr
93 04 05 00	# mv s1,a0
# 	mv      s2, a1                          # remaining
13 89 05 00	# mv s2,a1
# 	mv      s3, a2                          # output buf
93 09 06 00	# mv s3,a2

# gh_absorb:
# 	li      t0, 16
93 02 00 01	# li t0,16
# 	blt     s2, t0, gh_pad
63 40 59 06	# blt s2,t0,80000f18 <gh_pad>

# 	mv      t2, s0
93 03 04 00	# mv t2,s0
# 	mv      t3, s1
13 8E 04 00	# mv t3,s1
# 	li      t4, 4
93 0E 40 00	# li t4,4
# gh_xor_abs:
# 	lw      t0, 0(t3)
83 22 0E 00	# lw t0,0(t3)
# 	lw      t1, 0(t2)
03 A3 03 00	# lw t1,0(t2)
# 	xor     t1, t1, t0
33 43 53 00	# xor t1,t1,t0
# 	sw      t1, 0(t2)
23 A0 63 00	# sw t1,0(t2)
# 	addi    t2, t2, 4
93 83 43 00	# addi t2,t2,4
# 	addi    t3, t3, 4
13 0E 4E 00	# addi t3,t3,4
# 	addi    t4, t4, -1
93 8E FE FF	# addi t4,t4,-1
# 	bnez    t4, gh_xor_abs
E3 92 0E FE	# bnez t4,80000ec8 <gh_xor_abs>

# 	mv      a0, s0
13 05 04 00	# mv a0,s0
# 	CALL    gimli_permute
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,80000ef8 <gh_xor_abs+0x30>
6F F0 9F D6	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 90 00	# li s11,9
