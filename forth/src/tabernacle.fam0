B7 A2 00 00	# lui t0,0xa
93 82 C2 FD	# addi t0,t0,-36 # 9fdc <RND_START>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	lbu     a3, 0(t0)                       # a3 = random start
83 C6 02 00	# lbu a3,0(t0)
# 	li      t6, 0                           # i = 0..s5-1
93 0F 00 00	# li t6,0
