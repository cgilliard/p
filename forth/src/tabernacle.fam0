13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,8000066c <probe_top+0x50>
6F 00 40 5F	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 50 00	# li s11,5
6F 00 D0 19	# j 80001010 <tx_req_range>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4
