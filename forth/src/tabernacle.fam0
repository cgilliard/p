A3 82 62 00	# sb t1,5(t0)
# 	sb      a1, 6(t0)                       # start lo
23 83 B2 00	# sb a1,6(t0)
# 	srli    t1, a2, 8
13 53 86 00	# srli t1,a2,0x8
