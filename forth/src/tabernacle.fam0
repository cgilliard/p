B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME_ADDR>
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
# 	li      t0, WD_TICK
B7 A2 00 00	# lui t0,0xa
93 82 02 FE	# addi t0,t0,-32 # 9fe0 <WD_TICK>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      t1, 0(t0)
23 A0 62 00	# sw t1,0(t0)

