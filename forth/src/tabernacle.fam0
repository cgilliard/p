B7 A2 00 00	# lui t0,0xa
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	addi    t0, t0, 1
93 82 12 00	# addi t0,t0,1 # a001 <SEED_LIST_OFFSET+0x1>
