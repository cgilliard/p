# 	addi    t0, a4, 34
93 02 27 02	# addi t0,a4,34
# 	srli    t1, s4, 8
13 53 8A 00	# srli t1,s4,0x8
# 	sb      t1, 0(t0)
23 80 62 00	# sb t1,0(t0)
# 	sb      s4, 1(t0)
A3 80 42 01	# sb s4,1(t0)
	# dst port = seed[a0].port (LE u16 at a3+4..5)
# 	lbu     t1, 4(a3); sb t1, 3(t0)
03 C3 46 00	# lbu t1,4(a3)
A3 81 62 00	# sb t1,3(t0)
# 	lbu     t1, 5(a3); sb t1, 2(t0)
03 C3 56 00	# lbu t1,5(a3)
23 81 62 00	# sb t1,2(t0)
# 	sb      zero, 4(t0)
23 82 02 00	# sb zero,4(t0)
# 	li      t1, 25; sb t1, 5(t0)             # 8+9+8(bitmap)
13 03 90 01	# li t1,25
A3 82 62 00	# sb t1,5(t0)
# 	sh      zero, 6(t0)                     # UDP csum (optional in IPv4)
23 93 02 00	# sh zero,6(t0)

