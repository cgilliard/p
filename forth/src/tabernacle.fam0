	# Compare 4 IP bytes.
# 	lbu     t1, 0(t0); lbu t2, 38(a2); bne t1, t2, sm_mismatch
03 C3 02 00	# lbu t1,0(t0)
83 43 66 02	# lbu t2,38(a2)
63 18 73 04	# bne t1,t2,8000081c <sm_mismatch>
# 	lbu     t1, 1(t0); lbu t2, 39(a2); bne t1, t2, sm_mismatch
03 C3 12 00	# lbu t1,1(t0)
83 43 76 02	# lbu t2,39(a2)
63 12 73 04	# bne t1,t2,8000081c <sm_mismatch>
# 	lbu     t1, 2(t0); lbu t2, 40(a2); bne t1, t2, sm_mismatch
03 C3 22 00	# lbu t1,2(t0)
83 43 86 02	# lbu t2,40(a2)
63 1C 73 02	# bne t1,t2,8000081c <sm_mismatch>
# 	lbu     t1, 3(t0); lbu t2, 41(a2); bne t1, t2, sm_mismatch
03 C3 32 00	# lbu t1,3(t0)
83 43 96 02	# lbu t2,41(a2)
63 16 73 02	# bne t1,t2,8000081c <sm_mismatch>
