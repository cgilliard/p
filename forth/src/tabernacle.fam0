# ──────────────────────────────────────────────────────────────────────────────
# src/tabernacle.S — sealed bootstrap loader for famchain.
#
# Built via:
#     python3 tools/s2fam0_tabernacle.py src/tabernacle.S src/tabernacle.fam0
#     run bin/tabernacle.uncompressed bin/fam0 src/tabernacle.fam0
# (src/tabernacle.fam0 is checked in; scripts/build.sh runs only the second
#  step — rerun the generator after editing this file.)
#
# Boot ABI (we set up our own gp via auto-prologue below):
#     PC = 0x80000000     entry of this binary
#     gp = end_marker     byte just past tabernacle.bin
#                         (full_node.bin is concatenated after, so
#                          gp = full_node base; gp-40 = config [nchunks,bin_size,hash].)
#
# Calling convention — NO JALR.  Subroutines are reached via direct `j`
# with a per-call-site dispatch tag.  Mirrors the CALL/BST macros in
# src/fam.S; pinned registers:
#     s11 = current return ID (set by CALL)
#     s10 = RID-stack ptr     (decreases on push)
#     s9  = RID-stack bottom  (bounds check)
#     s7  = full_node base    (page-aligned, persists for handoff)
# Callee saves nothing on RID stack itself; CALL pushes/pops s11.
# ──────────────────────────────────────────────────────────────────────────────

# 	.text
# 	.globl _start

# ── Constants ─────────────────────────────────────────────────────────────
# 	.equ UART_BASE,         0x10000000
# 	.equ UART_LSR,                 0x5
# 	.equ UART_RX_READY,            0x1
# 	.equ SHUTDOWN_ADDR,       0x100000
# 	.equ SHUTDOWN_PASS,         0x5555
# 	.equ SHUTDOWN_FAIL,        0x13333

# 	.equ STACK_SIZE,         0x100000      # 1 MiB data stack
# 	.equ RID_BASE_OFF,       0x100000      # RID stack lives just above sp top
# 	.equ RID_SIZE,             0x1000      # 256 frames × 16 B header (overkill)
# 	.equ PAGE_SIZE,             0x1000
# 	.equ NEG_PAGE_SIZE,     0xFFFFF000
# 	.equ PAGE_MASK,              0xFFF

	# BIN_SIZE and NCHUNKS are data words at gp-36 and gp-40,
	# patched by scripts/build.sh after compiling tabernacle.fam0.

# 	.equ SEED_LIST_OFFSET,      0xA000
# 	.equ TIMETIK,               0x9FFC
# 	.equ BPSAVE,                0x9FF8
# 	.equ NS_RTRY,               0x9FE8      # last retry-send mtime (4 B)
# 	.equ NP_CNT,                0x9FE4      # no-progress poll counter (4 B, transitional)
# 	.equ WD_TICK,               0x9FE0      # watchdog: last-progress mtime (4 B)
# 	.equ RND_START,             0x9FDC      # random probe-iteration start (1 B), set once
# 	.equ DBGFLAG,               0x9FD8      # debug flag (4 B): 0=quiet, 1=verbose
# 	.equ BATCH_START,           0x9FDA      # current batch start chunk (2 B)
# 	.equ NB_SIZE,                  64       # chunks per batch
# 	.equ NF_CNT,                0x9FF2      # blacklist fail count (2 B)
# 	.equ NF_MASK,               0x9FF4      # blacklist bitmask, bit i = seed i failed
# 	.equ MAX_SEEDS,                 16
# 	.equ DEFAULT_TIMEOUT_TK, 0x05F5E100
# 	.equ MTIME_ADDR,         0x200BFF8      # CLINT mtime (RV virt machine)
# 	.equ MT_KHZ,                 10000      # mtime frequency in kHz (10 MHz)
# 	.equ IPS_TICKS,           0x7A120      # 500000 ticks = 50 ms inter-probe spacing
# 	.equ NRTRY_TK,           0x1E8480      # 2,000,000 ticks = 200 ms min retry interval
	# NB_BMAP — chunk-received bitmap.  ceil(NCHUNKS / 8) bytes.
	# At 8 KB max NCHUNKS supported (= 64K bits).
# 	.equ NB_BMAP,               0xA080
# 	.equ NB_BMAP_BYTES,           1024


# ── Static-dispatch macros (no JALR), lifted from src/fam.S ───────────────
# 	.altmacro
# 	.set _CSN, 0

# .macro CALL target
# 	.set _CSN, _CSN + 1
# 	addi    s10, s10, -4
# 	bgeu    s10, s9, .L_call_ok_\@
# 	j       panic
# .L_call_ok_\@:
# 	sw      s11, 0(s10)
# 	li      s11, _CSN
# 	j       \target
# 	EMIT_LABEL %_CSN
# 	lw      s11, 0(s10)
# 	addi    s10, s10, 4
# .endm

# .macro EMIT_LABEL n
# .L_csret_\n:
# .endm

# .macro BST lo, hi
# 	BST_R %\lo, %\hi
# .endm
# .macro BST_R lo, hi
# 	.if \hi == \lo
# .L_bst_\lo\()_\hi:
# 		j .L_csret_\lo
# 	.else
# 		.set _BST_MID, (\lo + \hi) / 2
# 		BST_NODE %\lo, %\hi, %_BST_MID, %(_BST_MID - 1), %(_BST_MID + 1)
# 	.endif
# .endm
# .macro BST_NODE lo, hi, mid, lhi, rlo
# .L_bst_\lo\()_\hi:
# 	li      t0, \mid
# 	.if \lhi >= \lo
# 		bge s11, t0, .L_bst_\lo\()_\hi\()_R
# 		j   .L_bst_\lo\()_\lhi
# .L_bst_\lo\()_\hi\()_R:
# 	.endif
# 	.if \rlo <= \hi
# 		ble s11, t0, .L_bst_\lo\()_\hi\()_E
# 		j   .L_bst_\rlo\()_\hi
# .L_bst_\lo\()_\hi\()_E:
# 	.endif
# 	j       .L_csret_\mid
# 	.if \lhi >= \lo
# 		BST_R %\lo, %\lhi
# 	.endif
# 	.if \rlo <= \hi
# 		BST_R %\rlo, %\hi
# 	.endif
# .endm

# PC-relative load-address (avoids `la` which doesn't relax under -march=rv32i).
# .macro LOAD_ADDRESS reg, label
# _base\@:
# 	.equ _offset\@, (\label - _base\@)
# 	auipc   \reg, %pcrel_hi(\label)
# 	addi    \reg, \reg, %pcrel_lo(_base\@)
# .endm

# ──────────────────────────────────────────────────────────────────────────────
# _start
# ──────────────────────────────────────────────────────────────────────────────

# _start:
	# ── §0 Auto-prologue (NOP magic + gp = end_marker). ──────────────
# 	addi    zero, zero, 0
13 00 00 00	# nop
# 	LOAD_ADDRESS gp, end_marker
97 11 00 00	# auipc gp,0x1
93 81 81 38	# addi gp,gp,904 # 8000138c <end_marker>

	# ── §1 Page-align s7, then carve sp / s10 / s9 above it. ─────────
	# s7 = full_node base (page-aligned).
	# sp     = s7 + STACK_SIZE              (data stack top, grows down)
	# s10    = s7 + STACK_SIZE + RID_SIZE   (RID stack top, grows down)
	# s9     = s7 + STACK_SIZE              (RID stack bottom — when s10
	#                                        reaches s9 we're full)
# 	mv      s7, gp
93 8B 01 00	# mv s7,gp
# 	lw      t0, -36(gp)
83 A2 C1 FD	# lw t0,-36(gp) # 80002b68 <__BSS_END__+0x7dc>
# 	add     s7, s7, t0
B3 8B 5B 00	# add s7,s7,t0
# 	li      t0, PAGE_MASK
B7 12 00 00	# lui t0,0x1
93 82 F2 FF	# addi t0,t0,-1 # fff <PAGE_MASK>
# 	add     s7, s7, t0
B3 8B 5B 00	# add s7,s7,t0
# 	li      t0, NEG_PAGE_SIZE
B7 F2 FF FF	# lui t0,0xfffff
# 	and     s7, s7, t0
B3 FB 5B 00	# and s7,s7,t0

# 	li      t0, STACK_SIZE
B7 02 10 00	# lui t0,0x100
# 	add     sp, s7, t0
33 81 5B 00	# add sp,s7,t0
# 	mv      s9, sp                          # RID bottom = sp top
93 0C 01 00	# mv s9,sp
# 	li      t0, RID_SIZE
B7 12 00 00	# lui t0,0x1
# 	add     s10, s9, t0                     # RID top
33 8D 5C 00	# add s10,s9,t0
	# Per fam.S convention, s11 starts at 0 (no enclosing call frame).
# 	li      s11, 0
93 0D 00 00	# li s11,0

	# ── §2 Zero 0xB000 bytes at s7 (covers virtio queues + buffers + the
	#     control / seed-list / chunk-bitmap region around 0xA000). ──
# 	mv      t0, s7
93 82 0B 00	# mv t0,s7
# 	li      t1, 0x2C00                     # 0xB000 / 4 = 0x2C00 words
37 33 00 00	# lui t1,0x3
13 03 03 C0	# addi t1,t1,-1024 # 2c00 <MT_KHZ+0x4f0>
# zero_top:
# 	sw      zero, 0(t0)
23 A0 02 00	# sw zero,0(t0) # 1000 <PAGE_SIZE>
# 	addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
# 	addi    t1, t1, -1
13 03 F3 FF	# addi t1,t1,-1
# 	bne     t1, zero, zero_top
E3 1A 03 FE	# bnez t1,80000050 <zero_top>

	# UART base in s8 (callee-saved across CALL).
# 	lui     s8, %hi(UART_BASE)
37 0C 00 10	# lui s8,0x10000
# 	li      t3, 0                           # skip_phase2 flag
13 0E 00 00	# li t3,0


# ──────────────────────────────────────────────────────────────────────────────
# UART config parser — reads "<bind_port> <debug> <timeout_ms> <ip:port> ...\004"
# Storing parsed state at:
#   s4               = bind_port
#   s7 + DBGFLAG     = debug flag (0=quiet, 1=verbose)
#   s7 + TIMETIK     = timeout in MTIME ticks
#   s7 + BPSAVE      = bind_port (mirror)
#   s7 + SEED_LIST_OFFSET = [u8 count][N × 6 B (4 IP + 2 LE port)]
# ──────────────────────────────────────────────────────────────────────────────

# ── Phase 1: bind_port ────────────────────────────────────────────────────
# 	li      s6, 0
13 0B 00 00	# li s6,0
# ph1_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8) # 10000005 <UART_BASE+0x5>
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph1_top
E3 8C 02 FE	# beqz t0,8000006c <ph1_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, 1f
63 96 5F 00	# bne t6,t0,8000008c <ph1_top+0x20>
# 	li      t3, 1
13 0E 10 00	# li t3,1
# 	j       ph1_done
6F 00 40 02	# j 800000ac <ph1_done>
# 1:	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph1_done
63 FC 62 00	# bgeu t0,t1,800000ac <ph1_done>

# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph1_top
6F F0 5F FC	# j 8000006c <ph1_top>
# ph1_done:
# 	mv      s4, s6
13 0A 0B 00	# mv s4,s6

# ── Phase 1a: debug flag ─────────────────────────────────────────────────
# 	bnez    t3, ph1a_skip
63 14 0E 04	# bnez t3,800000f8 <ph1a_done>
# 	li      s6, 0
13 0B 00 00	# li s6,0
# ph1a_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8)
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph1a_top
E3 8C 02 FE	# beqz t0,800000b8 <ph1a_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, 1f
63 96 5F 00	# bne t6,t0,800000d8 <ph1a_top+0x20>
# 	li      t3, 1
13 0E 10 00	# li t3,1
# 	j       ph1a_done
6F 00 40 02	# j 800000f8 <ph1a_done>
# 1:	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph1a_done
63 FC 62 00	# bgeu t0,t1,800000f8 <ph1a_done>

# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph1a_top
6F F0 5F FC	# j 800000b8 <ph1a_top>
# ph1a_done:
# ph1a_skip:
# 	li      t0, DBGFLAG
B7 A2 00 00	# lui t0,0xa
93 82 82 FD	# addi t0,t0,-40 # 9fd8 <DBGFLAG>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      s6, 0(t0)
23 A0 62 01	# sw s6,0(t0)

# ── Phase 1b: timeout_ms ──────────────────────────────────────────────────
# 	bnez    t3, ph1b_skip
63 14 0E 04	# bnez t3,80000150 <ph1b_done>
# 	li      s6, 0
13 0B 00 00	# li s6,0
# ph1b_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8)
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph1b_top
E3 8C 02 FE	# beqz t0,80000110 <ph1b_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, 1f
63 96 5F 00	# bne t6,t0,80000130 <ph1b_top+0x20>
# 	li      t3, 1
13 0E 10 00	# li t3,1
# 	j       ph1b_done
6F 00 40 02	# j 80000150 <ph1b_done>
# 1:	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph1b_done
63 FC 62 00	# bgeu t0,t1,80000150 <ph1b_done>

# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph1b_top
6F F0 5F FC	# j 80000110 <ph1b_top>
# ph1b_done:
# ph1b_skip:


# ── Compute timeout in MTIME ticks → mem[s7 + TIMETIK] ───────────────────
# 	beqz    s6, timeout_default
63 02 0B 02	# beqz s6,80000174 <timeout_default>
# 	slli    t0, s6, 13
93 12 DB 00	# slli t0,s6,0xd
# 	slli    t1, s6, 11;  add t0, t0, t1
13 13 BB 00	# slli t1,s6,0xb
B3 82 62 00	# add t0,t0,t1
# 	slli    t1, s6, 8;   sub t0, t0, t1
13 13 8B 00	# slli t1,s6,0x8
B3 82 62 40	# sub t0,t0,t1
# 	slli    t1, s6, 4;   add t0, t0, t1
13 13 4B 00	# slli t1,s6,0x4
B3 82 62 00	# add t0,t0,t1
# 	j       timeout_store
6F 00 C0 00	# j 8000017c <timeout_store>
# timeout_default:
# 	li      t0, DEFAULT_TIMEOUT_TK
B7 E2 F5 05	# lui t0,0x5f5e
93 82 02 10	# addi t0,t0,256 # 5f5e100 <DEFAULT_TIMEOUT_TK>
# timeout_store:
# 	li      t1, TIMETIK
37 A3 00 00	# lui t1,0xa
13 03 C3 FF	# addi t1,t1,-4 # 9ffc <TIMETIK>
# 	add     t1, s7, t1
33 83 6B 00	# add t1,s7,t1
# 	sw      t0, 0(t1)
23 20 53 00	# sw t0,0(t1)


# ── Phase 2: seed list ────────────────────────────────────────────────────
# 	li      s5, 0                           # seed count
93 0A 00 00	# li s5,0
# 	bnez    t3, ph2_skip
63 16 0E 0C	# bnez t3,8000025c <ph2_done>

# 	li      t2, SEED_LIST_OFFSET
B7 A3 00 00	# lui t2,0xa
# 	add     t2, s7, t2
B3 83 7B 00	# add t2,s7,t2
# 	addi    t2, t2, 1                       # entries base (skip count byte)
93 83 13 00	# addi t2,t2,1 # a001 <SEED_LIST_OFFSET+0x1>
# 	li      s6, 0                           # accumulator
13 0B 00 00	# li s6,0
# 	li      t3, 0                           # field 0..3 = octets, 4 = port
13 0E 00 00	# li t3,0

# ph2_top:
# 	lbu     t0, UART_LSR(s8)
83 42 5C 00	# lbu t0,5(s8)
# 	andi    t0, t0, UART_RX_READY
93 F2 12 00	# andi t0,t0,1
# 	beqz    t0, ph2_top
E3 8C 02 FE	# beqz t0,800001a8 <ph2_top>
# 	lbu     t6, 0(s8)
83 4F 0C 00	# lbu t6,0(s8)

# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t6, t0, ph2_not_eot
63 90 5F 02	# bne t6,t0,800001dc <ph2_not_eot>
# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t3, t0, ph2_done
63 1C 5E 08	# bne t3,t0,8000025c <ph2_done>
# 	li      t0, MAX_SEEDS
93 02 00 01	# li t0,16
# 	bge     s5, t0, ph2_done
63 D8 5A 08	# bge s5,t0,8000025c <ph2_done>
# 	sh      s6, 4(t2)
23 92 63 01	# sh s6,4(t2)
# 	addi    s5, s5, 1
93 8A 1A 00	# addi s5,s5,1
# 	j       ph2_done
6F 00 40 08	# j 8000025c <ph2_done>

# ph2_not_eot:
# 	addi    t0, t6, -'0'
93 82 0F FD	# addi t0,t6,-48
# 	li      t1, 10
13 03 A0 00	# li t1,10
# 	bgeu    t0, t1, ph2_sep
63 FC 62 00	# bgeu t0,t1,800001fc <ph2_sep>
# 	slli    t1, s6, 3
13 13 3B 00	# slli t1,s6,0x3
# 	slli    t4, s6, 1
93 1E 1B 00	# slli t4,s6,0x1
# 	add     s6, t1, t4
33 0B D3 01	# add s6,t1,t4
# 	add     s6, s6, t0
33 0B 5B 00	# add s6,s6,t0
# 	j       ph2_top
6F F0 1F FB	# j 800001a8 <ph2_top>

# ph2_sep:
# 	li      t0, '.'
93 02 E0 02	# li t0,46
# 	bne     t6, t0, ph2_not_dot
63 98 5F 00	# bne t6,t0,80000210 <ph2_not_dot>
# 	li      t0, 3
93 02 30 00	# li t0,3
# 	bge     t3, t0, ph2_top
E3 50 5E FA	# bge t3,t0,800001a8 <ph2_top>
# 	j       ph2_store_advance
6F 00 40 01	# j 80000220 <ph2_store_advance>
# ph2_not_dot:
# 	li      t0, ':'
93 02 A0 03	# li t0,58
# 	bne     t6, t0, ph2_space
63 90 5F 02	# bne t6,t0,80000234 <ph2_space>
# 	li      t0, 3
93 02 30 00	# li t0,3
# 	bne     t3, t0, ph2_top
E3 16 5E F8	# bne t3,t0,800001a8 <ph2_top>
# ph2_store_advance:
# 	add     t4, t2, t3
B3 8E C3 01	# add t4,t2,t3
# 	sb      s6, 0(t4)
23 80 6E 01	# sb s6,0(t4)
# 	addi    t3, t3, 1
13 0E 1E 00	# addi t3,t3,1
# 	li      s6, 0
13 0B 00 00	# li s6,0
# 	j       ph2_top
6F F0 9F F7	# j 800001a8 <ph2_top>
# ph2_space:
# 	li      t0, 4
93 02 40 00	# li t0,4
# 	bne     t3, t0, ph2_reset
63 1C 5E 00	# bne t3,t0,80000250 <ph2_reset>
# 	li      t0, MAX_SEEDS
93 02 00 01	# li t0,16
# 	bge     s5, t0, ph2_reset
63 D8 5A 00	# bge s5,t0,80000250 <ph2_reset>
# 	sh      s6, 4(t2)
23 92 63 01	# sh s6,4(t2)
# 	addi    s5, s5, 1
93 8A 1A 00	# addi s5,s5,1
# 	addi    t2, t2, 6
93 83 63 00	# addi t2,t2,6
# ph2_reset:
# 	li      s6, 0
13 0B 00 00	# li s6,0
# 	li      t3, 0
13 0E 00 00	# li t3,0
# 	j       ph2_top
6F F0 1F F5	# j 800001a8 <ph2_top>

# ph2_done:
# ph2_skip:

# 	li      t0, SEED_LIST_OFFSET
B7 A2 00 00	# lui t0,0xa
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sb      s5, 0(t0)
23 80 52 01	# sb s5,0(t0) # a000 <SEED_LIST_OFFSET>
# 	li      t0, BPSAVE
B7 A2 00 00	# lui t0,0xa
93 82 82 FF	# addi t0,t0,-8 # 9ff8 <BPSAVE>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      s4, 0(t0)
23 A0 42 01	# sw s4,0(t0)


# ──────────────────────────────────────────────────────────────────────────────
# §3 Disk boot:
#     scan_disk → init virtio-blk → read full_node into [s7..s7+BIN_SIZE)
#     → gimli_hash → compare to hash_data → handoff.
# A missing block device or a read error halts (halt_no_disk); a successful
# read whose hash does not match falls through to §5 net boot.
# ──────────────────────────────────────────────────────────────────────────────

# 	CALL    scan_disk                       # → s3 = disk MMIO base, or fall to halt_d
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,80000284 <ph2_done+0x28>
6F 00 D0 1D	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 10 00	# li s11,1
6F 00 50 20	# j 80000c90 <scan_disk>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4

	# ── Virtio-blk handshake (legacy MMIO) ──
# 	sw      zero, 0x70(s3)                  # status = 0
23 A8 09 06	# sw zero,112(s3)
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sw      t1, 0x70(s3)                    # status = 1 (ACKNOWLEDGE)
23 A8 69 06	# sw t1,112(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 2
13 63 23 00	# ori t1,t1,2
# 	sw      t1, 0x70(s3)                    # status |= 2 (DRIVER)
23 A8 69 06	# sw t1,112(s3)
# 	sw      zero, 0x20(s3)                  # driver_features = 0
23 A0 09 02	# sw zero,32(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 8
13 63 83 00	# ori t1,t1,8
# 	sw      t1, 0x70(s3)                    # status |= 8 (FEATURES_OK)
23 A8 69 06	# sw t1,112(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	andi    t2, t1, 8
93 73 83 00	# andi t2,t1,8
# 	beqz    t2, halt_no_disk                # FEATURES_OK didn't stick
E3 8A 03 18	# beqz t2,80000c5c <halt_no_disk>

# 	li      t1, PAGE_SIZE
37 13 00 00	# lui t1,0x1
# 	sw      t1, 0x28(s3)                    # V_GPS = 0x1000
23 A4 69 02	# sw t1,40(s3)
# 	sw      zero, 0x30(s3)                  # V_QSEL = 0
23 A8 09 02	# sw zero,48(s3)
# 	sw      t1, 0x3C(s3)                    # V_QALGN = 0x1000
23 AE 69 02	# sw t1,60(s3)
# 	li      t1, 16
13 03 00 01	# li t1,16
# 	sw      t1, 0x38(s3)                    # V_QNUM = 16
23 AC 69 02	# sw t1,56(s3)
# 	srli    t1, s7, 12
13 D3 CB 00	# srli t1,s7,0xc
# 	sw      t1, 0x40(s3)                    # V_QPFN = s7 >> 12
23 A0 69 04	# sw t1,64(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 4
13 63 43 00	# ori t1,t1,4
# 	sw      t1, 0x70(s3)                    # status |= 4 (DRIVER_OK)
23 A8 69 06	# sw t1,112(s3)


# ── Read loop: load BIN_SIZE bytes from disk into [gp..gp+BIN_SIZE). ─────
# gp = full_node base (where the bin gets loaded); s7 = queue/stack base
# (post-full_node, page-aligned).  We mustn't write disk data into s7's
# region or we'd clobber descriptors / status / stack.
# 	mv      s0, gp                          # dest walker = full_node base
13 84 01 00	# mv s0,gp
# 	lw      t0, -36(gp)
83 A2 C1 FD	# lw t0,-36(gp) # 80002b68 <__BSS_END__+0x7dc>
# 	mv      s1, t0                          # bytes remaining
93 84 02 00	# mv s1,t0
# 	li      s2, 0                           # sector counter
13 09 00 00	# li s2,0
# 	li      s6, 0                           # avail idx (was s7 in old; conflict)
13 0B 00 00	# li s6,0

# read_loop_top:
# 	beqz    s1, read_done
63 8E 04 06	# beqz s1,80000388 <read_done>

	# chunk = min(remaining, DSK_CHK), rounded up to sector (512 B).
# 	li      t0, 0x10000                     # DSK_CHK = 64 KiB
B7 02 01 00	# lui t0,0x10
# 	mv      a3, t0
93 86 02 00	# mv a3,t0
# 	bge     s1, t0, 1f
63 D8 54 00	# bge s1,t0,80000328 <read_loop_top+0x1c>
# 	addi    a3, s1, 0x1FF                   # round up to 512
93 86 F4 1F	# addi a3,s1,511
# 	li      t0, 0xFFFFFE00                  # NEG_SECT
93 02 00 E0	# li t0,-512
# 	and     a3, a3, t0
B3 F6 56 00	# and a3,a3,t0
# 1:
# 	mv      a0, s2                          # sector
13 05 09 00	# mv a0,s2
# 	addi    s6, s6, 1
13 0B 1B 00	# addi s6,s6,1
# 	mv      a1, s6                          # avail idx
93 05 0B 00	# mv a1,s6
# 	mv      a2, s0                          # dest
13 06 04 00	# mv a2,s0

	# disk_read clobbers a3; save chunk on stack.
# 	addi    sp, sp, -4
13 01 C1 FF	# addi sp,sp,-4
# 	sw      a3, 0(sp)
23 20 D1 00	# sw a3,0(sp)
# 	CALL    disk_read
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,8000034c <read_loop_top+0x40>
6F 00 50 11	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 20 00	# li s11,2
6F 00 D0 16	# j 80000cc0 <disk_read>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4
# 	lw      t0, 0(sp)
83 22 01 00	# lw t0,0(sp)
# 	addi    sp, sp, 4
13 01 41 00	# addi sp,sp,4

	# disk_read returns a0 = status byte (0 = success).
# 	bnez    a0, halt_no_disk
E3 1A 05 0E	# bnez a0,80000c5c <halt_no_disk>

# 	srli    t1, t0, 9                       # chunk / 512
13 D3 92 00	# srli t1,t0,0x9
# 	add     s2, s2, t1
33 09 69 00	# add s2,s2,t1

	# s0 += min(t0, s1); s1 -= min(t0, s1).
# 	bge     s1, t0, 1f
63 D4 54 00	# bge s1,t0,8000037c <read_loop_top+0x70>
# 	mv      t0, s1
93 82 04 00	# mv t0,s1
# 1:	add     s0, s0, t0
33 04 54 00	# add s0,s0,t0
# 	sub     s1, s1, t0
B3 84 54 40	# sub s1,s1,t0
# 	j       read_loop_top
6F F0 9F F8	# j 8000030c <read_loop_top>

# read_done:

# ── Hash + check ─────────────────────────────────────────────────────────
	# Allocate 32-B scratch on stack for computed hash.
# 	addi    sp, sp, -32
13 01 01 FE	# addi sp,sp,-32
# 	mv      a2, sp                          # output buf
13 06 01 00	# mv a2,sp
# 	mv      a0, gp                          # data = full_node base
13 85 01 00	# mv a0,gp
# 	lw      a1, -36(gp)
83 A5 C1 FD	# lw a1,-36(gp) # 80002b68 <__BSS_END__+0x7dc>
# 	CALL    gimli_hash
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,800003a4 <read_done+0x1c>
6F 00 D0 0B	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 30 00	# li s11,3
6F 00 D0 2C	# j 80000e78 <gimli_hash>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4

	# Compare 32 bytes at sp vs hash_data (= gp − 32).
# 	mv      t0, sp
93 02 01 00	# mv t0,sp
# 	addi    t1, gp, -32
13 83 01 FE	# addi t1,gp,-32 # 80002b6c <__BSS_END__+0x7e0>
# 	li      t2, 8                           # 8 words
93 03 80 00	# li t2,8
# hash_cmp:
# 	lw      t3, 0(t0)
03 AE 02 00	# lw t3,0(t0) # 10000 <NB_BMAP+0x5f80>
# 	lw      t4, 0(t1)
83 2E 03 00	# lw t4,0(t1) # 1000 <PAGE_SIZE>
# 	bne     t3, t4, hash_mismatch
63 1E DE 03	# bne t3,t4,80000408 <hash_mismatch>
# 	addi    t0, t0, 4
93 82 42 00	# addi t0,t0,4
# 	addi    t1, t1, 4
13 03 43 00	# addi t1,t1,4
# 	addi    t2, t2, -1
93 83 F3 FF	# addi t2,t2,-1
# 	bnez    t2, hash_cmp
E3 94 03 FE	# bnez t2,800003c4 <hash_cmp>

	# Match!  Free scratch, set handoff regs, jal over hash data to gp.
# 	addi    sp, sp, 32
13 01 01 02	# addi sp,sp,32

# 	li      t0, SEED_LIST_OFFSET
B7 A2 00 00	# lui t0,0xa
# 	add     a0, s7, t0                      # a0 = seed list ptr
33 85 5B 00	# add a0,s7,t0
# 	li      a1, 0                           # a1 = boot source (0 = disk)
93 05 00 00	# li a1,0
# 	mv      a2, s4                          # a2 = bind_port
13 06 0A 00	# mv a2,s4
# 	addi    t0, a0, DBGFLAG - SEED_LIST_OFFSET   # t0 = s7 + DBGFLAG (= a0 - 40)
93 02 85 FD	# addi t0,a0,-40
# 	lw      a3, 0(t0)                       # a3 = debug flag
83 A6 02 00	# lw a3,0(t0) # a000 <SEED_LIST_OFFSET>
# 	mv      a4, gp                          # a4 = full_node base address (handoff arg)
13 87 01 00	# mv a4,gp
# 	nop                                     # layout pad
13 00 00 00	# nop
# 	j       end_marker                      # gp = end_marker = full_node entry
6F 00 90 78	# j 8000138c <end_marker>


# hash_mismatch:
# 	addi    sp, sp, 32
13 01 01 02	# addi sp,sp,32
# 	li      t6, 'H'
93 0F 80 04	# li t6,72
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
# 	li      t6, '\n'
93 0F A0 00	# li t6,10
# 	sb      t6, 0(s8)
23 00 FC 01	# sb t6,0(s8)
	# Fall through to scan_net.


# ──────────────────────────────────────────────────────────────────────────────
# §5 Net boot.
#   scan_net → (or halt if no virtio-net) → handshake → RX/TX queue setup
#   → mark DRIVER_OK → kick RX → enter the REQ_RANGE seed-fetch loop
#   (probe → lock → batch-fetch via chunk bitmap → gimli_hash → handoff).
# Layout in s7's region:
#     s7 + 0x0000  RX queue 0 page (descriptors, avail, used)
#     s7 + 0x2000  16 × 1536 B RX buffers (= 0x6000 B)
#     s7 + 0x8000  TX queue 1 page
# ──────────────────────────────────────────────────────────────────────────────

# 	CALL    scan_net                        # → s3 = virtio-net MMIO base
13 0D CD FF	# addi s10,s10,-4
63 74 9D 01	# bgeu s10,s9,80000428 <hash_mismatch+0x20>
6F 00 90 03	# j 80000c5c <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 40 00	# li s11,4
6F 00 90 06	# j 80000c98 <scan_net>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4

	# ── Reset used.idx after disk path. ────────────────────────────────
	# disk_read uses the same V_QPFN = s7 (legacy MMIO 1-page-per-queue
	# layout) as the net RX queue.  Each disk read bumps the device's
	# used.idx at s7+0x1002 and writes a status entry at s7+0x1004.
	# After the 48 disk reads needed to load a 3 MiB full_node.bin,
	# used.idx = 48; net rx_loop would then walk through 48 phantom
	# 1-byte "packets" pointing into zero-filled buffers, never see a
	# real BIN0 reply in time, and halt 'N'.  Just zero used.flags +
	# used.idx (4 B) — stale used.ring[] entries are harmless since the
	# device overwrites them as it processes new packets.  Don't touch
	# the FSM control region at s7+0x9FDA..0x9FFF (TIMETIK lives there)
	# nor the seed list at s7+0xA000.
# 	li      t0, 0x1000
B7 12 00 00	# lui t0,0x1
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      zero, 0(t0)                     # used.flags = used.idx = 0
23 A0 02 00	# sw zero,0(t0) # 1000 <PAGE_SIZE>

	# ── Virtio-net handshake (legacy MMIO) ─────────────────────────────
# 	sw      zero, 0x70(s3)                  # status = 0
23 A8 09 06	# sw zero,112(s3)
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sw      t1, 0x70(s3)                    # status = 1 (ACK)
23 A8 69 06	# sw t1,112(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 2
13 63 23 00	# ori t1,t1,2
# 	sw      t1, 0x70(s3)                    # status |= 2 (DRIVER)
23 A8 69 06	# sw t1,112(s3)
# 	li      t1, 0x8020                      # negotiate F_MAC | F_MRG_RXBUF
37 83 00 00	# lui t1,0x8
13 03 03 02	# addi t1,t1,32 # 8020 <SHUTDOWN_PASS+0x2acb>
# 	sw      t1, 0x20(s3)                    # V_DRVF
23 A0 69 02	# sw t1,32(s3)
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 8
13 63 83 00	# ori t1,t1,8
# 	sw      t1, 0x70(s3)                    # status |= 8 (FEATURES_OK)
23 A8 69 06	# sw t1,112(s3)
# 	li      t1, PAGE_SIZE
37 13 00 00	# lui t1,0x1
# 	sw      t1, 0x28(s3)                    # V_GPS = 0x1000
23 A4 69 02	# sw t1,40(s3)

	# ── RX queue (queue 0, 16 entries × 1536 B buffers) ───────────────
# 	sw      zero, 0x30(s3)                  # V_QSEL = 0
23 A8 09 02	# sw zero,48(s3)
# 	li      t1, 16
13 03 00 01	# li t1,16
# 	sw      t1, 0x38(s3)                    # V_QNUM = 16
23 AC 69 02	# sw t1,56(s3)
# 	li      t1, PAGE_SIZE
37 13 00 00	# lui t1,0x1
# 	sw      t1, 0x3C(s3)                    # V_QALGN
23 AE 69 02	# sw t1,60(s3)
# 	srli    t1, s7, 12
13 D3 CB 00	# srli t1,s7,0xc
# 	sw      t1, 0x40(s3)                    # V_QPFN = s7 >> 12 (RX queue at s7)
23 A0 69 04	# sw t1,64(s3)

	# Populate 16 RX descriptors.  desc base = s7; buffer base = s7+0x2000.
# 	mv      t0, s7                          # descriptor walker
93 82 0B 00	# mv t0,s7
# 	li      t6, 0x2000
B7 2F 00 00	# lui t6,0x2
# 	add     t2, s7, t6                      # buffer walker = s7 + 0x2000
B3 83 FB 01	# add t2,s7,t6
# 	li      t3, 0                           # i
13 0E 00 00	# li t3,0
# 	li      t5, 1536
13 0F 00 60	# li t5,1536
# rx_desc_top:
# 	li      t6, 16
93 0F 00 01	# li t6,16
# 	bge     t3, t6, rx_desc_done
63 5E FE 03	# bge t3,t6,800004f0 <rx_desc_done>
# 	sw      t2, 0(t0)                       # desc[i].addr = buffer
23 A0 72 00	# sw t2,0(t0)
# 	sw      zero, 4(t0)                     # addr_hi = 0
23 A2 02 00	# sw zero,4(t0)
# 	sw      t5, 8(t0)                       # desc[i].len = 1536
23 A4 E2 01	# sw t5,8(t0)
# 	li      t6, 2
93 0F 20 00	# li t6,2
# 	sh      t6, 12(t0)                      # flags = WRITE
23 96 F2 01	# sh t6,12(t0)
# 	sh      zero, 14(t0)                    # next = 0
23 97 02 00	# sh zero,14(t0)
	# avail.ring[i] = i  (avail ring at s7 + 256+4)
# 	addi    t6, s7, 260                     # &avail.ring[0]
93 8F 4B 10	# addi t6,s7,260
# 	slli    t4, t3, 1                       # i*2
93 1E 1E 00	# slli t4,t3,0x1
# 	add     t4, t6, t4                      # &avail.ring[i]
B3 8E DF 01	# add t4,t6,t4
# 	sh      t3, 0(t4)
23 90 CE 01	# sh t3,0(t4)
	# advance
# 	addi    t0, t0, 16                      # next descriptor
93 82 02 01	# addi t0,t0,16
# 	add     t2, t2, t5                      # next buffer
B3 83 E3 01	# add t2,t2,t5
# 	addi    t3, t3, 1
13 0E 1E 00	# addi t3,t3,1
# 	j       rx_desc_top
6F F0 5F FC	# j 800004b0 <rx_desc_top>
# rx_desc_done:
# 	li      t1, 16
13 03 00 01	# li t1,16
# 	addi    t6, s7, 258                     # avail.idx
93 8F 2B 10	# addi t6,s7,258
# 	sh      t1, 0(t6)
23 90 6F 00	# sh t1,0(t6) # 2000 <_offset0+0xc78>

	# ── TX queue (queue 1, SIZE = 1) ──────────────────────────────────
	# V_QNUM = 1 forces every TX to drain before the next is posted.
	# With V_QNUM = 16, repeated tx_req_range calls let avail.idx run
	# 16+ entries ahead of used.idx whenever slirp couldn't deliver
	# responses (e.g., non-loopback IPs while ARP is pending), tripping
	# QEMU's "Guest moved used index" virtio violation and wedging the
	# device.  Hence V_QNUM = 1.
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sw      t1, 0x30(s3)                    # V_QSEL = 1
23 A8 69 02	# sw t1,48(s3)
# 	sw      t1, 0x38(s3)                    # V_QNUM = 1
23 AC 69 02	# sw t1,56(s3)
# 	li      t1, PAGE_SIZE
37 13 00 00	# lui t1,0x1
# 	sw      t1, 0x3C(s3)
23 AE 69 02	# sw t1,60(s3)
# 	li      t6, 0x8000
B7 8F 00 00	# lui t6,0x8
# 	add     t1, s7, t6
33 83 FB 01	# add t1,s7,t6
# 	srli    t1, t1, 12
13 53 C3 00	# srli t1,t1,0xc
# 	sw      t1, 0x40(s3)                    # V_QPFN = (s7+0x8000) >> 12
23 A0 69 04	# sw t1,64(s3)

	# ── Driver ready + kick RX ────────────────────────────────────────
# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow
# 	lw      t1, 0x70(s3)
03 A3 09 07	# lw t1,112(s3)
# 	ori     t1, t1, 4
13 63 43 00	# ori t1,t1,4
# 	sw      t1, 0x70(s3)                    # status |= 4 (DRIVER_OK)
23 A8 69 06	# sw t1,112(s3)
# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow
# 	sw      zero, 0x50(s3)                  # notify queue 0 (RX)
23 A8 09 04	# sw zero,80(s3)


# ──────────────────────────────────────────────────────────────────────────────
# §6 Net seed-fetch state machine.
#
# Probe → lock → batch with bitmap retry, MTIME watchdog, blacklist+reprobe.
#
# Layout in s7's region used here:
#     +0x8000  TX queue page (desc @ +0..+32, avail @ +256, used @ +0x1000)
#     +0x8200  REQ_RANGE vnet hdr (12 B) + frame (51 B)
#     +0x8400  ARP reply  vnet hdr (12 B) + frame (54 B)
#     +0xA000  seed list (count + 6 × N entries)
#     +0xA080  chunk-received bitmap (NB_BMAP_BYTES)
#     +0x9FF4  fail mask (2 B), +0x9FF2 fail count (2 B)
#
# Pinned regs (across reprobe):
#     s0 = consumed RX used.idx
#     s1 = received chunk count
#     s2 = NCHUNKS
#     s3 = virtio-net MMIO base
#     s4 = bind_port
#     s5 = seed count (parsed)
#     s6 = locked seed idx (0xFF = not locked yet)
#     s7 = data region base
#     s8 = UART base
#     gp = full_node base (write target)
# ──────────────────────────────────────────────────────────────────────────────

	# Select TX queue once for V_QSEL config (not needed for V_QNTFY).
# 	li      t1, 1
13 03 10 00	# li t1,1
# 	sw      t1, 0x30(s3)                    # V_QSEL = 1
23 A8 69 02	# sw t1,48(s3)
# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow

	# ── Init FSM state: fail_mask=0, fail_count=0, RX consumed=0,
	#    random probe-iteration start (WD_TICK is refreshed inside
	#    reprobe_entry after the post-reprobe RX drain + wait).
# 	li      t0, NF_CNT
B7 A2 00 00	# lui t0,0xa
93 82 22 FF	# addi t0,t0,-14 # 9ff2 <NF_CNT>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sh      zero, 0(t0)
23 90 02 00	# sh zero,0(t0)
# 	sh      zero, 2(t0)
23 91 02 00	# sh zero,2(t0)
# 	li      s0, 0                           # consumed used.idx (one-time)
13 04 00 00	# li s0,0
# 	li      t0, MTIME_ADDR
B7 C2 00 02	# lui t0,0x200c
93 82 82 FF	# addi t0,t0,-8 # 200bff8 <MTIME_ADDR>
# 	lw      t1, 0(t0)
03 A3 02 00	# lw t1,0(t0)
	# Random probe-iteration start: r = mtime mod s5.  Picked once on
	# startup so different clients hit seeds in different orders, spreading
