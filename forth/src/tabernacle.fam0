# ──────────────────────────────────────────────────────────────────────────────
# tx_submit — post the shared TX buffer (s7+0x8200) as desc[0], bump
# avail.idx, fence+notify, and spin-wait for the device to drain.
#
# In:  a0 = total frame length (vnet hdr + Ethernet frame)
# Uses pinned: s3 (net MMIO), s7 (data region)
# Trashes: t0..t5.  Returns via dispatch.
# ──────────────────────────────────────────────────────────────────────────────
# tx_submit:
# 	li      t0, 0x8200
B7 82 00 00	# lui t0,0x8
93 82 02 20	# addi t0,t0,512 # 8200 <SHUTDOWN_PASS+0x2cab>
# 	add     t0, s7, t0
B3 82 5B 00	# add t0,s7,t0
# 	sw      zero, 0(t0)                     # zero vnet hdr (12 B)
23 A0 02 00	# sw zero,0(t0)
# 	sw      zero, 4(t0)
23 A2 02 00	# sw zero,4(t0)
# 	sw      zero, 8(t0)
23 A4 02 00	# sw zero,8(t0)
# 	li      t1, 0x8000
37 83 00 00	# lui t1,0x8
# 	add     t1, s7, t1                      # TX queue base
33 83 6B 00	# add t1,s7,t1
# 	sw      t0, 0(t1)                       # desc[0].addr
23 20 53 00	# sw t0,0(t1) # 8000 <SHUTDOWN_PASS+0x2aab>
# 	sw      zero, 4(t1)
23 22 03 00	# sw zero,4(t1)
# 	sw      a0, 8(t1)                       # desc[0].len
23 24 A3 00	# sw a0,8(t1)
# 	sh      zero, 12(t1)
23 16 03 00	# sh zero,12(t1)
# 	sh      zero, 14(t1)
23 17 03 00	# sh zero,14(t1)
# 	addi    t2, t1, 16                      # avail ring (queue_size=1)
93 03 03 01	# addi t2,t1,16
# 	sh      zero, 4(t2)                     # ring[0] = desc 0
23 92 03 00	# sh zero,4(t2)
# 	lhu     t3, 2(t2)
03 DE 23 00	# lhu t3,2(t2)
# 	addi    t3, t3, 1
13 0E 1E 00	# addi t3,t3,1
# 	sh      t3, 2(t2)                       # avail.idx += 1
23 91 C3 01	# sh t3,2(t2)
# 	fence   iorw, ow
0F 00 50 0F	# fence iorw,ow
# 	li      t3, 1
13 0E 10 00	# li t3,1
# 	sw      t3, 0x50(s3)                    # V_QNTFY = 1 (TX queue)
23 A8 C9 05	# sw t3,80(s3)
# 	li      t5, 1000000
37 4F 0F 00	# lui t5,0xf4
13 0F 0F 24	# addi t5,t5,576 # f4240 <SHUTDOWN_FAIL+0xe0f0d>
# 	li      t3, 0x9000
37 9E 00 00	# lui t3,0x9
# 	add     t3, s7, t3                      # TX used ring base
33 8E CB 01	# add t3,s7,t3
# 	li      t4, 0x8010
B7 8E 00 00	# lui t4,0x8
93 8E 0E 01	# addi t4,t4,16 # 8010 <SHUTDOWN_PASS+0x2abb>
# 	add     t4, s7, t4                      # TX avail ring base
B3 8E DB 01	# add t4,s7,t4
# 	lhu     t0, 2(t4)                       # avail.idx target
83 D2 2E 00	# lhu t0,2(t4)
# 1:	lhu     t1, 2(t3)                       # used.idx
03 53 2E 00	# lhu t1,2(t3) # 9002 <PKT+0xdcc>
# 	beq     t1, t0, 2f
63 06 53 00	# beq t1,t0,80001790 <tx_submit+0x84>
# 	addi    t5, t5, -1
13 0F FF FF	# addi t5,t5,-1
# 	bnez    t5, 1b
E3 1A 0F FE	# bnez t5,80001780 <tx_submit+0x74>
# 2:	j       dispatch
6F 00 40 00	# j 80001794 <dispatch>


# ──────────────────────────────────────────────────────────────────────────────
# dispatch — single shared resume point.  Looks up s11 (return ID) in the
# BST and jumps to the corresponding .L_csret_<N> label (which sits right
# after each CALL site, where execution resumes).
# ──────────────────────────────────────────────────────────────────────────────

# dispatch:
# 	BST 1, %_CSN
93 02 C0 00	# li t0,12
63 D4 5D 00	# bge s11,t0,800017a0 <dispatch+0xc>
6F 00 00 01	# j 800017ac <dispatch+0x18>
