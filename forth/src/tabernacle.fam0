63 74 9D 01	# bgeu s10,s9,8000089c <rh_done+0xc>
6F 00 C0 59	# j 80000e34 <halt_no_disk>
23 20 BD 01	# sw s11,0(s10)
93 0D 80 00	# li s11,8
6F 00 50 14	# j 800011e8 <progress>
83 2D 0D 00	# lw s11,0(s10)
13 0D 4D 00	# addi s10,s10,4
