37 0F 01 00	# lui t5,0x10
13 0F FF FF	# addi t5,t5,-1 # ffff <NB_BMAP+0x5f7f>
# 	and     t3, t3, t5
33 7E EE 01	# and t3,t3,t5
# 	add     t3, t3, t4
33 0E DE 01	# add t3,t3,t4
# 	srli    t4, t3, 16
93 5E 0E 01	# srli t4,t3,0x10
# 	add     t3, t3, t4
33 0E DE 01	# add t3,t3,t4
