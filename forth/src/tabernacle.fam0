13 03 60 05	# li t1,86
A3 05 67 00	# sb t1,11(a4)
# 	li      t1, 0x08; sb t1, 12(a4)
13 03 80 00	# li t1,8
23 06 67 00	# sb t1,12(a4)
# 	sb      zero, 13(a4)
A3 06 07 00	# sb zero,13(a4)

