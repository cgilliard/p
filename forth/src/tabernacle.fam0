63 1E FB 01	# bne s6,t6,8000082c <sm_done>
# 	mv      s6, t3                          # lock!
13 0B 0E 00	# mv s6,t3
# 	j       sm_done
6F 00 40 01	# j 8000082c <sm_done>
# sm_mismatch:
	# Locked path: any mismatch → drop.
# 	li      t6, 0xFF
93 0F F0 0F	# li t6,255
