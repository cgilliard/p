83 4E A6 03	# lbu t4,58(a2)
# 	li      t5, 0x82                        # RSP_CHUNK
13 0F 20 08	# li t5,130
# 	bne     t4, t5, rx_refill
63 90 EE 29	# bne t4,t5,800009ec <rx_refill>

