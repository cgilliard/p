# BIN_CHUNK: hash 60, index 92, data 96.
# rx_chunk:
# 	addi    t0, a1, -97
93 82 F5 F9	# addi t0,a1,-97
# 	bltz    t0, rx_refill
63 C2 02 24	# bltz t0,80000afc <rx_refill>
