: fqv variable ;
\ fqtab ( -- a )   each query's first-layer values, fx then fnx (base values).
: fqtab ( -- a )
	fqv @ 0= if
		80 lit alloc dup fqv ! 20 lit zero
		1619612198u lit fqv @ 0 lit + !  1204504520u lit fqv @ 10 lit + !
		769382285u lit fqv @ 20 lit + !  348352641u lit fqv @ 30 lit + !
		786471253u lit fqv @ 40 lit + !  1498685160u lit fqv @ 50 lit + !
		786471253u lit fqv @ 60 lit + !  1498685160u lit fqv @ 70 lit + !
	then
	fqv @
;
: ftv variable ;   : ftt ( -- tr )   ftv 88 lit lazy ;

\ frun ( buf n -- ok )   verify the fixture's proof, with its first layer.
: frun ( buf n -- ok )
	rinit
	ftt "fri-test" tlab tnew
	ftt 8 lit 1F lit 2 lit 4 lit 4 lit fbeg
	4 lit 0 lit do fqidx fqtab i 5 lit lshift + dup 10 lit + rot fquery and loop
;

Test {
	fri_verifies {
		ffix mcopy frun assert
		rpos @ rend @ asrt_eq                              \ the whole proof was read
		ftt "after" tlab ftb tchal                         \ the transcript matches Rust's after
		ftb 1615957435u lit 1025219654u lit 395836410u lit 655377785u lit c4? assert
	}
	fri_indices {
		ffix mcopy rinit
		ftt "fri-test" tlab tnew
		ftt 8 lit 1F lit 2 lit 4 lit 4 lit fbeg assert
		fqidx 33 lit asrt_eq
	}
	fri_wrong_first_layer {
		fqtab dup @ 1 lit fadd over !
		ffix mcopy frun 0 lit asrt_eq
		dup @ 1 lit fsub swap !
	}
	fri_tampered_final {
		ffix mcopy over 28C lit + dup c@ 1 lit xor swap c!  frun 0 lit asrt_eq
	}
	fri_tampered_opening {
		ffix mcopy over 2B7 lit + dup c@ 1 lit xor swap c!  frun 0 lit asrt_eq
	}
	fri_bad_nonce {
		ffix mcopy over 29C lit + dup c@ 1 lit xor swap c!  frun 0 lit asrt_eq
	}
}
