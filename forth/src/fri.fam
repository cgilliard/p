\ ──────────────────────────────────────────────────────────────────────────────
\ src/fri.fam — verifying a FRI proof (see ../rust/src/fri.rs, `Proof::verify`).
\
\ The first layer, over the coset shift * <g> of 2^log_size points, is never
\ committed: the caller vouches for its two values at each query.  Every later
\ round folds by 8 (fewer at the end), each leaf holding a coset of values
\ folded with one challenge.  Folding stops at 2^log_blowup points, all of
\ which must equal the proof's final value.
\
\ No indirect calls here, so the caller drives the queries:
\   fbeg   ( tr log_size shift log_blowup queries grind_bits -- ok )
\          reads the caps, final value and nonce (at the reader, `rinit`),
\          replaying the transcript; checks the proof of work.
\   then for each query:
\   fqidx  ( -- low )          the query's index (from the transcript)
\   fquery ( fx fnx low -- ok ) fx, fnx: the first layer's values (extension
\          elements) at low and low + 2^(log_size - 1); reads and checks the
\          query's openings.
\ ──────────────────────────────────────────────────────────────────────────────

\ fgtab ( -- a )   generators of BabyBear's subgroups of order 2^k, k = 0..27
\        (Plonky3's TWO_ADIC_GENERATORS, as in the Rust node).
: fgtab ( -- a )
97020000 ,   \ auipc t0,0
93824201 ,   \ addi  t0,t0,20          ( t0 = the first constant, after this prologue )
1301C1FF ,   \ addi  sp,sp,-4
23205100 ,   \ sw    t0,0(sp)          ( push it )
6F004007 ,   \ jal   x0,+116          ( skip the 28 constants )
1u ,   2013265920u ,   1728404513u ,   1592366214u ,   196396260u ,   760005850u ,   1721589904u ,
397765732u ,   1732600167u ,   1753498361u ,   341742893u ,   1340477990u ,   1282623253u ,
298008106u ,   1657000625u ,   2009781145u ,   1421947380u ,   1286330022u ,   1559589183u ,
1049899240u ,   195061667u ,   414040701u ,   570250684u ,   1267047229u ,   1003846038u ,
1149491290u ,   975630072u ,   440564289u ,
;

\ fgen ( k -- g )   the generator of order 2^k.
: fgen ( k -- g )   2 lit lshift fgtab + be@ ;

\ ── Folding ──

: fpx variable ;   : fpch variable ;   : fpout variable ;
: ftav variable ;  : fta ( -- a )   ftav 10 lit lazy ;
: ftbv variable ;  : ftb ( -- a )   ftbv 10 lit lazy ;

\ fpair ( fx fnx x ch out -- )   one binary fold: with f(x) = e(x^2) + x o(x^2),
\        out = e + ch * o, where e = (f(x) + f(-x)) / 2, o = (f(x) - f(-x)) / 2x.
\        out may be fx or fnx.
: fpair ( fx fnx x ch out -- )
	fpout ! fpch ! fpx !
	2dup fta eadd  fta 1006632961u lit fta emulb       \ e  (1006632961 = 1/2)
	ftb esub  ftb fpx @ finv 1006632961u lit fmul ftb emulb
	fpch @ ftb ftb emul
	fta ftb fpout @ eadd
;

\ fleaf ( vals n j shift log ch -- )   fold a leaf's n values (a coset at
\        position j of a layer of 2^log points over shift * <g>) down to one,
\        with ch, ch^2, ...; the result is vals' first value.
: flv variable ;   : fln variable ;   : flj variable ;   : flsft variable ;
: fllog variable ; : flbv variable ;  : flb ( -- a )   flbv 10 lit lazy ;
: fleaf ( vals n j shift log ch -- )
	flb 4 lit cpy  fllog ! flsft ! flj ! fln ! flv !
	begin fln @ 1 lit u> while
		fllog @ fgen                                   ( g )
		fln @ 1 lit rshift 0 lit do
			dup flj @ i fllog @ fln @ log2 - lshift + fpow flsft @ fmul   ( g x )
			flv @ i 4 lit lshift +  dup fln @ 1 lit rshift 4 lit lshift +
			rot flb 3 lit pick fpair
		loop
		drop
		fln @ 1 lit rshift fln !
		flsft @ dup fmul flsft !
		fllog @ 1 lit - fllog !
		flb flb flb emul
	repeat
;

\ ── The proof ──

: ftr variable ;   : fls variable ;   : fsh variable ;   : flbu variable ;
: fnq variable ;   : fgb variable ;   : fnr variable ;   : fok variable ;
: fcheck ( flag -- )   0= if 0 lit fok ! then ;

\ Labels' elements.
: flr variable ;   : flf variable ;   : flfv variable ;   : flg variable ;
: flq variable ;

\ Per round: arity (bits), leaves, cap address and length, challenge.
: fbv variable ;   : fbits ( -- a )   fbv 40 lit lazy ;
: fvv variable ;   : fleav ( -- a )   fvv 40 lit lazy ;
: fcv variable ;   : fcaps ( -- a )   fcv 40 lit lazy ;
: fnv variable ;   : fcapn ( -- a )   fnv 40 lit lazy ;
: fchv variable ;  : fchs ( -- a )    fchv 100 lit lazy ;
: fb0v variable ;  : fb0 ( -- a )     fb0v 10 lit lazy ;
: ffnv variable ;  : ffin ( -- a )    ffnv 10 lit lazy ;
: fdgv variable ;  : fdig ( -- a )    fdgv 400 lit lazy ;   \ a cap, as cells
: fnon variable ;
: f@ ( a r -- x )   2 lit lshift + @ ;
: f! ( x a r -- )   2 lit lshift + ! ;

\ farity ( -- )   each round's arity and leaf count: the first fold takes the
\        layer to log_size - 1, then rounds of up to 3 bits down to log_blowup.
: farity ( -- )
	0 lit fnr !
	fls @ 1 lit -                                    ( log )
	begin dup flbu @ u> while
		dup flbu @ - dup 3 lit u> if drop 3 lit then  ( log bits )
		dup fbits fnr @ f!
		2dup - 1 lit swap lshift fleav fnr @ f!       \ leaves: 2^(log - bits)
		fnr @ 1 lit + fnr !
		-
	repeat
	drop
;

: fbeg ( tr log_size shift log_blowup queries grind_bits -- ok )
	fgb ! fnq ! flbu ! fsh ! fls ! ftr !
	-1 lit fok !
	"fri-round-root" tlab flr !   "fri-fold-challenge" tlab flf !
	"fri-final-value" tlab flfv !  "fri-grind" tlab flg !
	"fri-query-index" tlab flq !
	fls @ flbu @ u> fls @ 1C lit u< and fcheck
	fok @ if
		farity
		ftr @ flf @ fb0 tchal
		r32 fnr @ = fcheck
	then
	fok @ fnr @ and if
		fnr @ 0 lit do
			fok @ if
				r32 dup fleav i f@ dup 20 lit u> if drop 20 lit then = fcheck   ( n )
				dup 5 lit lshift rtake fcaps i f!
				dup fcapn i f!
				rbad @ 0= fcheck
				fok @ if
					fcaps i f@ fdig 2 lit pick 3 lit lshift ucells
					ftr @ flr @ fdig 3 lit pick 3 lit lshift tabs
					ftr @ flf @ fchs i 4 lit lshift + tchal
				then
				drop
			then
		loop
	then
	fok @ if
		10 lit rtake ffin 4 lit ucells
		ftr @ flfv @ ffin 4 lit tabs
		r32 fnon !  r32                                  ( nonce's high word )
		0= ftr @ flg @ fnon @ fgb @ tgrind and fcheck
		ftr @ flg @ fnon 1 lit tabs
		r32 fnq @ = fcheck
	then
	fok @ rbad @ 0= and
;

\ fqidx ( -- low )
: fqidx ( -- low )   ftr @ flq @ 1 lit fls @ 1 lit - lshift tindex ;

: fval variable ;  : fvalb ( -- a )   fval 10 lit lazy ;
: fvsv variable ;  : fvals ( -- a )   fvsv 80 lit lazy ;   \ a leaf: up to 8 values
: fp variable ;    : flsh variable ;  : flg2 variable ;    : fj variable ;
: fslot variable ;

: fquery ( fx fnx low -- ok )
	dup fp !
	fls @ fgen swap fpow fsh @ fmul                       ( fx fnx x )
	fb0 fvalb fpair
	r32 fnr @ = fcheck
	fsh @ dup fmul flsh !
	fls @ 1 lit - flg2 !
	fok @ fnr @ and if
		fnr @ 0 lit do
			fok @ if
				fp @  1 lit flg2 @ fbits i f@ - lshift 1 lit -  and fj !
				fp @  flg2 @ fbits i f@ - rshift fslot !
				ropen
				oidx @ fj @ = fcheck
				fok @ if fcaps i f@ fcapn i f@ fleav i f@ mvcap fcheck then
				olen @ 10 lit fbits i f@ lshift = fcheck
				fok @ if
					oleaf @ fvals 4 lit fbits i f@ lshift ucells
					fvals fslot @ 4 lit lshift + fvalb 4 lit ceq fcheck
					fvals 1 lit fbits i f@ lshift fj @ flsh @ flg2 @ fchs i 4 lit lshift + fleaf
					fvals fvalb 4 lit cpy
					fbits i f@ 0 lit do flsh @ dup fmul flsh ! loop
					flg2 @ fbits i f@ - flg2 !
					fj @ fp !
				then
			then
		loop
	then
	fok @ if fvalb ffin 4 lit ceq fcheck then
	fok @ rbad @ 0= and
;

\ ── Tests (./tools/fam --test src/poseidon2.fam src/ext.fam src/transcript.fam src/merkle.fam src/fri.fam) ──
