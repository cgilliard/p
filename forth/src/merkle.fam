		0 lit mleaf
		mh 643327251u lit 1341335401u lit 1900213177u lit 467996431u lit c4? assert
		mh 10 lit + 645788733u lit 495047509u lit 248744769u lit 1808139855u lit c4? assert
	}
	leaf_6 {
		6 lit alloc
		6 lit 0 lit do i D lit * 5 lit + over i + c! loop
		6 lit mleaf
		mh 1130772395u lit 169432994u lit 457305246u lit 1487634439u lit c4? assert
		mh 10 lit + 471632367u lit 990946341u lit 1525456405u lit 600588816u lit c4? assert
	}
