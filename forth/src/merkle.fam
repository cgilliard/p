\ ──────────────────────────────────────────────────────────────────────────────
\ src/merkle.fam — reading proof bytes, and checking Merkle openings against a
\ tree's cap (see ../rust/src/merkle.rs and the codec in ../rust/src/stark.rs).
\
\ Proof bytes are read where they lie.  An opening's one-byte depth leaves
\ what follows unaligned, so words are read a byte at a time (`u@`).  Every
\ read is bounds-checked: running past the end sets `rbad` (and stops
\ advancing), and verification fails if it's set.
\
\ Hashes: a leaf is `hash_octets(5, its byte length, its 4-byte words)` --
\ each block of up to 16 elements *overwrites* the rate's first whole
\ octets, then permutes; a node is `hash_pair(0x100 + level, left, right)`,
\ level counting from 1 just above the leaves.  Digests read from bytes are
\ reduced (`fred`); a computed hash is compared with a cap entry exactly.
\ ──────────────────────────────────────────────────────────────────────────────

\ u@ ( a -- w )   a little-endian word at any address.
: u@ ( a -- w )
	dup 3 lit + c@ 8 lit lshift over 2 lit + c@ or 8 lit lshift
	over 1 lit + c@ or 8 lit lshift swap c@ or
;

\ ucells ( src dst n -- )   n words from bytes at src, each reduced, into cells.
: ucells ( src dst n -- )
	0 lit do over i 2 lit lshift + u@ fred over i 2 lit lshift + ! loop 2drop
;

\ ueq ( a b n -- flag )   whether n words in bytes at a equal the cells at b.
: ueq ( a b n -- flag )
	-1 lit swap 0 lit do
		2 lit pick i 2 lit lshift + u@ 2 lit pick i 2 lit lshift + @ = and
	loop
	nip nip
;

\ pow2? ( x -- flag )   a nonzero power of two.   log2 ( x -- k )   of one.
: pow2? ( x -- flag )   dup 0= 0= swap dup 1 lit - and 0= and ;
: log2 ( x -- k )   0 lit begin over 1 lit u> while 1 lit + swap 1 lit rshift swap repeat nip ;

\ ── Reading ──

: rpos variable ;   : rend variable ;   : rbad variable ;

\ rinit ( a n -- )   start reading n bytes at a.
: rinit ( a n -- )   over + rend ! rpos ! 0 lit rbad ! ;

\ rtake ( n -- a )   the next n bytes' address; past the end, sets rbad and
\        doesn't advance.
: rtake ( n -- a )
	rpos @ swap over +                       ( a end )
	dup rend @ u> over 3 lit pick u< or if drop -1 lit rbad ! else rpos ! then
;

: r32 ( -- w )   4 lit rtake u@ ;
: r8 ( -- b )    1 lit rtake c@ ;

\ ── Openings ──

\ The opening last read: index, leaf (address, length), depth, siblings.
: oidx variable ;   : oleaf variable ;   : olen variable ;   : odep variable ;
: osib variable ;

\ ropen ( -- )   read an opening: index, leaf length and bytes, depth (one
\        byte), that many 32-byte sibling hashes.
: ropen ( -- )
	r32 oidx !
	r32 dup olen ! rtake oleaf !
	r8 dup odep ! 5 lit lshift rtake osib !
;

: mstv variable ;   : mst ( -- a )    mstv 60 lit lazy ;   \ hashing state
: mhv variable ;    : mh ( -- a )     mhv 20 lit lazy ;    \ the running hash
: msv variable ;    : msib ( -- a )   msv 20 lit lazy ;    \ a sibling, as cells

\ mleaf ( leaf len -- )   the hash of len bytes at leaf, into mh.
: mlb variable ;   : mll variable ;
: melem ( e -- x )   \ the leaf's element e: bytes 4e.., zero past its end
	2 lit lshift
	0 lit 4 lit 0 lit do
		over 3 lit i - + dup mll @ u< if mlb @ + c@ else drop 0 lit then
		swap 8 lit lshift or
	loop
	nip fred
;
: mleaf ( leaf len -- )
	mll ! mlb !
	mst 18 lit zero
	5 lit mst 40 lit + !                       \ capacity: DOMAIN_MERKLE_LEAF
	mll @ mst 44 lit + !                       \ and the byte length
	mll @ 3 lit + 2 lit rshift                 ( m: elements )
	dup 0= if mst p2perm then
	0 lit begin 2dup u> while                  ( m k )
		2dup - dup 10 lit u> if drop 10 lit then
		mst over 7 lit + 3 lit rshift 3 lit lshift zero    \ clear whole octets
		0 lit do dup i + melem mst i 2 lit lshift + ! loop
		mst p2perm
		10 lit +
	repeat
	2drop
	mst mh 8 lit cpy
;

\ mnode ( level l r -- )   the node over cells l and r, into mh.
: mnode ( level l r -- )
	mst 18 lit zero
	mst 20 lit + 8 lit cpy
	mst 8 lit cpy
	100 lit + mst 40 lit + !                   \ DOMAIN_MERKLE_NODE + level
	10 lit mst 44 lit + !
	mst p2perm
	mst mh 8 lit cpy
;

\ mvcap ( cap capn leaves -- flag )   whether the last opening read is in the
\        tree of `leaves` leaves whose top level is the capn hashes (bytes) at
\        cap: its path climbs log2(leaves / capn) levels to the cap.
: mcap variable ;   : mcn variable ;   : mlv variable ;
: mvcap ( cap capn leaves -- flag )
	mlv ! mcn ! mcap !
	rbad @ 0=  mcn @ pow2? and  mlv @ pow2? and  mcn @ mlv @ u> 0= and
	if
		mlv @ log2 mcn @ log2 -                ( path )
		dup odep @ = oidx @ mlv @ u< and if
			oleaf @ olen @ mleaf
			oidx @ swap                        ( index path )
			dup if
				0 lit do
					osib @ i 5 lit lshift + msib 8 lit ucells
					dup 1 lit and if i 1 lit + msib mh mnode else i 1 lit + mh msib mnode then
					1 lit rshift
				loop
			else drop then
			5 lit lshift mcap @ + mh 8 lit ueq
		else drop 0 lit then
	else 0 lit then
;

\ ── Tests (./tools/fam --test src/poseidon2.fam src/ext.fam src/transcript.fam src/merkle.fam) ──
\ Vectors and bytes from the Rust node: leaf hashes, and an opening of leaf 45
\ of a 64-leaf tree (36-byte leaves) against its 8-hash cap, as encoded in proofs.

\ mfix ( -- a n )   a cap, then an opening (401 bytes, as `,` emits them: in order).
: mfix ( -- a n )
97020000 ,   \ auipc t0,0
93824201 ,   \ addi  t0,t0,20
