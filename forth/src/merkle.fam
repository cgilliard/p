;

\ mcopy ( a n -- buf n )   a writable copy of a fixture.
: mcopy ( a n -- buf n )
	dup alloc swap                          ( a buf n )
	dup 0 lit do 2 lit pick i + c@ 2 lit pick i + c! loop
	rot drop
;

\ mopen ( buf n leaves -- flag )   read the cap and the opening, check it.
: mopen ( buf n leaves -- flag )
	-rot rinit
	r32 dup 5 lit lshift rtake swap           ( leaves cap capn )
	ropen
	rot mvcap
;

Test {
