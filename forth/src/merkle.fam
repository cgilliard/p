	opening {
		mfix mcopy 40 lit mopen assert
		oidx @ 2D lit asrt_eq
	}
	opening_tampered_leaf {
		mfix mcopy over 110 lit + dup c@ 1 lit xor swap c!  40 lit mopen 0 lit asrt_eq
	}
	opening_tampered_sibling {
		mfix mcopy over 135 lit + dup c@ 1 lit xor swap c!  40 lit mopen 0 lit asrt_eq
	}
	opening_wrong_size {
		mfix mcopy 80 lit mopen 0 lit asrt_eq
	}
	read_past_end {
		mfix mcopy 1 lit - 40 lit mopen 0 lit asrt_eq
		rbad @ assert
	}
}
