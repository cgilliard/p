\ ──────────────────────────────────────────────────────────────────────────────
\ src/pay.fam — paying a payment address: the slates exchanged end to end,
\ encrypted, through the relays (src/relay.fam; they read nothing).
\
\ One round trip.  PAY1, sender to receiver: a one-time Kyber key pair is
\ made; the receiver's Kyber key (from its record) gets a key encapsulated
\ (k1); the box holds the sender's own address and S1.  PAY2, back: the
\ receiver answers S1 (S2), and encapsulates a second key (k2) to the one-time
\ key; its box holds a status and S2.  The sender finalizes, and the
\ transaction goes to the network.  The one-time key is thrown away, so S2 is
\ forward secret; PAY1 rests on the receiver's key (as Noise's NK).
\
\   PAY1: 0 "PAY1"  4 sid (8)  C ct1 (0x300)  30C the one-time key (0x320)
\         62C the box: our address (32), S1 -- then its tag (16)
\   PAY2: 0 "PAY2"  4 sid  C ct2 (0x300)  30C the box: status (0 answered,
\         else a reason, as text), S2 -- then its tag
\   th = SHA3-256(bytes 4 .. 62C of PAY1)
\   K1 = SHAKE256("tabernacle-pay1-v1" ‖ k1 ‖ th, 32)
\   K2 = SHAKE256("tabernacle-pay2-v1" ‖ k1 ‖ k2 ‖ th ‖ ct2, 32)
\ Each box: ChaCha20-Poly1305 under its key (used once: the nonce zeros), the
\ message's first 12 bytes as associated data.
\
\ A message goes in parts: id (4), part, parts, up to 0x3E0 bytes -- each
\ RELAYed by every relay the sender uses, DELIVERed by the one that keeps
\ the receiver (by circuit, in listed mode: src/onion.fam).  Up to 40
\ parts (S1 of a dozen or more inputs).
\
\   pzpay ( addr alo ahi flo fhi -- ok )   start paying (one at a time)
\   pzst ( -- a )        0 none, 1 finding the address, 2 sending, 3 paid
\                        (pztxid), 4 failed (pzwhy)
\   pzin ( -- f )        a DELIVER: handled
\   pzcin ( -- f )       a circuit's datagram (src/onion.fam), a DELIVER
\                        along one of ours handled
\   pztick ( -- )
\
\ Our transaction, in listed mode (circuits), never goes out from this node
\ first: it's SUBMITted (src/onion.fam) through a circuit of its own to a
\ relay chosen at random -- not one of the receiver's home relays, when the
\ list has another -- which takes it into its pool and announces it as any.
\ It's done once a peer announces it to us; not heard of in a minute, sent
\ again, by another circuit.  Out of listed mode (or with userelay=,
\ `direct`) it's announced as before.  A finalized slate file's transaction
\ (src/api.fam) is announced as before; at a start, the wallet's unconfirmed
\ ones go as by-address payments' do.
\   SUBMIT (C)     part, parts, up to 0x438 bytes of the transaction
\   SUBMITTED (D)  status: 0 taken into the pool, 1 not (known, invalid, no
\                  room)
\ ──────────────────────────────────────────────────────────────────────────────

: pzmax ( -- n )   A000 lit ;                              \ a message, at most
: pzmv variable ;  : pzm ( -- a )  pzmv A000 lit lazy ;     \ one being sent
: pzpv variable ;  : pzpt ( -- a )  pzpv A000 lit lazy ;    \ a box's contents
: pzst variable ;  : pzwhy variable ;
: pzkv variable ;  : pzk ( -- a )  pzkv 100 lit lazy ;     \ 0 k1, 20 k2, 40 th, 60 the key, 80 a nonce (zeros), A0 random
: pzekv variable ;  : pzek ( -- a )  pzekv 320 lit lazy ;  \ the one-time key pair
: pzdkv variable ;  : pzdk ( -- a )  pzdkv 660 lit lazy ;
: pzsdv variable ;  : pzsid ( -- a )  pzsdv 8 lit lazy ;   \ our payment's session
: pzdsv variable ;  : pzdest ( -- a )  pzdsv 20 lit lazy ; \ its address
: pzslv variable ;  : pzslid ( -- a )  pzslv 10 lit lazy ; \ its slate's id
: pztxv variable ;  : pztxid ( -- a )  pztxv 20 lit lazy ;
: pzal variable ;  : pzah variable ;  : pzfl variable ;  : pzfh variable ;
: pzn variable ;  : pzmid variable ;  : pzt variable ;  : pztry variable ;  : pzslm variable ;

: pzrand ( a n -- )   2dup rnget if 2drop else nzero then ;

\ pzkey ( tag n extra en -- )   the key at pzk + 60: SHAKE256(tag ‖ k1 ‖
\        [k2] ‖ th ‖ extra), k2 if en is 0x300 (PAY2's).
: pzex variable ;  : pzen variable ;
: pzkey ( tag n extra en -- )
	pzen ! pzex !
	88 lit 1F lit kbeg  kabs  pzk 20 lit kabs
	pzen @ if pzk 20 lit + 20 lit kabs then
	pzk 40 lit + 20 lit kabs
	pzen @ if pzex @ pzen @ kabs then
	kend  pzk 60 lit + 20 lit ksqz
;
: pzk1 ( -- )   "tabernacle-pay1-v1" 12 lit 0 lit 0 lit pzkey ;
: pzk2 ( ct2 -- )   "tabernacle-pay2-v1" 12 lit rot 300 lit pzkey ;
: pzth ( msg -- )   4 lit + 628 lit pzk 40 lit + sha3256 ;
: pzz ( -- a )   pzk 80 lit + dup C lit nzero ;            \ the nonce: zeros

\ ── Parts ──

\ pzsend ( msg n dest -- )   the message, RELAYed for dest by each of its
\        relays (src/rlist.fam: rqtgt; those that have answered us),
\        every part.
: pzsm variable ;  : pzsn variable ;  : pzsd variable ;  : pzsp variable ;  : pzsk variable ;  : pzsl variable ;
: pzsend ( msg n dest -- )
	pzsd ! pzsn ! pzsm !
	pzsn @ 3DF lit + 3E0 lit / pzsp !
	rlcirc @ if pzsm @ pzsn @ pzsd @ pzmid @ onsend else
	pzsd @ rqtgt
	rltn @ ?dup if 0 lit do
		i rltpeer dup 0< if drop else pzsk !
			pzsp @ 0 lit do
				14 lit phdr  pzsk @ pp C lit + @ pzsk @ pp 10 lit + @ 2 lit pick qbe!
				pzsd @ over 8 lit + 20 lit ncpy  28 lit +
				pzmid @ over be!  i over 4 lit + c!  pzsp @ over 5 lit + c!  6 lit +
				pzsn @ i 3E0 lit * - 3E0 lit pumin pzsl !
				pzsm @ i 3E0 lit * + swap pzsl @ ncpy
				pzsk @ 34 lit pzsl @ + psendk
			loop
		then
	loop then then
;

\ Reassembly: 2 slots: 0 the id, 4 parts, 8 parts had (bits, two cells),
\ 10 when begun, then the bytes (from 0x20).
: pzrv variable ;  : pzr ( k -- a )  A020 lit * pzrv 14040 lit lazy + ;
: pzra variable ;  : pzid variable ;  : pzpi variable ;  : pzpc variable ;
\ pzmask ( n -- lo hi )   n bits set (n <= 64).
: pzmask ( n -- lo hi )
	dup 20 lit u< if 1 lit swap lshift 1 lit - 0 lit else 20 lit - dup 20 lit u< if -1 lit swap 1 lit swap lshift 1 lit - else drop -1 lit -1 lit then then
;
\ pzpart ( -- msg n | 0 )   a DELIVERed part: into its slot; the message,
\        whole.
: pzpart ( -- msg n | 0 )
	pbd @ be32 pzid !  pbd @ 4 lit + c@ pzpi !  pbd @ 5 lit + c@ pzpc !
	pzpi @ pzpc @ u<  pzpc @ 29 lit u< and  pbn @ 6 lit u> and  pbn @ 6 lit - 3E1 lit u< and 0= if 0 lit else
		0 lit pzra !                                                         \ (an address: above 2^31, so not "negative")
		2 lit 0 lit do i pzr @ pzid @ =  i pzr 4 lit + @ 0= 0= and if i pzr pzra ! then loop
		pzra @ 0= if                                                         \ a new message: in the older slot
			0 lit pzr 10 lit + @  1 lit pzr 10 lit + @ - 0< if 0 lit else 1 lit then pzr pzra !
			pzra @ 8 lit zero
			pzid @ pzra @ !  pzpc @ pzra @ 4 lit + !  pms pzra @ 10 lit + !
		then
		pbd @ 6 lit +  pzra @ 20 lit + pzpi @ 3E0 lit * +  pbn @ 6 lit - ncpy
		pzpi @ 20 lit u< if 1 lit pzpi @ lshift pzra @ 8 lit + dup @ rot or swap !
		else 1 lit pzpi @ 20 lit - lshift pzra @ C lit + dup @ rot or swap ! then
		pzpi @ 1 lit + pzpc @ = if pzpi @ 3E0 lit * pbn @ 6 lit - + pzra @ 14 lit + ! then
		pzra @ 4 lit + @ pzmask  pzra @ C lit + @ =  swap pzra @ 8 lit + @ = and  pzra @ 14 lit + @ 0= 0= and if
			0 lit pzra @ 4 lit + !  pzra @ 20 lit +  pzra @ 14 lit + @                 \ whole; the slot free
		else 0 lit then
	then
;

\ ── Receiving: PAY1 -> PAY2 ──
\ The last answer is kept: a PAY1 sent again (its PAY2 lost) is answered
\ the same, not received twice.

: pzlsv variable ;  : pzlsid ( -- a )  pzlsv 8 lit lazy ;   \ the last PAY1 answered
: pzldv variable ;  : pzldst ( -- a )  pzldv 20 lit lazy ;  \ its sender
: pzlav variable ;  : pzlast ( -- a )  pzlav A000 lit lazy ; \ the PAY2
: pzln variable ;
: pzwhv variable ;  : pzwho ( -- a )  pzwhv 80 lit lazy ;   \ an address, as text

\ pzlog ( s addr -- )   a line: the text, then the address (32 bytes) as text.
: pzn5 variable ;
: pzlog ( s addr -- )
	1 lit pad5 c!  20 lit pad5 1 lit + bm5 1 lit + pzn5 !
	pahrp pad5 pzn5 @ pzwho bmenc  pzwho + 0 lit swap c!
	lputs pzwho lputs A lit lputc
;

\ pzregd ( -- f )   some relay holds our record (so an answer can reach us).
: pzregd ( -- f )   0 lit rlgn @ ?dup if 0 lit do i rlg 8 lit + @ or loop then ;

: pzmsg variable ;  : pzok variable ;  : pzl variable ;  : pzlat variable ;

\ ── Submitting by circuit ──
\ 4 waiting, each 0 state (0 free, 1 to send, 2 sent)  4 its bytes  8 when
\ sent  C tries  10 the receiver's address (zeros: none)  30 its id  50 the
\ transaction.

: psqv variable ;  : psq ( j -- a )  10050 lit * psqv 40140 lit lazy + ;
: psj variable ;  : pso variable ;
: psrv variable ;  : psrb ( -- a )  psrv 4 lit lazy ;

\ psid ( a n out -- )   a transaction's id.
: psid ( a n out -- )   pso !  tkst -rot p2hashb  tkst pso @ 8 lit cpy ;

\ pssub ( a n dest -- )   a transaction to submit (dest: the receiver's
\        address, or 0).
: pssub ( a n dest -- )
	-1 lit psj !  4 lit 0 lit do psj @ 0< i psq @ 0= and if i psj ! then loop
	psj @ 0< if drop 2drop "transaction: too many waiting to be submitted\n" lputs else
		psj @ psq 10 lit + over if 20 lit ncpy else nip 20 lit nzero then
		2dup psj @ psq 30 lit + psid
		dup psj @ psq 4 lit + !  psj @ psq 50 lit + swap ncpy
		1 lit psj @ psq !  0 lit psj @ psq 8 lit + !  0 lit psj @ psq C lit + !
	then
;

\ pstarg ( j -- )   circuit 9 wanted, to a relay whose key we have: at
\        random, not one of slot j's receiver's home relays if there's another.
: psqn variable ;  : psqk variable ;
: psok? ( i -- f )
	dup cnhas? if
		dup ocmap swap ocport  0 lit  rqdn @ ?dup if 0 lit do i rqd @ 3 lit pick = i rqd 4 lit + @ 3 lit pick = and or loop then
		nip nip 0=
	else drop 0 lit then
;
: pstarg ( j -- )
	0 lit rqdn !  psq 10 lit + dup 20 lit rqzero? if drop else rqseed rqhome then
	0 lit psqn !  cnn @ ?dup if 0 lit do i psok? if psqn @ 1 lit + psqn ! then loop then
	psqn @ 0= if 0 lit rqdn !  cnn @ ?dup if 0 lit do i psok? if psqn @ 1 lit + psqn ! then loop then then
	psqn @ if
		pnonce drop 1 lit rshift psqn @ % psqk !  -1 lit
		cnn @ 0 lit do dup 0< i psok? and if psqk @ if psqk @ 1 lit - psqk ! else drop i then then loop
		9 lit occ !  dup ocmap ochi !  ocport ochp !  0 lit ocft !  3 lit ocst !  0 lit occ !
	then
;

\ pssend ( j -- )   its parts, SUBMITted along circuit 9 (padded to a power
\        of two, with parts numbered 0xFF).
: psqp variable ;  : psql variable ;
: pssend ( j -- )
	9 lit occ !
	dup psq 4 lit + @ 437 lit + 438 lit / psqp !
	psqp @ 0 lit do
		i ocx c!  psqp @ ocx 1 lit + c!
		dup psq 4 lit + @ i 438 lit * - 438 lit pumin psql !
		dup psq 50 lit + i 438 lit * + ocx 2 lit + psql @ ncpy
		C lit ocx psql @ 2 lit + ocsendc
	loop
	psqp @ ocpw psqp @ - ?dup if 0 lit do
		FF lit ocx c!  psqp @ ocx 1 lit + c!  ocx 2 lit + 438 lit nzero  C lit ocx 43A lit ocsendc
	loop then
	dup psq C lit + @ 1 lit + over psq C lit + !
	"transaction: submitted by circuit, to " lputs ochere " (try " lputs psq C lit + @ fndec ")" lputs A lit lputc
	0 lit occ !
;

\ psadm ( j -- )   a whole one, at a relay: into the pool, announced; the
\        circuit answered (if it's still there).
: psadm ( j -- )
	dup onsb 20 lit + over onsb 18 lit + @ txadmit
	dup 0< if drop 1 lit else -1 lit txskip ! txann 0 lit then  psrb c!
	"circuit: a transaction submitted (" lputs dup onsb 18 lit + @ fndec " bytes): " lputs
	psrb c@ if "not taken" else "taken, announced" then lputs A lit lputc
	dup onsb @ 1 lit -  dup onmax u< if dup onc @ 2 lit =  over onc C lit + @ 3 lit pick onsb 4 lit + @ = and else 0 lit then
	if D lit psrb 1 lit onback else drop then
	0 lit over onsb !  0 lit swap onsb 1C lit + !
;

\ psmine ( -- )   at a start, once the mode's known: the wallet's signed,
\        unconfirmed transactions, submitted (listed mode) or into the pool.
: psmine ( -- )
	trk 20 lit nzero
	begin treach while
		trpend? if
			wsr 10 lit + @ wtx sbget wtn !
			oncirc if wtx wtn @ 0 lit pssub else wtx wtn @ txadmit drop then
		then
	repeat
;

\ pstick ( -- )
: psone ( j -- )
	dup psq 30 lit + txhas 0< 0= if
		"transaction: on the network (a peer announced it to us)\n" lputs  0 lit swap psq !
	else oncirc 0= rqst @ and if
		dup psq 50 lit + over psq 4 lit + @ txadmit dup 0< if drop else -1 lit txskip ! txann then
		"transaction: announced to our peers (no circuits)\n" lputs  0 lit swap psq !
	else drop then then
;
: pstick ( -- )
	2 lit 0 lit do i onsb 1C lit + @ if i psadm then loop
	trmn @ rqst @ and if 0 lit trmn !  psmine then
	onsubr @ ?dup if
		0 lit onsubr !  1 lit - if "transaction: the relay didn't take it (it may have it already)" else
		"transaction: the relay took it, and announced it" then lputs A lit lputc
	then
	4 lit 0 lit do i psq @ if i psone then loop
	oncirc if
		-1 lit  4 lit 0 lit do dup 0< i psq @ and if drop i then loop
		dup 0< if drop  9 lit ocab @ 2 lit = if 0 lit 9 lit ocab ! then else
			dup psq @ 2 lit =  over psq 8 lit + @ pago EA60 lit u> and if 1 lit over psq !  0 lit 9 lit ocab ! then
			dup psq @ 1 lit = if
				9 lit ocab @ 2 lit = if dup pssend  2 lit over psq !  pms over psq 8 lit + ! else
				9 lit ocab @ 0=  9 lit ocab 120 lit + @ pago 1388 lit u> and if dup pstarg then then
			then
			drop
		then
	then
;

\ pzpay1 ( msg n -- )   a PAY1: opened, S1 answered (or refused), PAY2 back
\        -- a new one at most every 2 s (each makes a slate's record).
: pzpay1 ( msg n -- )
	pzn ! pzmsg !
	pzn @ 6A5 lit u< 0=  wl? and if                                     \ 0x62C + 32 + 0x29 + 16 at least
		pzmsg @ 4 lit + pzlsid 8 lit mcmp 0= pzln @ and if                 \ answered already: again
			pzk A0 lit + 4 lit pzrand  pzk A0 lit + be32 pzmid !
			pzlast pzln @ pzldst pzsend
		else pzlat @ pago 7D0 lit u> if                                     \ a new one at most every 2 s
			pms pzlat !  pakeys
			padk pzmsg @ C lit + pzk kydecap drop                          \ k1 (a wrong one: the box won't open)
			pzmsg @ pzth  pzk1
			pzk 60 lit + pzz pzmsg @ C lit  pzmsg @ 62C lit +  pzn @ 63C lit -  pzpt aeopen if
				pzpt pzldst 20 lit ncpy
				pzpt 20 lit +  pzn @ 65C lit -  wsrecv pzok !                \ S2, at wsb
				50415932 lit pzm be!  pzmsg @ 4 lit + pzm 4 lit + 8 lit ncpy
				pzk A0 lit + 20 lit pzrand
				pzmsg @ 30C lit +  pzk A0 lit +  pzk 20 lit +  pzm C lit +  kyencap if     \ k2
					pzm C lit + pzk2
					pzok @ if 0 lit pzpt c!  wsb pzpt 1 lit + wsn @ ncpy  wsn @ 1 lit + pzl !
					else 1 lit pzpt c!  wserr @ ?dup 0= if "refused" then dup strlen 40 lit pumin dup 1 lit + pzl !  pzpt 1 lit + swap ncpy then
					pzk 60 lit + pzz pzm C lit  pzpt pzl @  pzm 30C lit + aeseal
					pzl @ 31C lit + pzln !
					pzm pzlast pzln @ ncpy  pzmsg @ 4 lit + pzlsid 8 lit ncpy
					pzk A0 lit + 4 lit pzrand  pzk A0 lit + be32 pzmid !
					pzlast pzln @ pzldst pzsend
					pzok @ if "payment: received one, answered: from " else "payment: refused one: from " then pzldst pzlog
				then
			else "payment: a message that doesn't open: dropped\n" lputs then
		then then
	then
;

\ ── Paying ──

\ pzfail ( s -- )   the payment failed (why); its slate cancelled, the coins
\        free again.
: pzfail ( s -- )
	pzwhy !  4 lit pzst !
	pzslm @ if pzslid wscancel drop  0 lit pzslm ! then
	"payment: failed: " lputs pzwhy @ lputs A lit lputc
;

: pzwbv variable ;  : pzwb ( -- a )  pzwbv 48 lit lazy ;     \ the receiver's reason

\ pzpay2 ( msg n -- )   a PAY2 for our payment: opened, S2 finalized, the
\        transaction to the network.
: pzpay2 ( msg n -- )
	pzn ! pzmsg !
	pzst @ 2 lit =  pzmsg @ 4 lit + pzsid 8 lit mcmp 0= and  pzn @ 31D lit u< 0= and if
		pzdk pzmsg @ C lit + pzk 20 lit + kydecap drop                    \ k2
		pzmsg @ C lit + pzk2
		pzk 60 lit + pzz pzmsg @ C lit  pzmsg @ 30C lit +  pzn @ 31C lit -  pzpt aeopen if
			pzpt c@ if
				pzwb 48 lit nzero  "the receiver refused it: " pzwb 19 lit ncpy  pzpt 1 lit + pzwb 19 lit + pzn @ 31D lit - 2E lit pumin ncpy
				pzwb pzfail
			else
				pzpt 1 lit +  pzn @ 31D lit -  wsfin if
					0 lit pzslm !  oncirc if wtx wtn @ pzdest pssub else trsoon then
					wtid pztxid 20 lit ncpy  3 lit pzst !
					"payment: paid, the transaction sent: to " pzdest pzlog
				else wserr @ ?dup 0= if "the answer didn't finalize" then pzfail then
			then
		then
	then
;

\ pzpay ( addr alo ahi flo fhi -- ok )   start paying addr (its 32 bytes):
\        the amount and fee in units.
: pzpay ( addr alo ahi flo fhi -- ok )
	pzst @ 1 lit = pzst @ 2 lit = or if 2drop 2drop drop 0 lit else
		pzfh ! pzfl ! pzah ! pzal !  pzdest 20 lit ncpy
		0 lit pzslm !  0 lit pzwhy !  pztxid 20 lit nzero
		pzdest rqtgt  pzdest rllook  1 lit pzst !  pms pzt !  -1 lit
	then
;

\ pzbuild ( -- )   the address found: S1, the one-time key, PAY1, sent.
: pzbuild ( -- )
	pzal @ pzah @ pzfl @ pzfh @ wssend 0= if wserr @ ?dup 0= if "couldn't make the slate" then pzfail else
		-1 lit pzslm !  wsb 7 lit + pzslid 10 lit ncpy
		50415931 lit pzm be!
		pzsid 8 lit pzrand  pzsid pzm 4 lit + 8 lit ncpy
		pzk A0 lit + 40 lit pzrand  pzk A0 lit + pzek pzdk kykeys            \ the one-time key pair
		pzk A0 lit + 20 lit pzrand
		rlrec 18 lit +  pzk A0 lit +  pzk  pzm C lit +  kyencap 0= if "the receiver's key is refused" pzfail else
			pzek pzm 30C lit + 320 lit ncpy
			pzm pzth  pzk1
			paid pzpt 20 lit ncpy  wsb pzpt 20 lit + wsn @ ncpy
			pzk 60 lit + pzz pzm C lit  pzpt wsn @ 20 lit +  pzm 62C lit + aeseal
			wsn @ 65C lit + pzl !
			pzk A0 lit + 4 lit pzrand  pzk A0 lit + be32 pzmid !
			pzm pzl @ pzdest pzsend  pms pzt !  1 lit pztry !  2 lit pzst !
		then
	then
;

: pztick ( -- )
	pstick
	pzst @ 1 lit = if
		rllst @ 3 lit = if "the address isn't registered with our relays" pzfail else
		rlfound rlla pzdest 20 lit mcmp 0= and pzregd and if pzbuild else
		pzt @ pago EA60 lit u> if "timed out finding the address (or registering ours)" pzfail then
		then then
	then
	pzst @ 2 lit = if pzt @ pago 1388 lit u> if
		pztry @ C lit u< if pzm pzl @ pzdest pzsend  pms pzt !  pztry @ 1 lit + pztry !       \ for a minute
		else "no answer from the receiver" pzfail then
	then then
;

\ pzgot ( -- )   a DELIVERed part (pbd, pbn); a whole PAY1 or PAY2, handled.
: pzgot ( -- )
	pzpart ?dup if
		over be32 50415931 lit = if pzpay1 else
		over be32 50415932 lit = if pzpay2 else 2drop then then
	then
;

\ pzin ( -- f )   DELIVER (from one of our relays): a part.
: pzgw? ( -- f )   0 lit rlgn @ ?dup if 0 lit do i rlg @ nsrc @ = i rlg 4 lit + @ nsport @ = and or loop then ;
: pzin ( -- f )
	pok? if npay @ 5 lit + c@ 15 lit = else 0 lit then
	dup if
		npay @ 6 lit + pbody npn @ 6 lit - ncpy  pbody pbd !  npn @ 6 lit - pbn !
		pzgw? if pzgot then
	then
;

\ pzcin ( -- f )   a circuit's datagram (src/onion.fam: onin); a part
\        DELIVERed along one of ours for receiving, handled.
: pzcin ( -- f )
	onin dup if ondn @ ?dup if pbn !  ondb pbd !  0 lit ondn !  pzgot then then
;
