\ ──────────────────────────────────────────────────────────────────────────────
\ src/full_node.fam — the node: read its settings, open the disk (the chain
\ and state carry over between runs), open its wallet (or make or restore
\ one, on the console: src/wallet.fam), start the network, and keep in step
\ with its peers, saying what it's doing.
\
\ Settings arrive on the serial input (after tabernacle's own line, when
\ booted by it), ended by EOT (0x04), separated by spaces:
\   seed=A.B.C.D:PORT   a host to start from (any number; 127.x.x.x is the
\                       host machine, reached through QEMU's gateway)
\   port=N              our UDP port (3737)
\   depth=N             fast sync: start N blocks behind the best peer, on a
\                       node with nothing past genesis (25; 0: never)
\   net=main | net=dev  the network (main)
\   recover             restore the wallet from its backup words (typed next,
\                       on the console), on a disk that has none
\   passphrase          a new wallet's passphrase, or a restored one's, typed
\                       on the console
\   api=N               the wallet API's UDP port (our port + 1: src/wapi.fam)
\   peers=N             the most hosts kept (256; at most 1,000: src/peer.fam)
\   probe=S             every host asked for hosts every S seconds (60)
\   perip=N             the most hosts kept with one IP address (4)
\   apikey              show the wallet's API key (tools/wallet asks for it)
\ ──────────────────────────────────────────────────────────────────────────────

: fncv variable ;  : fncfg ( -- a )  fncv 400 lit lazy ;
: fncn variable ;  : fnp variable ;

\ fnread ( -- )   the settings, up to EOT.
: fnread ( -- )
	0 lit fncn !
	begin getc dup 4 lit = 0= while
		fncn @ 3FF lit u< if fncfg fncn @ + c!  fncn @ 1 lit + fncn ! else drop then
	repeat drop
	0 lit fncfg fncn @ + c!  0 lit fnp !
;

: fnc ( -- c )   fncfg fnp @ + c@ ;                  \ the next character
: fn+ ( -- )     fnp @ 1 lit + fnp ! ;

\ fnpre? ( s -- f )   whether the setting at fnp starts with string s (then
\        skipped).
: fnpre? ( s -- f )
	0 lit  begin over over + c@ dup if fncfg fnp @ + 2 lit pick + c@ = else drop 0 lit then while 1 lit + repeat
	over over + c@ 0= if fnp @ + fnp ! drop -1 lit else 2drop 0 lit then
;

\ fnnum ( -- n )   a decimal number.
: fnnum ( -- n )
	0 lit  begin fnc 30 lit - A lit u< while A lit * fnc 30 lit - + fn+ repeat
;

\ fnip ( -- ip port )   A.B.C.D:PORT
: fnip ( -- ip port )
	fnnum  3 lit 0 lit do fn+ 8 lit lshift fnnum or loop
	fn+ fnnum
;

: fnbad ( -- )   "node: a setting it doesn't know: " lputs  fncfg fnp @ + lputs  A lit lputc bye ;

\ fnparse ( -- )
: fnparse ( -- )
	begin
		begin fnc 20 lit = fnc A lit = or fnc D lit = or fnc 9 lit = or while fn+ repeat
		fnc
	while
		"seed=" fnpre? if
			fnip over 18 lit rshift 7F lit = if nip A000202 lit swap then pseed
		else "port=" fnpre? if fnnum nport !
		else "depth=" fnpre? if fnnum pfdep !
		else "net=dev" fnpre? if 1 lit bnet !
		else "net=main" fnpre? if 0 lit bnet !
		else "recover" fnpre? if -1 lit wlrec !
		else "passphrase" fnpre? if -1 lit wlpass !
		else "api=" fnpre? if fnnum naport !
		else "peers=" fnpre? if fnnum 3E8 lit pumin dup 0= if drop 1 lit then ppmx !
		else "probe=" fnpre? if fnnum 3E8 lit * dup 0= if drop 3E8 lit then pprb !
		else "perip=" fnpre? if fnnum dup 0= if drop 1 lit then ppip !
		else "apikey" fnpre? if -1 lit wlshowk !
		else fnbad then then then then then then then then then then then then
	repeat
;

\ ── Saying what it's doing ──

: fnnib ( n -- )   F lit and dup A lit u< if 30 lit + else 57 lit + then lputc ;
: fnhex ( a n -- )   0 lit do dup i + c@ dup 4 lit rshift fnnib fnnib loop drop ;

: fnth variable ;  : fnhv variable ;  : fnhash ( -- a )  fnhv 20 lit lazy ;
: fnfs variable ;  : fnpc variable ;  : fnph variable ;

\ fnpeers ( -- n )   peers that have answered.
: fnpeers ( -- n )   0 lit ppn 0 lit do i pp 8 lit + @ 2 lit = if 1 lit + then loop ;

\ fnsay ( -- )   a line whenever the tip, the fast sync's phase or the peers
\        answering change.
: fnsay ( -- )
	dbtip ?dup if
		dup fnhash 8 lit ceq 0= if
			dup fnhash 8 lit cpy
			"tip: height " lputs dup 20 lit + @ fndec  "  " lputs  dup 6 lit fnhex
			"  outputs " lputs dup 70 lit + @ fndec  A lit lputc
		then drop
	then
	pfsv @ fnfs @ = 0= if
		pfsv @ dup fnfs !
		dup 1 lit = if "fast sync: waiting to hear a peer's height\n" lputs then
		dup 2 lit = if "fast sync: fetching blocks " lputs pq @ fndec " and " lputs pq @ 1 lit + fndec A lit lputc then
		dup 3 lit = if "fast sync: checking the sync point's chain proof\n" lputs then
		dup 4 lit = if "fast sync: downloading the state, piece by piece\n" lputs then
		0= if "syncing block by block\n" lputs then
	then
	fnpeers dup fnpc @ = 0= if dup fnpc ! "peers: " lputs fndec A lit lputc else drop then
	0 lit pbest dup 0< if drop else
		pp 28 lit + @ dup fnph @ = if drop else dup fnph ! "best peer: height " lputs fndec A lit lputc then
	then
;

\ ── Running ──

\ fnstep ( -- )   the datagrams that have come (the peers', the wallet API's,
\        the transaction relay's, the boot image's), then the timers.
: fnstep ( -- )
	begin nrecv while ndport @ naport @ = if wain else txin 0= if imin 0= if pin then then then repeat
	ptick txtick
;

\ ── Time-sharing: the yield ──
\ Every 256th permutation (src/poseidon2.fam: p2hook, every few tens of ms
\ while a block is checked or applied) comes here: the datagrams waiting are
\ handled -- only what needs no disk and starts nothing big (hosts, peers'
\ heights, the boot image, the block cached for serving); the rest is
\ dropped, and asked again -- and the timers that ask peers, before going
\ back.  The datagram (and its body) the interrupted code may be in the
\ middle of is put back as it was.
\ The rule for anything a yield runs: touch nothing the interrupted work may
\ be using -- above all a hash's variables (p2hash, p2hashb, hbytes, os+:
\ the work is inside one of those whenever it yields).  A keyed hash in a
\ yield is phk's own permutation, never the sponge.  tests/net.fam's
\ net_yield_keeps_a_hash runs a long hash with the yield on and probing, and
\ checks it comes out the same.

: fnlive variable ;                                   \ the node is running (not the tests)
: pybsy variable ;  : pyt variable ;
: pysv variable ;  : pysave ( -- a )  pysv 4F0 lit lazy ;   \ the datagram, and its body

\ pyhold / pyback ( -- )   save / restore the received datagram's state.
: pyhold ( -- )
	nsrc @ pysave !  nsport @ pysave 4 lit + !  ndport @ pysave 8 lit + !
	npay @ pysave C lit + !  npn @ pysave 10 lit + !  nheld @ pysave 14 lit + !
	nrid @ pysave 18 lit + !  nsfrom @ pysave 1C lit + !
	pbd @ pysave 20 lit + !  pbn @ pysave 24 lit + !
	pbody pysave 40 lit + 4B0 lit ncpy
	0 lit nheld !                                     \ not ours to free
;
: pyback ( -- )
	nheld @ if nfree then                             \ our last datagram
	pysave @ nsrc !  pysave 4 lit + @ nsport !  pysave 8 lit + @ ndport !
	pysave C lit + @ npay !  pysave 10 lit + @ npn !  pysave 14 lit + @ nheld !
	pysave 18 lit + @ nrid !  pysave 1C lit + @ nsfrom !
	pysave 20 lit + @ pbd !  pysave 24 lit + @ pbn !
	pysave 40 lit + pbody 4B0 lit ncpy
;

\ pydgram ( -- )   a datagram, in a yield.
: pydgram ( -- )
	ndport @ naport @ = 0= if                         \ (the wallet's: dropped)
		imin 0= if                                    \ the boot image
			pok? if
				npay @ 5 lit + c@  dup 1 lit = over 2 lit = or over 3 lit = or swap 5 lit = or
				if pin then                               \ hosts, heights, a cached block
			then
		then
	then
;

: pyield ( -- )
	fnlive @ pybsy @ 0= and if
		-1 lit pybsy !  -1 lit pyl !  p2off @ 1 lit + p2off !
		pyhold
		begin nrecv while pydgram repeat
		pyback
		pyt @ pago 64 lit u> if pms pyt !  pdisc pheights then   \ asking peers, a tenth of a second apart
		p2off @ 1 lit - p2off !  0 lit pyl !  0 lit pybsy !
	then
;

\ hookp2 ( C: -- )   compile time: point p2hook here (src/hookp2.S, assembled
\        by tools/s2words.py).
:I hookp2
373F686F ,   \ lui t5,0x6f683
130F0F27 ,   \ addi t5,t5,624 # 6f683270 <__global_pointer$+0x6f6819a4>
B77F0000 ,   \ lui t6,0x7
938FFFB6 ,   \ addi t6,t6,-1169 # 6b6f <__global_pointer$+0x52a3>
93820B00 ,   \ addi t0,s7,0
63F86209 ,   \ bgeu t0,s6,a4 <fail>
03A30200 ,   \ lw t1,0(t0)
6310E303 ,   \ bne t1,t5,3c <next>
03A34200 ,   \ lw t1,4(t0)
631CF301 ,   \ bne t1,t6,3c <next>
03A38200 ,   \ lw t1,8(t0)
93031000 ,   \ addi t2,zero,1
63167300 ,   \ bne t1,t2,3c <next>
83A2C200 ,   \ lw t0,12(t0)
6F00C000 ,   \ jal zero,44 <found>
93824201 ,   \ addi t0,t0,20
6FF05FFD ,   \ jal zero,14 <look>
33835140 ,   \ sub t1,gp,t0
93534341 ,   \ srai t2,t1,0x14
63860300 ,   \ beq t2,zero,58 <ok>
130EF0FF ,   \ addi t3,zero,-1
6398C305 ,   \ bne t2,t3,a4 <fail>
9303F006 ,   \ addi t2,zero,111
135EC300 ,   \ srli t3,t1,0xc
137EFE0F ,   \ andi t3,t3,255
131ECE00 ,   \ slli t3,t3,0xc
B3E3C301 ,   \ or t2,t2,t3
135EB300 ,   \ srli t3,t1,0xb
137E1E00 ,   \ andi t3,t3,1
131E4E01 ,   \ slli t3,t3,0x14
B3E3C301 ,   \ or t2,t2,t3
135E1300 ,   \ srli t3,t1,0x1
137EFE3F ,   \ andi t3,t3,1023
131E5E01 ,   \ slli t3,t3,0x15
B3E3C301 ,   \ or t2,t2,t3
135E4301 ,   \ srli t3,t1,0x14
137E1E00 ,   \ andi t3,t3,1
131EFE01 ,   \ slli t3,t3,0x1f
B3E3C301 ,   \ or t2,t2,t3
23A07200 ,   \ sw t2,0(t0)
6F00C002 ,   \ jal zero,cc <end>
B7020010 ,   \ lui t0,0x10000
1303F003 ,   \ addi t1,zero,63
23806200 ,   \ sb t1,0(t0) # 10000000 <__global_pointer$+0xfffe734>
1303A000 ,   \ addi t1,zero,10
23806200 ,   \ sb t1,0(t0)
B7021000 ,   \ lui t0,0x100
37330100 ,   \ lui t1,0x13
13033333 ,   \ addi t1,t1,819 # 13333 <__global_pointer$+0x11a67>
23A06200 ,   \ sw t1,0(t0) # 100000 <__global_pointer$+0xfe734>
6F000000 ,   \ jal zero,c8 <spin>
;

\ p2yhk -- where p2hook now jumps: the yield, then back to p2hook's caller.
: p2yhk  hookp2 pyield ;

\ fnclean ( -- )   zero the heap, from here to below the data stack (64 MiB
\        above the heap's base, `init`): booted by tabernacle, that memory
\        holds tabernacle's stacks and queues, and the node counts on fresh
\        memory being zero, as it is when QEMU loads it directly.
: fnclean ( -- )   gp@  s10@ 5000 lit + 3F00000 lit +  over - 2 lit rshift zero ;

\ fnkey ( -- )   the `apikey` setting: the wallet's API key, read straight off
\        the disk -- the pager's meta page (src/pager.fam), the wallet from
\        0x200, the key at 0x50 in it (src/wallet.fam) -- and stop: no chain
\        opened, nothing written, no network.  So it runs (on the disk, read
\        only) while the node itself does.
: fnkv variable ;  : fnkb ( -- a )  fnkv 1000 lit lazy ;
: fnkey ( -- )
	dbdev if
		pgbase fnkb 8 lit 0 lit dbion  fnkb 200 lit + @ 544C4157 lit = and if
			0 lit  20 lit 0 lit do fnkb 250 lit + i + c@ or loop if
				"node: the wallet's API key: " lputs  fnkb 250 lit + 20 lit wlhex A lit lputc
			else "node: the wallet has no API key yet (the node makes one when it starts)\n" lputs then
		else "node: no wallet on the disk yet (the node makes one when it starts)\n" lputs then
	else "node: no disk\n" lputs then
	bye
;

\ fnmain ( -- )
: fnmain ( -- )
	fnclean
	A00020F lit nadr !  A000202 lit ngw !  FFFFFF00 lit nmask !  E99 lit nport !
	19 lit pfdep !  0 lit bnet !  -1 lit fnfs !  -1 lit fnpc !  -1 lit fnph !
	fnread fnparse
	wlshowk @ if fnkey then
	-1 lit lgon !                                     \ the log: each line timed (src/log.fam)
	naport @ 0= if nport @ 1 lit + naport ! then
	"node: " lputs  bnet @ if "dev" else "main" then lputs  " network, UDP port " lputs nport @ fndec
	", fast sync depth " lputs pfdep @ fndec  ", wallet API port " lputs naport @ fndec A lit lputc
	acopen 0= if
		dbwrong @ if "node: the disk holds the other network's chain (rm data/disk.img to start over)"
		else "node: no disk" then lputs A lit lputc bye
	then
	imopen imsave
	wlboot txstart
	dbtip ?dup if "node: resuming at height " lputs 20 lit + @ fndec A lit lputc else "node: a new chain\n" lputs then
	pstart 0= if "node: no network device" lputs A lit lputc bye then
	ppn 0 lit do i pp 38 lit + @ if "node: seed " lputs i pp @ fnip. 3A lit lputc i pp 4 lit + @ fndec A lit lputc then loop
	0 lit ppn 0 lit do i pp 8 lit + @ i pp 38 lit + @ 0= and if 1 lit + then loop
	?dup if "node: hosts known from before: " lputs fndec A lit lputc then
	-1 lit fnlive !                                   \ yields may answer the network now
	begin fnstep fnsay wltick 0 lit until
;

ntext                 \ first: find the Bible text, keep the heap off it (src/text.fam)
fnmain
bye
