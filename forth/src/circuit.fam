\ ── The description ──

: cvpdv variable ;   : cvpd ( -- a )   cvpdv 130 lit lazy ;   \ periodic descriptor
: cvbdv variable ;   : cvbd ( -- a )   cvbdv 4 lit lazy ;     \ boundaries: none

\ cvdesc ( -- )   the descriptor of the 24 periodic columns.
: cvdesc ( -- )
	18 lit cvpd !
	18 lit 0 lit do
		20 lit cvpd i 3 lit * 1 lit + 2 lit lshift + !
		cvpv i 7 lit lshift + cvpd i 3 lit * 2 lit + 2 lit lshift + !
		cvpc i 7 lit lshift + cvpd i 3 lit * 3 lit + 2 lit lshift + !
	loop
;

\ cvstmt ( pub -- )   the statement (`recursion::bus_statement`): the tuple
\        count's octet, then each tuple's [multiplicity, length] octet and its
\        values zero-padded to whole octets.
: cvstv variable ;   : cvst ( -- a )   cvstv 1000 lit lazy ;
: cvk variable ;
: c+ ( x -- )   cvst cvk @ 2 lit lshift + !  cvk @ 1 lit + cvk ! ;
: c0s ( n -- )   ?dup if 0 lit do 0 lit c+ loop then ;
: cvstmt ( pub -- )
	0 lit cvk !
	dup @ c+  7 lit c0s
	dup @ swap 4 lit + swap                                ( p count )
	?dup if 0 lit do
		dup @ c+  dup 4 lit + @ c+  6 lit c0s
		dup 4 lit + @ ?dup if 0 lit do dup 8 lit + i 2 lit lshift + @ c+ loop then
		dup 4 lit + @ 7 lit and ?dup if 8 lit swap - c0s then
		dup 4 lit + @ 2 lit lshift 8 lit + +
	loop then
	drop
	cvst sstm !  cvk @ sstn !
;

\ cvsum ( pub out -- )   the bus's public sum: each tuple's multiplicity over
\        its fingerprint, gamma - sum_j beta^j v_j (gamma, beta: the
\        challenges).
: cvav variable ;   : cva ( -- a )   cvav 10 lit lazy ;
: cvpw variable ;   : cvp ( -- a )   cvpw 10 lit lazy ;
: cvtv variable ;   : cvt ( -- a )   cvtv 10 lit lazy ;
: cvo variable ;
: cvsum ( pub out -- )
	dup 4 lit zero  cvo !
	dup @ swap 4 lit + swap                                ( p count )
	?dup if 0 lit do
		cva 4 lit zero  cvp 4 lit zero  1 lit cvp !
		dup 4 lit + @ ?dup if 0 lit do
			dup 8 lit + i 2 lit lshift + @  cvp swap cvt emulb
			cva cvt cva eadd
			cvp sch 10 lit + cvp emul
		loop then
		sch cva cva esub                                   \ gamma - sum
		cva cva einv
		cva over @ cva emulb                               \ times the multiplicity
		cvo @ cva cvo @ eadd
		dup 4 lit + @ 2 lit lshift 8 lit + +
	loop then
	drop
;

: cvpub variable ;

\ cvset ( n pcap plde pub -- )   describe the circuit VM's AIR for a proof.
: cvset ( n pcap plde pub -- )
	cvpub !  splde !  spcap !  slen !
	34 lit swid !  4 lit sdeg !  3B lit sntr !  5 lit snax !  2 lit snch !
	5 lit snxc !  1F lit snpre !
	cvdesc  cvpd sper !
	0 lit cvbd !  cvbd sbnd !
	cvprog sprog !  49A lit spn !  cvmo smo !  cvao sao !
	cvpub @ cvstmt
;

\ cvaux ( -- )   the running sum's boundaries: zero on the first row, the
\        public sum on the last (aux column 4).
: cvaux ( -- )
	sab 30 lit zero
	4 lit sab 4 lit + !
	slen @ 1 lit - sab 18 lit + !  4 lit sab 1C lit + !
	cvpub @ sab 20 lit + cvsum
	2 lit sabn !
;

: cverify ( proof len n pcap plde pub -- ok )
	cvset
	sbeg  cvaux  smid and  sfri and
;
