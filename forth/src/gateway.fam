\ ──────────────────────────────────────────────────────────────────────────────
\ src/gateway.fam — the payment network's gateways: where a wallet's payment
\ address (src/address.fam) is found.  A wallet registers a record of its
\ keys with its gateways (the seed nodes, by default); a sender asks one for
\ the record of the address it's paying, and gets it with the ip:port the
\ gateway last heard it from.  The first step towards onion routing.
\
\ The record (0x11CC bytes): 0 "GWR1"  4 the network (0 main, 1 dev)
\ 8 its sequence (ms since the epoch, big-endian)  10 when it expires
\ 18 Kyber's public key (0x320)  338 Dilithium's (0x520)  858 the signature
\ (Dilithium, of bytes 0 .. 858).  Anyone can check it: the keys hash to the
\ address, the signature is good.  A gateway that lies can only misroute.
\
\ Messages (types the Rust node ignores):
\   10 REG   the record, in parts, to a gateway: cookie (8), id (4), part,
\            parts, then up to 0x400 bytes
\   11 ACK   from the gateway: id (4), status (0 kept, 1 bad, 2 not newer,
\            3 full, 4 too soon, 5 not found), the address (32)
\   12 ASK   a lookup: cookie (8), id (4), the address (32)
\   13 PART  the answer: id (4), part, parts, then up to 0x400 bytes of the
\            record and the ip (4) and port (2) it was heard from
\   14 RELAY a part of a message for an address: cookie (8), the address
\            (32), then the part -- forwarded as
\   15 DELIVER  the part, to where the address was heard from (src/pay.fam)
\   16 KEEP  cookie (8): every 20 s from a wallet, so its NAT keeps the way
\            open for DELIVERs; nothing else
\ The cookie is the one the gateway issued the asker (src/peer.fam): a
\ gateway answers 4.6 KB only to an address that's shown it's real.
\
\ A gateway (the `gateway` setting) keeps each address's latest record in
\ B+tree 10 -- the address -> sequence (8), expiry (8), ip (4), port (2),
\ the record's two pages (4 each) -- at most 10,000, a registration from an
\ IP at most every 10 s.
\
\ A wallet registers with every gateway (`usegw=` settings, else the
\ seeds) once it has their cookies: a record good for 6 hours, made anew
\ every hour, its parts sent again every 5 s until acknowledged.
\
\   gwin ( -- f )          a datagram of ours (but DELIVER's: src/pay.fam): handled
\   gwtick ( -- )          registering, lookups' retries
\   gwlook ( addr -- )     look up an address (its 32 bytes)
\   gwfound ( -- f )       the last lookup's record is in: gwrec (checked),
\                          gwip / gwport where it was heard
\ ──────────────────────────────────────────────────────────────────────────────

: gwserve variable ;   \ this node is a gateway (setting `gateway`)
: gwlen ( -- n )   11CC lit ;                             \ a record
: gwsgn ( -- n )   858 lit ;                              \ the part signed

\ ── Records ──

: gwmine variable ;  : gwmy ( -- a )  gwmine 1200 lit lazy ;   \ ours
: gwrv variable ;  : gwrec ( -- a )  gwrv 1200 lit lazy ;      \ one looked up
: gwhv variable ;  : gwh ( -- a )  gwhv 20 lit lazy ;         \ an address
: gwnow ( -- lo hi )   hnow ;

\ gwcheck ( rec -- ok )   a record: ours, this network's, not expired (and
\        not more than a day ahead), signed by the key it carries.  Its
\        address (the keys' hash) at gwh.
: gwok variable ;
: gwcheck ( rec -- ok )
	dup c@ 47 lit =  over 1 lit + c@ 57 lit = and  over 2 lit + c@ 52 lit = and  over 3 lit + c@ 31 lit = and
	over 4 lit + c@ bnet @ 1 lit and = and  gwok !
	dup 10 lit + qbe@ gwnow du< 0= gwok @ and gwok !                      \ not expired
	dup 10 lit + qbe@ gwnow 5265C00 lit 0 lit wlq+ du< gwok @ and gwok !  \ within a day
	gwok @ if
		88 lit 6 lit kbeg  dup 18 lit + 320 lit kabs  dup 338 lit + 520 lit kabs  kend  gwh 20 lit ksqz
		dup 338 lit +  over gwsgn  3 lit pick 858 lit + diverify gwok @ and gwok !
	then
	drop gwok @
;

\ gwmake ( -- )   our record: sequence now, good for 6 hours, signed.
: gwmake ( -- )
	pakeys
	gwmy gwlen nzero
	47 lit gwmy c!  57 lit gwmy 1 lit + c!  52 lit gwmy 2 lit + c!  31 lit gwmy 3 lit + c!
	bnet @ 1 lit and gwmy 4 lit + c!
	gwnow gwmy 8 lit + qbe!
	gwnow 1499700 lit 0 lit wlq+ gwmy 10 lit + qbe!
	paek gwmy 18 lit + 320 lit ncpy  papk gwmy 338 lit + 520 lit ncpy
	gwh 20 lit rnget 0= if gwh 20 lit nzero then                          \ hedged; else deterministic
	pask gwmy gwsgn gwh gwmy 858 lit + disign
;

\ ── Reassembly ──
\ A message in up to 5 parts of 0x400 bytes: 4 slots, each 0 its source's
\ ip, 4 port, 8 id, C the parts expected, 10 a bit a part had, 14 when it
\ began, then its bytes (from 0x20).
: gwsv variable ;  : gws ( k -- a )  1300 lit * gwsv 4C00 lit lazy + ;
: gwk variable ;  : gwpt variable ;  : gwpn variable ;  : gwid variable ;  : gwfrom variable ;

\ gwslot ( -- a )   the slot for this datagram's (source, id): its own, else
\        an empty or stale one (older than 10 s), else the oldest; 0 if the
\        message's parts don't fit.
: gwslot ( -- a )
	-1 lit gwk !
	4 lit 0 lit do
		i gws @ nsrc @ =  i gws 4 lit + @ nsport @ = and  i gws 8 lit + @ gwid @ = and if i gwk ! then
	loop
	gwk @ 0< if
		0 lit  4 lit 1 lit do i gws 14 lit + @ over gws 14 lit + @ - 0< if drop i then loop gwk !   \ the oldest
		gwk @ gws 20 lit zero
		nsrc @ gwk @ gws !  nsport @ gwk @ gws 4 lit + !  gwid @ gwk @ gws 8 lit + !
		gwpn @ gwk @ gws C lit + !  pms gwk @ gws 14 lit + !
	then
	gwk @ gws
;

\ gwpart ( a n -- whole | 0 )   a part (its bytes at a, n of them): into its
\        slot; the slot's bytes once every part is in.
: gwpa variable ;  : gwpl variable ;  : gwsa variable ;
: gwpart ( a n -- whole )
	gwpl ! gwpa !
	gwpt @ gwpn @ u<  gwpn @ 6 lit u< and  gwpn @ 0= 0= and  gwpl @ 401 lit u< and if
		gwslot gwsa !
		gwpa @  gwsa @ 20 lit + gwpt @ A lit lshift +  gwpl @ ncpy
		gwsa @ 10 lit + @  1 lit gwpt @ lshift or  gwsa @ 10 lit + !
		gwsa @ 10 lit + @  1 lit gwpn @ lshift 1 lit - = if
			0 lit gwsa @ !  0 lit gwsa @ 10 lit + !  gwsa @ 20 lit +                   \ whole: the slot's free again
		else 0 lit then
	else 0 lit then
;

\ gwsendp ( src n type ip port cookie? -- )   n bytes in parts of 0x400, each
\        a packet of the type to ip:port: (the cookie,) the id, part, parts.
: gwsrc variable ;  : gwsn variable ;  : gwty variable ;  : gwip0 variable ;  : gwpo0 variable ;  : gwck variable ;
: gwckl variable ;  : gwckh variable ;  : gwoff variable ;
: gwsendp ( src n type ip port -- )
	gwpo0 ! gwip0 ! gwty ! gwsn ! gwsrc !
	gwsn @ 3FF lit + A lit rshift gwpn !
	gwpn @ 0 lit do
		gwty @ phdr
		gwck @ if gwckl @ gwckh @ 2 lit pick qbe! 8 lit + then             ( body )
		gwid @ over be!  i over 4 lit + c!  gwpn @ over 5 lit + c!  6 lit +
		gwsn @ i A lit lshift - 400 lit pumin gwoff !
		gwsrc @ i A lit lshift + over gwoff @ ncpy
		npkt - gwoff @ +  gwip0 @ gwpo0 @ rot nsend drop
	loop
;

\ gwack ( status -- )   ACK to this datagram's source, for its id and gwh.
: gwack ( status -- )
	11 lit phdr  gwid @ over be!  tuck 4 lit + c!  gwh over 5 lit + 20 lit ncpy  drop
	nsrc @ nsport @ 6 lit 25 lit + nsend drop
;

\ ── The gateway's side ──

: gwdir ( -- )   A lit 20 lit 20 lit btuse ;
: gwvv variable ;  : gwv ( -- a )  gwvv 20 lit lazy ;      \ an entry's value
: gwcnt ( -- a )   pgm 128 lit + ;                         \ entries kept
: gwrv2 variable ;  : gwrt ( -- n )  gwrv2 100 lit lazy ;  \ the last registration from each IP (hashed)

\ gwck? ( body -- ok )   the cookie the body starts with is the one we
\        issued its source.
: gwck? ( body -- ok )   qbe@ nsrc @ nsport @ pcookie rot = -rot = and ;

\ gwkeep ( rec -- status )   a whole registration: checked, then kept.
: gwkeep ( rec -- status )
	dup gwcheck 0= if drop 1 lit else
		gwdir gwh gwv btget  if gwv qbe@ 2 lit pick 8 lit + qbe@ du< 0= else 0 lit then if drop 2 lit else   \ not newer
		gwdir gwh gwv btget 0=  gwcnt @ 2710 lit u< 0= and if drop 3 lit else                      \ full
			gwdir gwh gwv btget if gwv 18 lit + @ pgfree  gwv 1C lit + @ pgfree else gwcnt @ 1 lit + gwcnt ! pgmd then
			pgnew pgnew  gwv 1C lit + !  gwv 18 lit + !
			dup gwv 18 lit + @ pgget 1000 lit ncpy  gwv 18 lit + @ pgdirty
			dup 1000 lit + gwv 1C lit + @ pgget gwlen 1000 lit - ncpy  gwv 1C lit + @ pgdirty
			dup 8 lit + qbe@ gwv qbe!  10 lit + qbe@ gwv 8 lit + qbe!
			nsrc @ gwv 10 lit + !  nsport @ gwv 14 lit + !
			gwdir gwh gwv btput  pgcommit drop  0 lit
		then then
	then
;

\ gwreg ( -- )   REG: a part; a whole record, kept (at most one an IP every
\        10 s), acknowledged.
: gwreg ( -- )
	pbn @ E lit u> pbd @ gwck? and if
		pbd @ 8 lit + be32 gwid !  pbd @ C lit + c@ gwpt !  pbd @ D lit + c@ gwpn !
		pbd @ E lit + pbn @ E lit - gwpart ?dup if
			nsrc @ dup 10 lit rshift xor FF lit and 2 lit lshift gwrt +      ( rec slot )
			dup @ pago 2710 lit u> over @ 0= or if pms swap ! gwkeep else drop drop 4 lit then
			gwack
		then
	then
;

\ gwask ( -- )   ASK: the record and where it was heard, in parts; or
\        ACK 5, not found.
: gwout variable ;  : gwo ( -- a )  gwout 1200 lit lazy ;
: gwans ( -- )
	pbn @ 2C lit = pbd @ gwck? and if
		pbd @ 8 lit + be32 gwid !  pbd @ C lit + gwh 20 lit ncpy
		gwdir gwh gwv btget dup if drop gwv 8 lit + qbe@ gwnow du< 0= then if         \ kept, not expired
			gwv 18 lit + @ pgget gwo 1000 lit ncpy  gwv 1C lit + @ pgget gwo 1000 lit + gwlen 1000 lit - ncpy
			gwv 10 lit + @ gwo gwlen + be!  gwv 14 lit + @ gwo gwlen + 4 lit + nb16!
			0 lit gwck !  gwo gwlen 6 lit + 13 lit nsrc @ nsport @ gwsendp
		else 5 lit gwack then
	then
;

\ gwrelay ( -- )   RELAY: forwarded (DELIVER) if the address is kept here and
\        its record hasn't expired; at most 256 KB a second from an IP.
: gwrbv variable ;  : gwrb ( -- a )  gwrbv 200 lit lazy ;   \ an IP's window: start, bytes
: gwrelay ( -- )
	pbn @ 2E lit u> pbd @ gwck? and if
		nsrc @ dup 10 lit rshift xor 3F lit and 3 lit lshift gwrb +         ( slot )
		dup @ pago 3E8 lit u> if pms over !  0 lit over 4 lit + ! then
		dup 4 lit + @ pbn @ + dup 40000 lit u< if swap 4 lit + !
			gwdir pbd @ 8 lit + gwv btget if gwv 8 lit + qbe@ gwnow du< 0= if
				15 lit phdr  pbd @ 28 lit + swap pbn @ 28 lit - ncpy
				gwv 10 lit + @ gwv 14 lit + @  pbn @ 28 lit - 6 lit +  nsend drop
			then then
		else 2drop then
	then
;

\ ── The wallet's side ──
\ Each gateway's state: its peer index (or -1), the sequence it's
\ acknowledged; ours made at gwmat.  Up to 4.

: gwgv variable ;  : gwg ( k -- a )  4 lit lshift gwgv 40 lit lazy + ;   \ 0 ip 4 port 8 acked C last sent
: gwgn variable ;  : gwmat variable ;  : gwmid variable ;
: gwuse ( ip port -- )   gwgn @ 4 lit u< if gwgn @ gwg 4 lit + !  gwgn @ gwg !  0 lit gwgn @ gwg 8 lit + !  gwgn @ 1 lit + gwgn ! else 2drop then ;

\ gwseeds ( -- )   no gateways set: the seeds, then.
: gwseeds ( -- )   gwgn @ 0= if ppn 0 lit do i pp 38 lit + @ i pp 8 lit + @ and if i pp @ i pp 4 lit + @ gwuse then loop then ;

\ gwckof ( k -- )   the cookie peer k issued us, for gwsendp.
: gwckof ( k -- )   pp dup C lit + @ gwckl !  10 lit + @ gwckh !  -1 lit gwck ! ;
\ gwpeer ( g -- k | -1 )   gateway g's peer entry, if it's answered (so we
\        have its cookie).
: gwpeer ( g -- k )   dup gwg @ swap gwg 4 lit + @ pfind dup 0< 0= if dup pp 8 lit + @ 2 lit = 0= if drop -1 lit then then ;

\ gwregs ( -- )   our record to each gateway not yet acknowledging it, every
\        5 s; a new record every hour.
: gwregs ( -- )
	wl? gwgn @ and if
		gwmat @ 0= gwmat @ pago 36EE80 lit u> or if
			gwmake pms gwmat !  pnonce drop gwmid !
			gwgn @ 0 lit do 0 lit i gwg 8 lit + !  0 lit i gwg C lit + ! loop
		then
		gwgn @ 0 lit do
			i gwg 8 lit + @ 0=  i gwg C lit + @ pago 1388 lit u> and if
				i gwpeer dup 0< if drop else
					gwckof  gwmid @ gwid !
					gwmy gwlen 10 lit i gwg @ i gwg 4 lit + @ gwsendp
					pms i gwg C lit + !
				then
			then
		loop
	then
;

\ ── Lookups ──
: gwlav variable ;  : gwla ( -- a )  gwlav 20 lit lazy ;     \ the address asked for
: gwlst variable ;   \ 0 none, 1 asking, 2 found, 3 not found
: gwlid variable ;  : gwlt variable ;  : gwln variable ;  : gwnf variable ;
: gwip variable ;  : gwport variable ;

: gwlook ( addr -- )
	gwla 20 lit ncpy  1 lit gwlst !  pnonce drop gwlid !  0 lit gwlt !  0 lit gwln !  0 lit gwnf !
;
: gwfound ( -- f )   gwlst @ 2 lit = ;

\ gwasks ( -- )   ASK every gateway, every 2 s; after 5 rounds, not found.
: gwasks ( -- )
	gwlst @ 1 lit = gwgn @ and if gwlt @ pago 7D0 lit u> if
		gwln @ 5 lit u< if
			gwgn @ 0 lit do
				i gwpeer dup 0< if drop else
					12 lit phdr  over pp C lit + @ 2 lit pick pp 10 lit + @ 2 lit pick qbe!
					gwlid @ over 8 lit + be!  gwla over C lit + 20 lit ncpy  drop
					32 lit psendk                                      \ 6 + 8 + 4 + 32
				then
			loop
			pms gwlt !  gwln @ 1 lit + gwln !
		else 3 lit gwlst ! then
	then then
;

\ gwacked ( -- )   ACK: a gateway's answer to our registration, or a lookup
\        not found.
: gwacked ( -- )
	pbn @ 25 lit = if
		pbd @ be32  pbd @ 4 lit + c@                                       ( id status )
		over gwmid @ = if
			dup 0= over 2 lit = or if
				gwgn @ 0 lit do i gwg @ nsrc @ = i gwg 4 lit + @ nsport @ = and if -1 lit i gwg 8 lit + ! then loop
			then
			dup 1 lit = if "gateway: " lputs nsrc @ fnip. " refused our record" lputs A lit lputc then
		then
		swap gwlid @ = gwlst @ 1 lit = and swap 5 lit = and if
			gwnf @ 1 lit + dup gwnf !  gwgn @ u< 0= if 3 lit gwlst ! then
		else then
	then
;

\ gwparts ( -- )   PART: a lookup's answer; whole, checked: found.
: gwparts ( -- )
	gwlst @ 1 lit = pbn @ 6 lit u> and if
		pbd @ be32 dup gwid ! gwlid @ = if
			pbd @ 4 lit + c@ gwpt !  pbd @ 5 lit + c@ gwpn !
			pbd @ 6 lit + pbn @ 6 lit - gwpart ?dup if
				dup gwrec gwlen 6 lit + ncpy
				gwrec gwcheck gwh gwla 20 lit mcmp 0= and if
					gwrec gwlen + be32 gwip !  gwrec gwlen + 4 lit + nb16@ gwport !  2 lit gwlst !
				then
				drop
			then
		then
	then
;

\ gwin ( -- f )   a datagram of ours (types 10 .. 13): handled.
: gwin ( -- f )
	pok? if npay @ 5 lit + c@ dup 10 lit - 7 lit u< swap 15 lit <> and else 0 lit then
	dup if
		npay @ 6 lit + pbody npn @ 6 lit - ncpy  pbody pbd !  npn @ 6 lit - pbn !
		npay @ 5 lit + c@
		dup 10 lit = gwserve @ and if gwreg then
		dup 11 lit = if gwacked then
		dup 12 lit = gwserve @ and if gwans then
		dup 13 lit = if gwparts then
		dup 14 lit = gwserve @ and if gwrelay then
		drop
	then
;

: gwkt variable ;
\ gwkeeps ( -- )   KEEP to each gateway, every 20 s.
: gwkeeps ( -- )
	gwkt @ pago 4E20 lit u> if
		pms gwkt !
		gwgn @ ?dup if 0 lit do i gwpeer dup 0< if drop else
			16 lit phdr  over pp C lit + @ 2 lit pick pp 10 lit + @ rot qbe!  E lit psendk
		then loop then
	then
;

: gwtick ( -- )   gwseeds gwregs gwasks gwkeeps ;
