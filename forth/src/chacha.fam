;

: chsv variable ;  : chs ( -- a )  chsv 40 lit lazy ;      \ the state
: chkv variable ;  : chk ( -- a )  chkv 40 lit lazy ;      \ a block of keystream
: chn variable ;  : chsr variable ;  : chds variable ;  : chm variable ;

\ chx ( src dst n -- )   n bytes of src xored with the keystream block, to dst.
: chx ( src dst n -- )
	?dup if 0 lit do  over i + c@ chk i + c@ xor  over i + c!  loop then 2drop
;

: chacha ( key nonce ctr src dst n -- )
	chn ! chds ! chsr !
	chs 30 lit + !  chs 34 lit + C lit ncpy  chs 10 lit + 20 lit ncpy
	61707865 lit chs !  3320646E lit chs 4 lit + !  79622D32 lit chs 8 lit + !  6B206574 lit chs C lit + !
	begin chn @ while
		chs chk chblk
		chn @ 40 lit pumin chm !
		chsr @ chds @ chm @ chx
		chsr @ chm @ + chsr !  chds @ chm @ + chds !  chn @ chm @ - chn !
		chs 30 lit + dup @ 1 lit + swap !
	repeat
;

