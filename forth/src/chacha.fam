: p1hv variable ;  : p1h ( -- a )  p1hv 14 lit lazy ;      \ h: five limbs
: p1rv variable ;  : p1r ( -- a )  p1rv 24 lit lazy ;      \ r0..r4, then 5r1..5r4
: p1sv variable ;  : p1s ( -- a )  p1sv 10 lit lazy ;      \ s: the key's second half
: p1bv variable ;  : p1b ( -- a )  p1bv 10 lit lazy ;      \ a block being filled
: p1bn variable ;  : p1w variable ;

: p1le ( a -- w )   dup c@ over 1 lit + c@ 8 lit lshift or over 2 lit + c@ 10 lit lshift or swap 3 lit + c@ 18 lit lshift or ;
: p1c! ( w k -- )   2 lit lshift p1r + ! ;                    \ r cell k

\ p1beg ( key -- )   r (clamped) and s from the one-time key; h = 0.
: p1beg ( key -- )
	p1h 5 lit zero  0 lit p1bn !
	dup 10 lit + p1s 10 lit ncpy
	dup p1le 3FFFFFF lit and 0 lit p1c!
	dup p1le 1A lit rshift  over 4 lit + p1le 6 lit lshift or  3FFFF03 lit and 1 lit p1c!
	dup 4 lit + p1le 14 lit rshift  over 8 lit + p1le C lit lshift or  3FFC0FF lit and 2 lit p1c!
	dup 8 lit + p1le E lit rshift  over C lit + p1le 12 lit lshift or  3F03FFF lit and 3 lit p1c!
	C lit + p1le 8 lit rshift FFFFF lit and 4 lit p1c!
	5 lit 1 lit do i 2 lit lshift p1r + @ dup 2 lit lshift +  i 4 lit + p1c! loop
;

\ p1abs ( a n -- )   the message's next bytes: whole blocks straight from it,
\        the rest through p1b.
: p1abs ( a n -- )
	begin dup while
		p1bn @ 0= over F lit u> and if
			over p1h p1r rot 1000000 lit p1blk  swap 10 lit + swap 10 lit -
		else
			over c@ p1b p1bn @ + c!  p1bn @ 1 lit + p1bn !  swap 1 lit + swap 1 lit -
			p1bn @ 10 lit = if p1h p1r p1b 1000000 lit p1blk  0 lit p1bn ! then
		then
	repeat 2drop
;

\ p1end ( out -- )   the last block (padded: a 1, then zeros), h fully
\        reduced mod 2^130 - 5, plus s mod 2^128: the tag.
: p1g ( k -- a )   2 lit lshift p1h + ;
: p1g2v variable ;  : p1g2 ( k -- a )  2 lit lshift p1g2v 14 lit lazy + ;
: p1tv variable ;  : p1t ( k -- a )  2 lit lshift p1tv 10 lit lazy + ;
: p1add ( n k -- )   p1g dup @ rot + swap ! ;
: p1st ( w a -- )   2dup c!  over 8 lit rshift over 1 lit + c!  over 10 lit rshift over 2 lit + c!  swap 18 lit rshift swap 3 lit + c! ;
: p1c variable ;
: p1end ( out -- )
	p1bn @ if
		1 lit p1b p1bn @ + c!
		p1bn @ 1 lit + dup 10 lit u< if p1b over + 10 lit rot - nzero else drop then
		p1h p1r p1b 0 lit p1blk
	then
	\ the carries through: h1 .. h4, h4 into h0 (times 5), h0 into h1
	4 lit 1 lit do i p1g @ 1A lit rshift i 1 lit + p1add  i p1g @ 3FFFFFF lit and i p1g ! loop
	4 lit p1g @ 1A lit rshift dup 2 lit lshift + 0 lit p1add  4 lit p1g @ 3FFFFFF lit and 4 lit p1g !
	0 lit p1g @ 1A lit rshift 1 lit p1add  0 lit p1g @ 3FFFFFF lit and 0 lit p1g !
	\ g = h + 5 - 2^130: h if that's negative, else g
	0 lit p1g @ 5 lit +  dup 3FFFFFF lit and 0 lit p1g2 !  1A lit rshift
	4 lit 1 lit do i p1g @ + dup 3FFFFFF lit and i p1g2 !  1A lit rshift loop
	4 lit p1g @ + 4000000 lit -  dup 4 lit p1g2 !
	1F lit rshift 1 lit -  p1w !                                     \ all ones: take g
	5 lit 0 lit do  i p1g2 @ p1w @ and  i p1g @ p1w @ invert and  or  i p1g ! loop
	\ as 128 bits
	0 lit p1g @  1 lit p1g @ 1A lit lshift or  0 lit p1t !
	1 lit p1g @ 6 lit rshift  2 lit p1g @ 14 lit lshift or  1 lit p1t !
	2 lit p1g @ C lit rshift  3 lit p1g @ E lit lshift or  2 lit p1t !
	3 lit p1g @ 12 lit rshift  4 lit p1g @ 8 lit lshift or  3 lit p1t !
	\ plus s, the carry rippling up (out of the top: dropped)
	0 lit p1c !
	4 lit 0 lit do
		i p1t @ p1w !
		p1s i 2 lit lshift + p1le p1w @ +  dup p1w @ u<              ( out sum1 c1 )
		swap p1c @ +  dup p1c @ u<                                     ( out c1 sum c2 )
		rot or 1 lit and p1c !                                         ( out sum )
		over i 2 lit lshift + p1st
	loop
	drop
;

\ ── The AEAD (RFC 8439, 2.8) ──
\ The Poly1305 key: the key stream's first 32 bytes (block 0); the message
\ from block 1; the tag over the aad and the ciphertext, each padded to 16
\ bytes, then their lengths (8 bytes each, little-endian).

: aekv variable ;  : aek ( -- a )  aekv 40 lit lazy ;      \ the one-time key; lengths
: aez ( n -- )   F lit and ?dup if 10 lit swap - aek 30 lit + dup 10 lit nzero swap p1abs then ;
: aelen ( an n -- )   aek 30 lit + 10 lit nzero  aek 38 lit + p1st  aek 30 lit + p1st  aek 30 lit + 10 lit p1abs ;
: aekey variable ;  : aenon variable ;  : aea variable ;  : aean variable ;
: aec variable ;  : aen variable ;  : aept variable ;
: aetv variable ;  : aet ( -- a )  aetv 10 lit lazy ;      \ a tag computed

\ aetag ( out -- )   the tag of the aad (aea, aean) and ciphertext (aec,
\        aen), under aekey and aenon, at out.
: aetag ( out -- )
	aek 20 lit nzero  aekey @ aenon @ 0 lit aek aek 20 lit chacha       \ block 0: the one-time key
	aek p1beg
	aea @ aean @ p1abs  aean @ aez
	aec @ aen @ p1abs  aen @ aez
	aean @ aen @ aelen
	p1end
;

: aeseal ( key nonce aad an pt n ct -- )
	aec ! aen ! aept ! aean ! aea ! aenon ! aekey !
	aekey @ aenon @ 1 lit aept @ aec @ aen @ chacha
	aec @ aen @ + aetag
;

\ aeopen: the tag compared whole (every byte, whatever differs first).
: aeopen ( key nonce aad an ct n pt -- ok )
	aept ! aen ! aec ! aean ! aea ! aenon ! aekey !
	aet aetag
	0 lit  10 lit 0 lit do aet i + c@ aec @ aen @ + i + c@ xor or loop  0=
	dup if aekey @ aenon @ 1 lit aec @ aept @ aen @ chacha then
;
