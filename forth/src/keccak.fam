	88 lit krcv @ 48 lit + !  0 lit krcv @ 4C lit + !
	80008009 lit krcv @ 50 lit + !  0 lit krcv @ 54 lit + !
	8000000A lit krcv @ 58 lit + !  0 lit krcv @ 5C lit + !
	8000808B lit krcv @ 60 lit + !  0 lit krcv @ 64 lit + !
	8B lit krcv @ 68 lit + !  80000000 lit krcv @ 6C lit + !
	8089 lit krcv @ 70 lit + !  80000000 lit krcv @ 74 lit + !
	8003 lit krcv @ 78 lit + !  80000000 lit krcv @ 7C lit + !
	8002 lit krcv @ 80 lit + !  80000000 lit krcv @ 84 lit + !
	80 lit krcv @ 88 lit + !  80000000 lit krcv @ 8C lit + !
	800A lit krcv @ 90 lit + !  0 lit krcv @ 94 lit + !
	8000000A lit krcv @ 98 lit + !  80000000 lit krcv @ 9C lit + !
	80008081 lit krcv @ A0 lit + !  80000000 lit krcv @ A4 lit + !
	8080 lit krcv @ A8 lit + !  80000000 lit krcv @ AC lit + !
	80000001 lit krcv @ B0 lit + !  0 lit krcv @ B4 lit + !
	80008008 lit krcv @ B8 lit + !  80000000 lit krcv @ BC lit + !
	then
	krcv @
;
: kscrv variable ;  : kscr ( -- a )  kscrv F0 lit lazy ;

: kperm ( st -- )   krc kscr kf1600 ;

\ ── The sponge ──

: kstv variable ;  : kst ( -- a )  kstv C8 lit lazy ;
: krate variable ;  : kpos variable ;  : kpad variable ;

: kbeg ( rate pad -- )   kpad ! krate !  0 lit kpos !  kst C8 lit nzero ;

\ kabs ( a n -- )   each byte xored into the rate; a full rate, permuted.
: kabs ( a n -- )
	?dup if 0 lit do
		dup i + c@  kst kpos @ + dup c@ rot xor swap c!
		kpos @ 1 lit + dup kpos !  krate @ = if kst kperm 0 lit kpos ! then
	loop then drop
;

\ kend ( -- )   the padding (pad byte, then 0x80 at the rate's end), and the
\        first permutation of the squeeze.
: kend ( -- )
	kst kpos @ + dup c@ kpad @ xor swap c!
	kst krate @ + 1 lit - dup c@ 80 lit xor swap c!
	kst kperm  0 lit kpos !
;

\ ksqz ( out n -- )   n bytes of output, a rate's worth at a time.
: kso variable ;  : ksn variable ;  : ksk variable ;
: ksqz ( out n -- )
	ksn ! kso !
	begin ksn @ while
		krate @ kpos @ -  ksn @ over u< if drop ksn @ then ksk !
		kst kpos @ +  kso @  ksk @ ncpy
		kso @ ksk @ + kso !  ksn @ ksk @ - ksn !  kpos @ ksk @ + kpos !
		kpos @ krate @ = if kst kperm 0 lit kpos ! then
	repeat
;

: kout variable ;
: sha3256 ( a n out -- )   kout !  88 lit 6 lit kbeg kabs kend  kout @ 20 lit ksqz ;
: sha3512 ( a n out -- )   kout !  48 lit 6 lit kbeg kabs kend  kout @ 40 lit ksqz ;
: kom variable ;
: shake128 ( a n out m -- )   kom ! kout !  A8 lit 1F lit kbeg kabs kend  kout @ kom @ ksqz ;
: shake256 ( a n out m -- )   kom ! kout !  88 lit 1F lit kbeg kabs kend  kout @ kom @ ksqz ;
