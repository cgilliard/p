: cgcap ( -- a )   bnet @ if dgcap else mgcap then ;
: cscap ( -- a )   bnet @ if dscap else mscap then ;

\ vkdig ( cap out -- )   a key's digest: hash_octets(7, 256, its cap's
\        elements).
: vkdig ( cap out -- )
	bst 7 lit 100 lit osbeg  swap 100 lit bwords+  osend
	bst swap 8 lit cpy
;

\ oct256 ( a out -- )   a 32-byte big-endian number as 16 big-endian 16-bit
\        limbs (two octets).
: oct256 ( a out -- )
	10 lit 0 lit do
		over i 1 lit lshift + dup c@ 8 lit lshift swap 1 lit + c@ or
		over i 2 lit lshift + !
	loop
	2drop
;

: cpvv variable ;  : cpv ( -- a )   cpvv 120 lit lazy ;    \ 9 octets
: ctpv variable ;  : ctup ( -- a )  ctpv 200 lit lazy ;    \ the bus tuples
: co# ( k -- a )   5 lit lshift cpv + ;

\ ctgen? ( tip -- flag )   whether it's the genesis tip (height 0).
: ctgen? ( tip -- flag )   dup 20 lit + @ swap 24 lit + @ or 0= ;

\ cpublic ( tip -- )   the tip's nine public octets, then the tuples.
: cpublic ( tip -- )
	0 lit co# 8 lit zero
	dup ctgen? 0= if cscap 0 lit co# vkdig then
	dup 1 lit co# 8 lit ucells
	2 lit co# 8 lit zero
	dup 20 lit + @ fred 2 lit co# !
	dup 28 lit + @ over 2C lit + @ 2 lit co# 4 lit + blimbs16
	dup 70 lit + @ over 74 lit + @ 2 lit co# 14 lit + bwide
	dup 30 lit + 3 lit co# oct256
	dup 50 lit + 5 lit co# 8 lit ucells
	6 lit co# 8 lit zero
	dup 78 lit + @ over 7C lit + @ 6 lit co# blimbs16
	80 lit + 7 lit co# oct256
	9 lit ctup !
	9 lit 0 lit do
		ctup i B lit * 1 lit + 2 lit lshift +
		2013265920u lit over !  9 lit over 4 lit + !
		i co# over 8 lit + 8 lit cpy
		i swap 28 lit + !
	loop
;

\ chverify ( proof len tip -- ok )   whether the bytes are a chain proof of
\        the tip.
: chverify ( proof len tip -- ok )
	dup cpublic
	btparm
	ctgen? if cgcap else cscap then                     ( proof len cap )
	btlen swap btlde ctup cverify
;
