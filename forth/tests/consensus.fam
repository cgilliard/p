\ tests/consensus.fam — the relay list (src/consensus.fam): a relay's key
\ from the seed and the key number, its line; consensus.txt read and
\ refused; the aux tree's hashes (against Python's hashlib).

: tjsv variable ;  : tjsave ( -- a )  tjsv 20 lit lazy ;     \ the wallet's seed, put back after
: tjiv variable ;  : tjid ( -- a )  tjiv 40 lit lazy ;       \ two relays' ids
: tjfv variable ;  : tjf ( -- a )  tjfv 1000 lit lazy ;     \ a file being written
: tjfn variable ;  : tjpn variable ;
: tjov variable ;  : tjo ( -- a )  tjov 40 lit lazy ;

: tjput ( a n -- )   tjpn !  tjf tjfn @ + tjpn @ ncpy  tjfn @ tjpn @ + tjfn ! ;
: tjc ( c -- )   tjf tjfn @ + c!  tjfn @ 1 lit + tjfn ! ;
: tjs ( s -- )   dup strlen tjput ;
\ tjline ( ip port id -- )   its line.
: tjline ( ip port id -- )   cnfmt tjput ;
\ tjhead ( -- )   a new file: its first line.
: tjhead ( -- )   0 lit tjfn !  cnhead tjs ;
\ tjhex ( id -- )   an id in hex, no newline.
: tjnib ( n -- c )   F lit and dup A lit u< if 30 lit + else 57 lit + then ;
: tjhex ( id -- )   20 lit 0 lit do dup i + c@ dup 4 lit rshift tjnib tjc tjnib tjc loop drop ;

\ tjrelay ( k -- )   a relay's key (a seed of its own, key number 0): cnek,
\        its id cnmid.
: tjrelay ( k -- )
	20 lit 0 lit do dup i 7 lit * + 3 lit + wlseed i + c! loop drop  0 lit cnok !  0 lit cnkn !  cnkeys
;

Test {
	consensus_key {
		wlseed tjsave 20 lit ncpy  0 lit bnet !
		1 lit tjrelay  cnmid tjid 20 lit ncpy
		cnek 320 lit tjo sha3256  tjo cnmid 20 lit mcmp 0 lit asrt_eq           \ the id: its key's hash
		1 lit tjrelay  cnmid tjid 20 lit mcmp 0 lit asrt_eq                     \ the same seed: the same key
		0 lit cnok !  1 lit cnkn !  cnkeys  cnmid tjid 20 lit mcmp 0= 0= assert  \ key number 1: another
		\ the line
		0 lit tjfn !  3ED2A3AB lit E99 lit tjid tjline
		tjfn @ 5B lit asrt_eq  tjf "relay 62.210.163.171:3737 " 1A lit mcmp 0 lit asrt_eq
		tjf 5A lit + c@ A lit asrt_eq
		tjf 1A lit + tjo 20 lit cnunhex assert  tjo tjid 20 lit mcmp 0 lit asrt_eq
		2 lit tjrelay  cnmid tjid 20 lit + 20 lit ncpy
		tjid tjid 20 lit + 20 lit mcmp 0< 0= if                               \ tjid: the smaller first
			tjid tjo 20 lit ncpy  tjid 20 lit + tjid 20 lit ncpy  tjo tjid 20 lit + 20 lit ncpy
		then
		tjsave wlseed 20 lit ncpy  0 lit cnok !  0 lit cnkn !
	}
	consensus_file {
		tjhead  tjf tjfn @ cnparse assert  cnn @ 0 lit asrt_eq           \ no relays: valid
		tjhead  3ED2A3AB lit E99 lit tjid tjline  7F000001 lit 1 lit tjid 20 lit + tjline
		tjf tjfn @ cnparse assert  cnn @ 2 lit asrt_eq
		0 lit cnent @ 3ED2A3AB lit asrt_eq  0 lit cnent 4 lit + @ E99 lit asrt_eq  0 lit cnhas? 0 lit asrt_eq
		1 lit cnent @ 7F000001 lit asrt_eq  1 lit cnent 4 lit + @ 1 lit asrt_eq
		0 lit cnids tjid 20 lit mcmp 0 lit asrt_eq  1 lit cnids tjid 20 lit + 20 lit mcmp 0 lit asrt_eq
		\ out of order, twice, the other network: not valid
		tjhead  1 lit 1 lit tjid 20 lit + tjline  1 lit 1 lit tjid tjline  tjf tjfn @ cnparse 0= assert  cnn @ 0 lit asrt_eq
		tjhead  1 lit 1 lit tjid tjline  2 lit 1 lit tjid tjline  tjf tjfn @ cnparse 0= assert
		1 lit bnet !  tjhead 0 lit bnet !  1 lit 1 lit tjid tjline  tjf tjfn @ cnparse 0= assert
		\ by hand: as written, valid; then each a way not to be
		tjhead "relay 255.0.10.1:65535 " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse assert
		0 lit cnent @ FF000A01 lit asrt_eq  0 lit cnent 4 lit + @ FFFF lit asrt_eq
		tjhead "relay 256.0.10.1:3737 " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse 0= assert
		tjhead "relay 62.0.010.1:3737 " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse 0= assert
		tjhead "relay 0.0.0.0:3737 " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse 0= assert
		tjhead "relay 62.0.10.1:0 " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse 0= assert
		tjhead "relay 62.0.10.1:65536 " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse 0= assert
		tjhead "relay 62.0.10.1 " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse 0= assert
		tjhead "relay 62.0.10.1:3737  " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse 0= assert
		tjhead "relay 62.0.10.1:3737 " tjs tjid tjhex  tjf tjfn @ cnparse 0= assert          \ no newline
		tjhead "relay 62.0.10.1:3737 " tjs tjid tjhex 20 lit tjc A lit tjc  tjf tjfn @ cnparse 0= assert
		tjhead "relay 62.0.10.1:3737 " tjs tjid tjhex A lit tjc  41 lit tjf tjfn @ + 2 lit - c!  tjf tjfn @ cnparse 0= assert   \ upper case
		tjhead "relay 62.0.10.1:3737 " tjs tjid tjhex A lit tjc  tjf tjfn @ cnparse assert
	}
	consensus_aux_tree {
		tjf 0 lit tjo cnleaf  tjo 20 lit "6E340B9CFFB37A989CA544E6BB780A2C78901D3FB33738768511A30617AFA01D" twhex assert
		"abc" 3 lit tjo cnleaf  tjo 20 lit "609F6E36D2405585188D5CFD761F407C7CC46A7D3F314C88270469DDE315FCD1" twhex assert
		tjf 40 lit nzero  tjf tjf 20 lit + tjo cnnode
		tjo 20 lit "AE0798D0ECAED2B778EDDEBF18F071A561C53658C05E76CEDECC27CAFBDBC577" twhex assert
		40 lit 0 lit do i tjf i + c! loop  tjf tjf 20 lit + tjo cnnode
		tjo 20 lit "1A378704C17DA31E2D05B6D121C2BB2C7D76F6EE6FA8F983E596C2D034963C57" twhex assert
	}
}
