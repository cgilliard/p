		0 lit dgtipv @ 90 lit + !
		0 lit dgtipv @ 94 lit + !
		0 lit dgtipv @ 98 lit + !
		1000 lit dgtipv @ 9C lit + !
	then
	dgtipv @
;
: dtip1v variable ;
: dtip1 ( -- tip )
	dtip1v @ 0= if
		A0 lit alloc dup dtip1v ! 28 lit zero
		69569A93 lit dtip1v @ 0 lit + !
		1F9C40D8 lit dtip1v @ 4 lit + !
		1E5790C2 lit dtip1v @ 8 lit + !
		4232B891 lit dtip1v @ C lit + !
		2F98CB88 lit dtip1v @ 10 lit + !
		29A2B21E lit dtip1v @ 14 lit + !
		7079EC97 lit dtip1v @ 18 lit + !
		59AE57AE lit dtip1v @ 1C lit + !
		1 lit dtip1v @ 20 lit + !  0 lit dtip1v @ 24 lit + !
		1CFB14B5 lit dtip1v @ 28 lit + !  1A1 lit dtip1v @ 2C lit + !
		FFFFFFFF lit dtip1v @ 30 lit + !
		FFFFFFFF lit dtip1v @ 34 lit + !
		FFFFFFFF lit dtip1v @ 38 lit + !
		FFFFFFFF lit dtip1v @ 3C lit + !
		FFFFFFFF lit dtip1v @ 40 lit + !
		FFFFFFFF lit dtip1v @ 44 lit + !
		FFFFFFFF lit dtip1v @ 48 lit + !
		FFFFFFFF lit dtip1v @ 4C lit + !
		7546409D lit dtip1v @ 50 lit + !
		4C37F7B4 lit dtip1v @ 54 lit + !
		505A430C lit dtip1v @ 58 lit + !
		1D69B99E lit dtip1v @ 5C lit + !
		3976EA97 lit dtip1v @ 60 lit + !
		6D488A51 lit dtip1v @ 64 lit + !
		3FCF5FC lit dtip1v @ 68 lit + !
		50877709 lit dtip1v @ 6C lit + !
		1 lit dtip1v @ 70 lit + !  0 lit dtip1v @ 74 lit + !
		1929236B lit dtip1v @ 78 lit + !  1A1 lit dtip1v @ 7C lit + !
		0 lit dtip1v @ 80 lit + !
		0 lit dtip1v @ 84 lit + !
		0 lit dtip1v @ 88 lit + !
		0 lit dtip1v @ 8C lit + !
		0 lit dtip1v @ 90 lit + !
		0 lit dtip1v @ 94 lit + !
		0 lit dtip1v @ 98 lit + !
		2000 lit dtip1v @ 9C lit + !
	then
	dtip1v @
;

Test {
	dev_genesis_chain_proof {
		bsetup bfix mcopy bparse assert
		bcp @ bcl @ dgtip chverify assert
	}
	dev_block1_chain_proof {
		bsetup dc1fix mcopy dtip1 chverify assert
	}
	dev_chain_proof_wrong_tip {
		bsetup dtip1 dup 70 lit + dup @ 1 lit + swap !       \ one more output
		dc1fix mcopy rot chverify 0 lit asrt_eq
		dtip1 70 lit + dup @ 1 lit - swap !
	}
	dev_chain_proof_wrong_circuit {
		bsetup bfix mcopy bparse assert
		bcp @ bcl @ dtip1 chverify 0 lit asrt_eq          \ genesis's proof as block 1's
	}
}

Bench {
	dev_chain_verify {
		bsetup dc1fix mcopy
		bgo
		dtip1 chverify drop
	}
}

\ ── Structure and the body hash ──

\ tc32 ( k -- a )   a 32-byte string of zeros but its last byte k.
: tc32 ( k -- a )   20 lit alloc dup 8 lit zero swap over 1F lit + c! ;

Test {
	dev_block_valid {
		bsetup bfix mcopy bvalid assert
	}
	dev_wrong_body_hash {
		bsetup bfix mcopy over 50 lit + dup c@ 1 lit xor swap c!     \ a body_hash byte
		2dup bverify assert                                          \ the proof alone still checks
		bvalid 0 lit asrt_eq
	}
	compare_32 {
		1 lit tc32 2 lit tc32 c32cmp -1 lit asrt_eq
		2 lit tc32 1 lit tc32 c32cmp 1 lit asrt_eq
		5 lit tc32 5 lit tc32 c32cmp 0 lit asrt_eq
		1 lit tc32 dup 0 lit swap c!  0 lit tc32 dup 80 lit swap c!  c32cmp -1 lit asrt_eq
	}
	sorted_lists {
		60 lit alloc dup 18 lit zero                        \ three: 1, 2, 3 in the last byte
		1 lit over 1F lit + c!  2 lit over 3F lit + c!  3 lit over 5F lit + c!
		dup 3 lit bsorted? assert
		2 lit over 5F lit + c!  dup 3 lit bsorted? 0 lit asrt_eq    \ a repeat
		1 lit over 3F lit + c!  dup 2 lit bsorted? 0 lit asrt_eq    \ out of order
		dup 1 lit bsorted? assert  0 lit bsorted? assert
	}
	self_spend {
		60 lit alloc dup 18 lit zero  1 lit over 1F lit + c!  4 lit over 3F lit + c!  bin !  2 lit bnin !
		60 lit alloc dup 18 lit zero  2 lit over 1F lit + c!  3 lit over 3F lit + c!  bout !  2 lit bnout !
		bselfsp? 0 lit asrt_eq
		4 lit bout @ 3F lit + c!  bselfsp? assert
	}
}

\ ── Proof of work (src/pow.fam): block 1's and the genesis block's, against
\ the initial target; their ids are the tips' hashes. ──

: dtgtv variable ;
: dtgt ( -- a )
	dtgtv @ 0= if
		20 lit alloc dtgtv !
		FF0F0000 lit dtgtv @ 0 lit + !
		FFFFFFFF lit dtgtv @ 4 lit + !
		FFFFFFFF lit dtgtv @ 8 lit + !
		FFFFFFFF lit dtgtv @ C lit + !
		FFFFFFFF lit dtgtv @ 10 lit + !
		FFFFFFFF lit dtgtv @ 14 lit + !
		FFFFFFFF lit dtgtv @ 18 lit + !
		FFFFFFFF lit dtgtv @ 1C lit + !
	then
	dtgtv @
;
: dpwv variable ;
: dpwid ( -- a )   dpwv @ 0= if 20 lit alloc dpwv ! then dpwv @ ;

Test {
	dev_block1_pow {
		bsetup bfix mcopy bparse assert
		bhdr @ dtgt pwok assert
		bhdr @ dpwid hdrid  dpwid dtip1 8 lit ceq assert
	}
	dev_genesis_pow {
		bsetup gfix mcopy bparse assert
		bhdr @ dtgt pwok assert
		bhdr @ dpwid hdrid  dpwid dgtip 8 lit ceq assert
	}
	dev_bad_nonce {
		bsetup bfix mcopy bparse assert
		bhdr @ A0 lit + dup c@ 1 lit xor swap c!
		bhdr @ dtgt pwok 0 lit asrt_eq
	}
}

Bench {
	dev_pow {
		bsetup bfix mcopy bparse drop
		bgo
		bhdr @ dtgt pwok drop
	}
}
