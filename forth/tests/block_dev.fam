\ bsetup ( -- )   dev; the parent state from the genesis block; the reward.
: bsetup ( -- )
	1 lit bnet !
	gfix mcopy bparse drop
	bsroot bproot !  bhcnt bpch ! bpcl !
	1000000000u lit brwl !  0 lit brwh !
;

Test {
	block_parses {
		bsetup
		bfix mcopy bparse assert
		bver 1 lit asrt_eq
		bheight 0 lit asrt_eq 1 lit asrt_eq
		bnin @ 0 lit asrt_eq  bnout @ 1 lit asrt_eq
		bpl @ 29814u lit asrt_eq  bcl @ 29764u lit asrt_eq
	}
	block_proof_verifies {
		bsetup
		bfix mcopy bverify assert
		bchal 1971854774u lit 329507722u lit 1116992785u lit 1176273679u lit c4? assert
		bchal 10 lit + 697559150u lit 1185643371u lit 1202681544u lit 347352087u lit c4? assert
		bprod 1905571661u lit 1815996702u lit 1626803334u lit 1699154527u lit c4? assert
	}
	wrong_reward {
		bsetup  brwl @ 1 lit + brwl !
		bfix mcopy bverify 0 lit asrt_eq
	}
	wrong_parent_count {
		bsetup  1 lit bpcl !
		bfix mcopy bverify 0 lit asrt_eq
	}
	wrong_parent_root {
		bsetup  bproot @ dup c@ 1 lit xor swap c!
		bfix mcopy bverify 0 lit asrt_eq
		bproot @ dup c@ 1 lit xor swap c!
	}
	tampered_output {
		bsetup
		bfix mcopy over C9 lit + dup c@ 1 lit xor swap c!  bverify 0 lit asrt_eq
	}
	truncated_block {
		bsetup
		bfix mcopy 1 lit - bverify 0 lit asrt_eq
	}
}

