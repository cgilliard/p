: cvrun ( proof len -- ok )   cvparm 40 lit cvpre drop A lit cvtpub cverify ;

\ cvdigok ( -- flag )   whether the embedded program hashes to its digest:
\        hash_elements(6, [nodes, mains, auxes, (op, a, b)..., outputs...]).
: cvdbv variable ;   : cvdk variable ;
: d+ ( x -- )   cvdbv @ cvdk @ 2 lit lshift + !  cvdk @ 1 lit + cvdk ! ;
: cvdigok ( -- flag )
	4000 lit alloc cvdbv !  0 lit cvdk !
	spn @ d+  3B lit d+  5 lit d+
	spn @ 3 lit * 0 lit do cvprog i 2 lit lshift + be@ d+ loop
	3B lit 0 lit do cvmo i 2 lit lshift + be@ d+ loop
	5 lit 0 lit do cvao i 2 lit lshift + be@ d+ loop
	60 lit alloc dup cvdbv @ cvdk @ 6 lit p2hash                ( st )
	-1 lit 8 lit 0 lit do over i 2 lit lshift + @ cvdig i 2 lit lshift + be@ = and loop
	nip
;

Test {
	program_digest {
		cvparm 40 lit cvpre drop A lit cvtpub cvset
		cvdigok assert
	}
	circuit_proof_verifies {
		cvfix mcopy cvrun assert
	}
	intermediate_values {
		cvparm cvfix mcopy 40 lit cvpre drop A lit cvtpub cvset sbeg assert
		sch 1655155762u lit 1079255485u lit 614744774u lit 1998679956u lit c4? assert
		sch 10 lit + 85877804u lit 799861458u lit 755154685u lit 969294594u lit c4? assert
		salpha 1700607952u lit 403299168u lit 228415585u lit 1407156674u lit c4? assert
		sz 1466643406u lit 1826431664u lit 51086727u lit 292089152u lit c4? assert
		cvaux
		sab 20 lit + 1295215555u lit 196396655u lit 332615464u lit 1876759083u lit c4? assert
		smid assert
		sfri assert
	}
	tampered_ood_value {
		cvfix mcopy over C41 lit + dup c@ 1 lit xor swap c!  cvrun 0 lit asrt_eq
	}
	tampered_opening {
		cvfix mcopy over over + 40 lit - dup c@ 1 lit xor swap c!  cvrun 0 lit asrt_eq
	}
	wrong_public_value {
		cvtpub C lit + dup @ 1 lit + over !
		cvfix mcopy cvrun 0 lit asrt_eq
		dup @ 1 lit - swap !
	}
	truncated {
		cvfix mcopy 1 lit - cvrun 0 lit asrt_eq
	}
}

\ ── Benches (./tools/fam --bench ... src/circuit.fam) ──
Bench {
	circuit_verify {
		cvfix mcopy
		bgo
		cvrun drop
	}
}
