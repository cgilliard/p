\ ──────────────────────────────────────────────────────────────────────────────
\ tests/main.fam — test-only: a real main-network chain from the Rust node
\ (tests/fixtures/main/, made by its `forth_fixtures` test), loaded as a pack:
\   0 genesis   1 block 1 (a reward)   2 block 2 (a reward, and one
\   transaction spending block 1's output: one input, two outputs)
\   3 block 2's chain proof   4 block 2b and 5 block 3b: a branch on block 1
\   (forth_fork_fixtures) that outweighs block 2   6 block 3b's chain proof
\   7, 8 the state as of blocks 1 and 2 as the Rust node serves it
\   (forth_snapshot_fixtures)
\ with tests/fixtures/main/info.fam (generated by tools/fxinfo).  Run by
\ scripts/test_main.sh.
\ ──────────────────────────────────────────────────────────────────────────────

\ fxpar ( h -- )   main, and the parent state for block h: block h - 1's.
: fxpar ( h -- )
	0 lit bnet !
	1 lit - fx bparse drop
	bsroot bproot !  bhcnt bpch ! bpcl !
;

\ fxv1 / fxv2 ( -- ok )   `bvalid` of block 1 / 2 against its parent and reward.
: fxv1 ( -- ok )   1 lit fxpar f1rew brwh ! brwl !  1 lit fx bvalid ;
: fxv2 ( -- ok )   2 lit fxpar f2rew brwh ! brwl !  2 lit fx bvalid ;

\ fxall2 ( -- ok )   everything about block 2 so far: `bvalid`, its proof of
\        work against its target, and the chain proof it carries (block 1's).
: fxall2 ( -- ok )
	fxv2
	bhdr @ f2tgt pwok and
	bcp @ bcl @ f1tip chverify and
;

: fxidv variable ;   : fxid ( -- a )   fxidv 20 lit lazy ;

Test {
	main_pack_loaded {
		fx? assert
		0 lit fx nip D0 lit asrt_eq
		2 lit fx nip 331914u lit asrt_eq
	}
	main_block1_valid {
		fxv1 assert  f1bind? assert
	}
	main_block2_valid {
		fxv2 assert  f2bind? assert
		bnin @ 1 lit asrt_eq  bnout @ 3 lit asrt_eq
	}
	main_block2_pow_and_id {
		2 lit fx bparse assert
		bhdr @ f2tgt pwok assert
		bhdr @ fxid hdrid  fxid f2tip 8 lit ceq assert
	}
	main_block1_pow_and_id {
		1 lit fx bparse assert
		bhdr @ f1tgt pwok assert
		bhdr @ fxid hdrid  fxid f1tip 8 lit ceq assert
		0 lit fx bparse assert
		bhdr @ fxid hdrid  fxid f0tip 8 lit ceq assert
	}
	main_chain_proofs {
		1 lit fx bparse assert  bcp @ bcl @ f0tip chverify assert     \ genesis's, in block 1
		2 lit fx bparse assert  bcp @ bcl @ f1tip chverify assert     \ block 1's, in block 2
		3 lit fx f2tip chverify assert                                 \ block 2's
	}
	main_block2_everything {
		fxall2 assert
	}
	main_tampered_input {
		2 lit fxpar f2rew brwh ! brwl !
		2 lit fxcopy over C1 lit + dup c@ 1 lit xor swap c!  bvalid 0 lit asrt_eq
	}
	main_wrong_reward {
		2 lit fxpar f2rew brwh ! 1 lit + brwl !
		2 lit fx bvalid 0 lit asrt_eq
	}
	main_bad_nonce {
		2 lit fxcopy drop dup A0 lit + dup c@ 1 lit xor swap c!
		f2tgt pwok 0 lit asrt_eq
	}
	main_wrong_tip {
		3 lit fx f1tip chverify 0 lit asrt_eq
	}
}

\ ── The chain, from the header rules: every tip computed, not given ──

: ft0v variable ;  : ft0 ( -- a )  ft0v A0 lit lazy ;
: ft1v variable ;  : ft1 ( -- a )  ft1v A0 lit lazy ;
: ft2v variable ;  : ft2 ( -- a )  ft2v A0 lit lazy ;
: ftxv variable ;  : ftx ( -- a )  ftxv A0 lit lazy ;   \ a tampered tip

Test {
	main_chain_tips {
		0 lit bnet !
		0 lit fx ft0 tipgen assert       ft0 f0tip 28 lit ceq assert
		1 lit fx ft0 ft1 tipnext assert  ft1 f1tip 28 lit ceq assert
		2 lit fx ft1 ft2 tipnext assert  ft2 f2tip 28 lit ceq assert
		3 lit fx ft2 chverify assert                 \ block 2's chain proof, of the tip computed here
	}
	main_wrong_parent {
		0 lit bnet !
		2 lit fx f0tip ftx tipnext 0 lit asrt_eq     \ block 2 on genesis
	}
	main_wrong_height {
		0 lit bnet !
		f1tip ftx A0 lit ncpy  3 lit ftx 20 lit + !  \ the parent claims height 3
		2 lit fx ftx ftx tipnext 0 lit asrt_eq
	}
	main_timestamp_not_later {
		0 lit bnet !
		f1tip ftx A0 lit ncpy  f2tip 28 lit + t64@ ftx 28 lit + t64!   \ the parent as late as block 2
		2 lit fx ftx ftx tipnext 0 lit asrt_eq
	}
	main_genesis_hash {
		0 lit bnet !
		1 lit fx ftx tipgen 0 lit asrt_eq            \ block 1 isn't the genesis block
	}
}

\ ── The clock, and the store (src/store.fam, on the test disk) ──

: ftsv variable ;  : fts ( -- a )  ftsv A0 lit lazy ;   \ a synthetic tip

Test {
	clock_sane {
		hnow nip 1A0 lit u< 0= assert               \ after 2026 (the high word of ms is 0x1A1 then)
		hnow nip 1D1 lit u< assert                   \ and before 2033
		f2tip 28 lit + t64@ hdrift? assert            \ the saved chain is in the past
	}
	drift_rule {
		f2tip 28 lit + t64@ 6DDD00 lit 0 lit d- hnoh ! hnov !   \ now: block 2's time - 2 h
		f2tip 28 lit + t64@ hdrift? assert            \ exactly two hours ahead: allowed
		hnov @ 1 lit - hnov !
		f2tip 28 lit + t64@ hdrift? 0 lit asrt_eq     \ a millisecond more: refused
		0 lit hnov ! 0 lit hnoh !
	}
	store_chain {
		0 lit bnet !  dbopen assert  dbfmt
		0 lit fx dbacc assert  1 lit fx dbacc assert  2 lit fx dbacc assert
		dbcnt @ 3 lit asrt_eq
		dbtip f2tip 28 lit ceq assert
		2 lit fx dbacc assert  dbcnt @ 3 lit asrt_eq           \ already kept
		dbopen assert                                          \ a restart: read it back
		dbcnt @ 3 lit asrt_eq  dbtip f2tip 28 lit ceq assert
		f1tip dbget f1tip 28 lit ceq assert
		f0tip dbget f0tip 28 lit ceq assert
	}
	store_orphan {
		0 lit bnet !  dbopen assert  dbfmt
		2 lit fx dbacc 0 lit asrt_eq  dbcnt @ 0 lit asrt_eq    \ block 2 without its parents
	}
	store_fork_choice {
		0 lit bnet !  dbopen assert  dbfmt
		0 lit fx bparse drop
		bhdr @ f1tip dbput assert                              \ (synthetic: any header will do)
		f1tip fts A0 lit ncpy  77 lit fts c!  2 lit fts 9E lit + c!    \ another tip, more work
		bhdr @ fts dbput assert  dbtip fts 28 lit ceq assert
		f1tip fts A0 lit ncpy  78 lit fts c!                  \ a third, as much work as the first
		bhdr @ fts dbput assert  dbtip c@ 77 lit asrt_eq        \ the most work still wins
		dbcnt @ 3 lit asrt_eq
		f1tip fts A0 lit ncpy  79 lit fts c!  2 lit fts 9E lit + c!    \ a tie with the best
		bhdr @ fts dbput assert  dbtip c@ 77 lit asrt_eq        \ the first seen keeps it
	}
	store_torn_record {
		0 lit bnet !  dbopen assert  dbfmt
		0 lit fx bparse drop
		bhdr @ f0tip dbput assert  bhdr @ f1tip dbput assert  bhdr @ f2tip dbput assert
		3 lit dbbuf 0 lit dbio assert                          \ record 2: flip a byte, write it back
		dbbuf 100 lit + dup c@ 1 lit xor swap c!  3 lit dbbuf -1 lit dbio assert
		dbopen assert
		dbcnt @ 2 lit asrt_eq  dbtip f1tip 28 lit ceq assert
	}
}

\ ── The state (src/state.fam): the saved chain applied, undone, redone ──

: fsrv variable ;  : fsr ( -- a )  fsrv 20 lit lazy ;
\ fsapply ( k -- ok )   apply block k of the pack to the state.
: fsapply ( k -- ok )   fx bparse drop  bhdr @ fxid hdrid  fxid stapply ;
\ fsroot? ( tip -- f )   whether the state's root is the tip's state root.
: fsroot? ( tip -- f )   fsr stroot  50 lit + fsr 8 lit ceq ;

Test {
	state_chain {
		0 lit bnet !  dbopen assert  pgfmt assert  stopen assert
		0 lit fsapply assert  pgcommit assert  f0tip fsroot? assert
		1 lit fsapply assert  pgcommit assert  f1tip fsroot? assert
		2 lit fsapply assert  pgcommit assert  f2tip fsroot? assert
		stc@ 0 lit asrt_eq 4 lit asrt_eq                         \ four outputs so far
		pgm 6C lit + @ 2 lit asrt_eq                             \ the state is at block 2
	}
	state_undo_redo {
		2 lit fx bparse drop  bhdr @ fxid hdrid  fxid stunapl assert
		f1tip fsroot? assert  stc@ 0 lit asrt_eq 1 lit asrt_eq    \ back to block 1
		1 lit fx bparse drop  bhdr @ fxid hdrid  fxid 1 lit 0 lit stmeta
		pgcommit assert
		2 lit fsapply assert  pgcommit assert  f2tip fsroot? assert
	}
	state_rejects_a_double_spend {
		2 lit fsapply 0 lit asrt_eq  pgabort                     \ its input is spent now
		stopen assert  f2tip fsroot? assert
	}
	state_restart {
		stopen assert  f2tip fsroot? assert  stc@ 0 lit asrt_eq 4 lit asrt_eq
	}
}

\ ── Accepting blocks (src/accept.fam): the chain, a side branch, a reorganization ──

Test {
	accept_chain {
		0 lit bnet !  acfmt  acopen assert
		0 lit fx acblock assert  1 lit fx acblock assert  2 lit fx acblock assert
		dbtip f2tip 28 lit ceq assert  f2tip fsroot? assert  pgm 6C lit + @ 2 lit asrt_eq
		2 lit fx acblock assert  dbcnt @ 3 lit asrt_eq                 \ already kept
	}
	accept_side_branch {
		4 lit fx acblock assert                                       \ 2b: as much work as 2
		dbcnt @ 4 lit asrt_eq
		dbtip f2tip 28 lit ceq assert  f2tip fsroot? assert            \ 2 stays best
	}
	accept_reorg {
		5 lit fx acblock assert                                       \ 3b: the branch outweighs 2
		dbtip f3btip 28 lit ceq assert  f3btip fsroot? assert
		stc@ 0 lit asrt_eq 3 lit asrt_eq  pgm 6C lit + @ 3 lit asrt_eq
		6 lit fx f3btip chverify assert                               \ and 3b's chain proof holds
	}
	accept_restart {
		acopen assert
		dbtip f3btip 28 lit ceq assert  f3btip fsroot? assert
	}
	accept_resumes_a_move {
		f3btip stunapl assert  f2btip 2 lit 0 lit stmeta  pgcommit assert   \ the state left a block behind
		f2btip fsroot? assert
		acopen assert                                                  \ the next start finishes the move
		f3btip fsroot? assert  pgm 6C lit + @ 3 lit asrt_eq
	}
}

\ ── Fast sync (src/snap.fam), against the Rust node's sync points and pieces ──

: tmpv variable ;  : tmpt ( -- a )  tmpv 48 lit lazy ;      \ a sync point
: tmbv variable ;  : tmb ( -- a )   tmbv 36000 lit lazy ;   \ a piece's bytes
: tmcv variable ;  : tmpc ( -- a )  tmcv 28 lit lazy ;      \ a piece record
: tmcp variable ;  : tmcl variable ;                        \ block 1's chain proof
: tmok variable ;  : tmh variable ;  : tmk variable ;  : tmend variable ;
: tml variable ;   : tmi variable ;  : tmfa variable ;

\ A Rust piece record: level, index, length, the bytes padded to 4.
: tmrec ( r -- r' )   dup 8 lit + be32 3 lit + FFFFFFFC lit and + C lit + ;

\ tmfind ( k l i -- a n )   piece (l, i) in fixture k.
: tmfind ( k l i -- a n )
	tmi ! tml !  fx over + tmend ! 48 lit +  0 lit tmfa !
	begin dup tmend @ u< while
		dup be32 tml @ = over 4 lit + be32 tmi @ = and if dup tmfa ! then  tmrec
	repeat drop
	tmfa @ dup 0= if "no such piece" puts A lit putc bye then
	dup C lit + swap 8 lit + be32
;

\ tmsame ( hash k -- ok )   whether this node serves block `hash`'s sync point
\        and every piece of its state as fixture k has them.
: tmsame ( hash k -- ok )
	tmk ! tmh !
	tmh @ tmpt snspt tmok !
	tmk @ fx drop tmpt 48 lit mcmp 0= tmok @ and tmok !
	tmk @ fx over + tmend ! 48 lit +
	begin dup tmend @ u< while
		tmh @ over be32 2 lit pick 4 lit + be32 tmb snserve      ( r n )
		over 8 lit + be32 = tmok @ and tmok !
		dup C lit + tmb 2 lit pick 8 lit + be32 mcmp 0= tmok @ and tmok !
		tmrec
	repeat drop
	tmok @
;

\ tmpoint ( -- ok )   check block 1 and its sync point (block 2 carries its
\        chain proof).
: tmproof ( -- )   2 lit fx bparse assert  bcp @ tmcp !  bcl @ tmcl ! ;
: tmpoint ( -- ok )   tmproof  1 lit fx  7 lit fx drop  tmcp @ tmcl @  snpoint ;

Test {
	snap_serves_like_rust {
		0 lit bnet !  acfmt  acopen assert
		0 lit fx acblock assert  1 lit fx acblock assert  2 lit fx acblock assert
		f2tip 8 lit tmsame assert
		f1tip 7 lit tmsame assert                                     \ as of the block before
	}
	snap_refuses_a_wrong_point {
		tmproof  7 lit fx drop tmpt 48 lit ncpy  tmpt 47 lit + dup c@ 1 lit xor swap c!
		1 lit fx tmpt tmcp @ tmcl @ snpoint 0= assert                  \ the work changed
		1 lit fx 7 lit fx drop 3 lit fx snpoint 0= assert              \ block 2's chain proof
	}
	snap_imports_from_rust {
		acfmt  acopen assert
		tmpoint assert  snstart assert
		begin tmpc snnext while
			7 lit tmpc @ tmpc 4 lit + @ tmfind  tmpc -rot snput assert
		repeat
		snfinish assert
		dbtip f1tip 28 lit ceq assert  f1tip fsroot? assert
		0 lit fx acblock 0= assert                                     \ nothing below where it started
		2 lit fx acblock assert  dbtip f2tip 28 lit ceq assert  f2tip fsroot? assert
		4 lit fx acblock assert  5 lit fx acblock assert                \ the reorganization, down to it
		dbtip f3btip 28 lit ceq assert  f3btip fsroot? assert
		f1tip 7 lit tmsame assert                                     \ and serves where it started
	}
	snap_restart {
		acopen assert  dbtip f3btip 28 lit ceq assert  f3btip fsroot? assert
		pgm 7C lit + @ 1 lit asrt_eq
	}
	snap_cut_short {
		acfmt  acopen assert
		tmpoint assert  snstart assert
		tmpc snnext assert  7 lit tmpc @ tmpc 4 lit + @ tmfind  tmpc -rot snput assert
		acopen assert                                                  \ an import cut short: wiped
		stc@ or 0 lit asrt_eq  dbtip 0 lit asrt_eq  pgm 78 lit + @ 0 lit asrt_eq
	}
}

Bench {
	main_accept_reorg {
		0 lit bnet !  acfmt  acopen drop
		0 lit fx acblock drop  1 lit fx acblock drop  2 lit fx acblock drop  4 lit fx acblock drop
		bgo
		5 lit fx acblock drop                                         \ validate 3b, reorganize
	}

	main_tipnext {
		0 lit bnet !
		bgo
		2 lit fx f1tip ft2 tipnext drop
	}

	main_body_hash {
		2 lit fx bparse drop
		bgo
		bbodyh
	}
	main_block_proof {
		2 lit fxpar f2rew brwh ! brwl !  2 lit fx
		bgo
		bverify drop
	}
	main_chain_proof {
		3 lit fx f2tip
		bgo
		chverify drop
	}
	main_pow {
		2 lit fx bparse drop
		bgo
		bhdr @ f2tgt pwok drop
	}
	main_block2_all {
		bgo
		fxall2 drop
	}
}
