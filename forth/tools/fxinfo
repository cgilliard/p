#!/usr/bin/env python3
"""fxinfo NET -- tests/fixtures/NET/info.txt and fork.txt (written by the Rust node's
`forth_fixtures` and `forth_fork_fixtures` tests) as Forth words for the tests: each block's tip
(`fNtip`, src/chain.fam's layout), the target it was mined against (`fNtgt`),
its reward (`fNrew`), and a check of its root proof's challenge and product
(`fNbind?`). Printed to stdout."""
import sys

net = sys.argv[1]
import os
tips, blocks = {}, {}
files = [f"tests/fixtures/{net}/info.txt"]
if os.path.exists(f"tests/fixtures/{net}/fork.txt"):
    files.append(f"tests/fixtures/{net}/fork.txt")
for line in (l for name in files for l in open(name)):
    p = line.split()
    if p[0] == "TIP":
        tips[p[1]] = dict(zip(p[2::2], p[3::2]))
    elif p[0] == "BLOCK":
        d = {}
        i = 2
        while i < len(p):
            k = p[i]
            n = 8 if k == "challenge" else 4 if k == "product" else 1
            d[k] = p[i + 1:i + 1 + n] if n > 1 else p[i + 1]
            i += 1 + n
        blocks[p[1]] = d

out = [f"\\ tests/fixtures/{net}/info.fam -- generated by tools/fxinfo from info.txt; do not edit.\n"]
def bytes_at(name, off, hexstr):
    b = bytes.fromhex(hexstr)
    return "".join(f"\t\t{int.from_bytes(b[i:i+4], 'little'):X} lit {name}v @ {off + i:X} lit + !\n" for i in range(0, 32, 4))
def u64_at(name, off, v):
    v = int(v)
    return f"\t\t{v & 0xffffffff:X} lit {name}v @ {off:X} lit + !  {v >> 32:X} lit {name}v @ {off + 4:X} lit + !\n"
for h, t in tips.items():
    name = f"f{h}tip"
    out.append(f": {name}v variable ;\n: {name} ( -- tip )\n\t{name}v @ 0= if\n\t\tA0 lit alloc {name}v ! {name}v @ 28 lit zero\n")
    out.append(bytes_at(name, 0, t["hash"]) + u64_at(name, 0x20, t["height"]) + u64_at(name, 0x28, t["timestamp"]))
    out.append(bytes_at(name, 0x30, t["target"]) + bytes_at(name, 0x50, t["state_root"]) + u64_at(name, 0x70, t["output_count"]))
    out.append(u64_at(name, 0x78, t["anchor"]) + bytes_at(name, 0x80, t["work"]))
    out.append(f"\tthen\n\t{name}v @\n;\n")
for h, b in blocks.items():
    name = f"f{h}tgt"
    out.append(f": {name}v variable ;\n: {name} ( -- a )\n\t{name}v @ 0= if\n\t\t20 lit alloc {name}v !\n")
    out.append(bytes_at(name, 0, b["target"]) + f"\tthen\n\t{name}v @\n;\n")
    out.append(f": f{h}rew ( -- lo hi )   {int(b['reward']) & 0xffffffff:X} lit {int(b['reward']) >> 32:X} lit ;\n")
    ch, pr = b["challenge"], b["product"]
    out.append(f": f{h}bind? ( -- flag )\n\tbchal {' '.join(x + 'u lit' for x in ch[:4])} c4?\n"
               f"\tbchal 10 lit + {' '.join(x + 'u lit' for x in ch[4:])} c4? and\n"
               f"\tbprod {' '.join(x + 'u lit' for x in pr)} c4? and\n;\n")
print("\n".join(out))
