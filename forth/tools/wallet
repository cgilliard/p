#!/usr/bin/env python3
"""wallet -- talk to the Forth node's wallet over its WebSocket API (src/api.fam).

Usage: tools/wallet [--node HOST:PORT] [--key-file FILE] COMMAND [ARGS]

Commands:
  status                    the node: its tip, peers, fast sync, the wallet
  address                   the wallet's payment address
  pay ADDRESS AMOUNT [FEE]  pay a payment address, through the gateways: the
                            node sends the slate and finalizes the answer
  lookup ADDRESS            a payment address's record, from the gateways:
                            where its wallet is reached
  balance                   the wallet's coins, by status
  outputs                   each output the wallet owns
  send AMOUNT [FEE] [FILE]  start a payment: writes slate S1 for the receiver
                            (FILE, or <id>.s1.slate; the fee defaults to 0.0001)
  receive FILE              answer a payment's S1: writes S2 (<id>.s2.slate)
                            for the sender
  finalize FILE             finish a payment from the receiver's S2: the node
                            signs it and announces it to its peers
  cancel ID                 undo a payment that was never finalized
  slates                    payments, and where they've got to
  key                       enter the API key again

Payments are slates exchanged as files, as with the Rust node's wallet (the
same armored format, so either can pay the other): the sender runs `send`,
the receiver `receive`s that file, the sender `finalize`s the one that comes
back.  The node makes and checks the files' text itself; this tool only
carries it.

The node answers a connection only once it has shown the wallet's API key.
It shows the key on its console when the wallet is made (or run
`scripts/node.sh --api-key`); this tool asks for it once and keeps it in
data/wallet.key (readable by you alone).  The API is the WebSocket at
ws://127.0.0.1:3738/ws (the node's port + 1, forwarded from 127.0.0.1 only)
-- where the web wallet, http://127.0.0.1:3738/, talks to it too.
"""

import argparse
import base64
import getpass
import hashlib
import json
import os
import socket
import struct
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_KEY_FILE = os.path.join(HERE, "..", "data", "wallet.key")
DEFAULT_FEE = "0.0001"
TIMEOUT = 120           # seconds: the node may be checking a block, or signing
GUID = b"258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

ROLES = {"sender": "sent", "receiver": "received"}
SLATE_STATES = {"sent": "waiting for the receiver's answer", "received": "answered", "finalized": "finalized", "cancelled": "cancelled"}
ORIGIN = {0: "mined", 1: "change", 2: "received", 3: "recovered"}
FAST_SYNC = {0: "no", 1: "waiting for a peer's height", 2: "fetching blocks", 3: "checking the chain proof", 4: "downloading the state"}


class Failure(Exception):
    pass


def check_amount(text):
    """Coins (2.5, 3): at most 9 decimals.  (The node checks them exactly.)"""
    whole, dot, frac = text.strip().partition(".")
    if not whole.isdigit() or (dot and not frac.isdigit()) or len(frac) > 9:
        raise Failure(f"not an amount: {text}")
    return text.strip()


def read_key(path):
    try:
        with open(path) as f:
            text = f.read().strip()
    except FileNotFoundError:
        return None
    if len(text) != 64 or any(c not in "0123456789abcdefABCDEF" for c in text):
        raise Failure(f"{path} doesn't hold an API key (64 hex digits); run `tools/wallet key`")
    return text.lower()


def ask_key(path):
    print("The wallet's API key: the node shows it on its console when the wallet is made,")
    print("or run scripts/node.sh --api-key. It's kept in " + os.path.normpath(path) + ".")
    while True:
        text = getpass.getpass("API key (not shown): ").strip().lower()
        if len(text) == 64 and all(c in "0123456789abcdef" for c in text):
            break
        print("That isn't an API key: it's 64 hex digits.")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(text + "\n")
    return text


class Node:
    """A WebSocket connection to the node's API (RFC 6455, just what's needed)."""

    def __init__(self, host, port, key):
        try:
            self.sock = socket.create_connection((host, port), timeout=TIMEOUT)
        except OSError as e:
            raise Failure(f"nothing is listening at {host}:{port} -- is the node running? ({e.strerror or e})")
        nonce = base64.b64encode(os.urandom(16))
        self.sock.sendall(
            f"GET /ws HTTP/1.1\r\nHost: {host}:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {nonce.decode()}\r\nSec-WebSocket-Version: 13\r\n\r\n".encode()
        )
        head = b""
        while b"\r\n\r\n" not in head:
            b = self.recv_some(1)
            head += b
        status = head.split(b"\r\n", 1)[0].decode(errors="replace")
        if " 101 " not in status:
            raise Failure(f"the node refused the connection: {status}")
        accept = base64.b64encode(hashlib.sha1(nonce + GUID).digest())
        if b"Sec-WebSocket-Accept: " + accept not in head:
            raise Failure("the node's handshake is wrong")
        self.next_id = 1
        self.call("auth", key=key)

    def recv_some(self, n):
        try:
            b = self.sock.recv(n)
        except socket.timeout:
            raise Failure("the node didn't answer in time")
        if not b:
            raise Failure("the node closed the connection")
        return b

    def recv_exactly(self, n):
        out = b""
        while len(out) < n:
            out += self.recv_some(n - len(out))
        return out

    def send_text(self, text):
        data = text.encode()
        n = len(data)
        if n < 126:
            head = bytes([0x81, 0x80 | n])
        elif n < 65536:
            head = bytes([0x81, 0x80 | 126]) + struct.pack(">H", n)
        else:
            raise Failure("the request is too large (64 KiB at most)")
        mask = os.urandom(4)
        self.sock.sendall(head + mask + bytes(c ^ mask[i & 3] for i, c in enumerate(data)))

    def read_message(self):
        """The next text message (control frames handled, events skipped)."""
        parts = b""
        while True:
            b0, b1 = self.recv_exactly(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self.recv_exactly(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self.recv_exactly(8))[0]
            payload = self.recv_exactly(n)
            op = b0 & 0x0F
            if op == 8:
                raise Failure("the node closed the connection")
            if op == 9:                       # ping: pong
                mask = os.urandom(4)
                self.sock.sendall(bytes([0x8A, 0x80 | len(payload)]) + mask + bytes(c ^ mask[i & 3] for i, c in enumerate(payload)))
                continue
            if op in (0, 1):
                parts += payload
                if b0 & 0x80:
                    return json.loads(parts)

    def call(self, cmd, **args):
        """Run a command: its result."""
        rid = self.next_id
        self.next_id += 1
        self.send_text(json.dumps(dict(args, id=rid, cmd=cmd)))   # (the request's own id: never an argument's)
        while True:
            m = self.read_message()
            if m.get("id") == rid:
                break
        if not m.get("ok"):
            error = m.get("error", "the node refused")
            if cmd == "auth":
                error = "the node didn't accept the API key (run `tools/wallet key` to enter it again)"
            raise Failure(error)
        return m.get("result")


def show_status(node):
    s = node.call("status")
    print(f"network:      {s['network']}")
    print(f"tip:          height {s['height']}")
    peer = s["best_peer"]
    print(f"best peer:    {'none heard yet' if peer < 0 else f'height {peer}'} ({s['peers']} answering)")
    print(f"fast sync:    {FAST_SYNC.get(s['fast_sync'], s['fast_sync'])}")
    state = {"open": "ready", "restoring": "being restored (it finds its outputs once the node has caught up)", "none": "none yet"}[s["wallet"]]
    print(f"wallet:       {state}{', with a passphrase' if s.get('passphrase') else ''}")
    print(f"next key:     {s['next_key']}")
    if s.get("address"):
        print(f"address:      {s['address']}")


def do_pay(node, args):
    if len(args) not in (2, 3):
        raise Failure("usage: pay ADDRESS AMOUNT [FEE]")
    call = {"address": args[0], "amount": check_amount(args[1])}
    if len(args) == 3:
        call["fee"] = check_amount(args[2])
    node.call("pay", **call)
    said = None
    deadline = time.time() + 120
    while time.time() < deadline:
        p = node.call("payment")
        if p["state"] != said and p["state"] in ("finding", "sending"):
            print({"finding": "finding the address...", "sending": "sent; waiting for their wallet to answer..."}[p["state"]])
            said = p["state"]
        if p["state"] == "paid":
            print(f"paid: transaction {p['txid']} sent to the network")
            return
        if p["state"] == "failed":
            raise Failure("the payment failed: " + p["error"])
        time.sleep(1)
    raise Failure("no result after two minutes (see the node's log)")


def do_lookup(node, args):
    if len(args) != 1:
        raise Failure("usage: lookup ADDRESS")
    deadline = time.time() + 30
    while True:
        r = node.call("lookup", address=args[0])
        if r["status"] != "looking" or time.time() > deadline:
            break
        time.sleep(1)
    if r["status"] == "found":
        print(f"found: reached at {r['ip']}:{r['port']}, its record good for {r['expires_in'] // 60} more minutes")
    else:
        print(r["status"])


def show_address(node):
    s = node.call("status")
    if not s.get("address"):
        raise Failure("there's no wallet on this node yet")
    print(s["address"])


def units(text):
    whole, _, frac = text.partition(".")
    return int(whole) * 10**9 + int(frac.ljust(9, "0") or 0)


def show_balance(node):
    b = node.call("balance")
    total = sum(units(b[k]) for k in ("spendable", "immature", "pending", "locked", "held"))
    print(f"spendable:    {b['spendable']}")
    for k in ("immature", "pending", "locked"):
        if units(b[k]):
            print(f"{k + ':':<13} {b[k]}")
    if units(b["held"]):
        print(f"held:         {b['held']} (restored: spendable from height {b['held_until']})")
    print(f"total:        {total // 10**9}.{total % 10**9:09d}   (at height {b['height']})")


def show_outputs(node):
    outs = node.call("outputs")
    if not outs:
        print("no outputs")
        return
    print(f"{'commitment':<18} {'key':>7} {'amount':>22}  status")
    for o in outs:
        text = o["status"]
        if text in ("spendable", "immature", "held"):
            c = o["confirmations"]
            text += f", {c} confirmation{'s' if c != 1 else ''}"
        if text.startswith("held"):
            text += f", until height {o['held_until']}"
        print(f"{o['commitment'][:16]:<18} {o['key']:>7} {o['amount']:>22}  {text} ({ORIGIN.get(o['origin'], o['origin'])})")


def write_file(path, text):
    with open(path, "w") as f:
        f.write(text)


def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError as e:
        raise Failure(f"reading {path}: {e.strerror}")


def do_send(node, args):
    if not args or len(args) > 3:
        raise Failure("usage: send AMOUNT [FEE] [FILE]")
    amount = check_amount(args[0])
    fee, path = DEFAULT_FEE, None
    if len(args) >= 2:
        try:
            fee = check_amount(args[1])
        except Failure:
            if len(args) == 3:
                raise
            path = args[1]
    if len(args) == 3:
        path = args[2]
    r = node.call("send", amount=amount, fee=fee)
    path = path or r["file"]
    write_file(path, r["slate"])
    print(f"Sending {amount} (fee {fee}): slate {r['id']}.")
    print(f"Wrote {path}: give it to the receiver, then `finalize` the file they send back.")


def do_receive(node, args):
    if len(args) != 1:
        raise Failure("usage: receive FILE")
    r = node.call("receive", slate=read_file(args[0]))
    write_file(r["file"], r["slate"])
    amount = next((line[8:] for line in r["slate"].splitlines() if line.startswith("amount: ")), "?")
    print(f"Receiving {amount}: wrote {r['file']} -- send it back to the sender to finalize.")


def do_finalize(node, args):
    if len(args) != 1:
        raise Failure("usage: finalize FILE")
    r = node.call("finalize", slate=read_file(args[0]))
    print(f"Signed and announced to the node's peers: transaction {r['txid']}.")


def do_cancel(node, args):
    if len(args) != 1:
        raise Failure("usage: cancel ID")
    if len(args[0]) != 32 or any(c not in "0123456789abcdefABCDEF" for c in args[0]):
        raise Failure(f"not a slate id: {args[0]} (32 hex characters; see `slates`)")
    node.call("cancel", slate_id=args[0].lower())
    print(f"Cancelled slate {args[0]}: its coins are free again.")


def do_slates(node, args):
    slates = node.call("slates")
    if not slates:
        print("no slates")
        return
    for s in slates:
        line = f"{s['id']}  {ROLES.get(s['role'], s['role']):8}  {s['amount']:>20}  fee {s['fee']}  {SLATE_STATES.get(s['state'], s['state'])}"
        if s["state"] == "finalized":
            line += f" ({'unconfirmed' if s['unconfirmed'] else 'confirmed'}: {s['txid'][:16]})"
        print(line)


def main():
    parser = argparse.ArgumentParser(description="Talk to the Forth node's wallet.")
    parser.add_argument("--node", default="127.0.0.1:3738", help="the wallet API's address (127.0.0.1:3738)")
    parser.add_argument("--key-file", default=DEFAULT_KEY_FILE, help="where the API key is kept (data/wallet.key)")
    parser.add_argument("command", choices=["status", "address", "balance", "outputs", "send", "receive", "finalize", "cancel", "slates", "lookup", "pay", "key"])
    parser.add_argument("args", nargs="*")
    args = parser.parse_args()
    host, _, port = args.node.rpartition(":")
    try:
        if args.command == "key":
            ask_key(args.key_file)
            return 0
        key = read_key(args.key_file) or ask_key(args.key_file)
        node = Node(host or "127.0.0.1", int(port), key)
        if args.command in ("status", "address", "balance", "outputs"):
            {"status": show_status, "address": show_address, "balance": show_balance, "outputs": show_outputs}[args.command](node)
        else:
            {"send": do_send, "receive": do_receive, "finalize": do_finalize, "cancel": do_cancel, "slates": do_slates, "lookup": do_lookup, "pay": do_pay}[args.command](node, args.args)
    except Failure as e:
        print(f"wallet: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
